# =============================================================================
#  RECORRIDOS DE PLAYWRIGHT — copia este archivo a `.env.e2e` y rellénalo
# =============================================================================
#
#  `.env.e2e` ESTÁ EN EL .gitignore. Nunca se sube.
#
#  Estas credenciales son las de TU ENTORNO LOCAL —las que crea la semilla—,
#  no las de Railway. Los recorridos ESCRIBEN en la base: crean incidencias y
#  órdenes, y esas órdenes entran en el cálculo del nivel de servicio y del
#  reparto correctivo/preventivo. Contra producción falsearían el número que
#  el ingeniero lleva al comité.
#
#  La configuración se niega a arrancar si la URL no es local.
# =============================================================================

E2E_URL=http://localhost:5173

# El Jefe de Mantenimiento: lo ve todo y puede cerrar órdenes.
# En un entorno recién sembrado es el usuario administrador de la semilla.
E2E_JEFE_EMAIL=admin@acerosarequipa.local
E2E_JEFE_PASSWORD=

# OPCIONAL pero MUY recomendado: un usuario de perfil estrecho (Técnico,
# Jefe de Tren u Operador de Púlpito).
#
# El recorrido 5 es el único que caza el fallo que ya ha aparecido TRES veces
# en este proyecto —bloques 68, 77 y 83—: una entrada de menú abierta con su
# endpoint cerrado. Con el Jefe no se detecta, porque el Jefe lo ve todo.
#
# Sin estas variables, el recorrido 5 se salta y lo dice.
E2E_TECNICO_EMAIL=
E2E_TECNICO_PASSWORD=

# Un código de activo que EXISTA en tu base. Es dato de planta: no se inventa.
# Sácalo de la pantalla «Estructura de activos».
# Mejor si es uno cuya zona tenga declarada la intervención (bloque 62-B):
# así el recorrido 2 comprueba también el aviso de seguridad.
E2E_ACTIVO=
