# ==== SGIT-CCTV — variables de entorno (copiar a .env) ====
NODE_ENV=development

# PostgreSQL
POSTGRES_USER=sgit
POSTGRES_PASSWORD=sgit_pass
POSTGRES_DB=sgit_cctv
POSTGRES_PORT=5432

# URL usada por Prisma (local, fuera de Docker). Dentro de Docker se inyecta con host "db".
DATABASE_URL=postgresql://sgit:sgit_pass@localhost:5432/sgit_cctv?schema=public

# Redis
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

# MinIO
MINIO_ROOT_USER=sgit_minio
MINIO_ROOT_PASSWORD=sgit_minio_pass
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_ENDPOINT=localhost
MINIO_ACCESS_KEY=sgit_minio
MINIO_SECRET_KEY=sgit_minio_pass
MINIO_BUCKET=sgit-documents

# API / JWT
API_PORT=3000
PORT=3000
JWT_SECRET=change_me_in_prod
JWT_EXPIRES_IN=900s
JWT_REFRESH_SECRET=change_me_refresh
JWT_REFRESH_EXPIRES_IN=7d

# Nginx
HTTP_PORT=80

# Usuario administrador inicial (seed)
ADMIN_EMAIL=admin@acerosarequipa.local
ADMIN_PASSWORD=Admin.Pisco2026
