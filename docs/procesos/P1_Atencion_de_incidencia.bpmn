uelve en remoto?"><bpmn:incoming>f_a3_a4</bpmn:incoming><bpmn:outgoing>f_a4_a5</bpmn:outgoing><bpmn:outgoing>f_a4_a6</bpmn:outgoing></bpmn:exclusiveGateway><bpmn:task id="a5" name="Resolver en remoto y anotar la causa"><bpmn:incoming>f_a4_a5</bpmn:incoming><bpmn:outgoing>f_a5_a11</bpmn:outgoing></bpmn:task><bpmn:task id="a6" name="Generar la OM correctiva"><bpmn:incoming>f_a4_a6</bpmn:incoming><bpmn:outgoing>f_a6_a7</bpmn:outgoing></bpmn:task><bpmn:exclusiveGateway id="a7" name="Necesita repuesto?"><bpmn:incoming>f_a6_a7</bpmn:incoming><bpmn:outgoing>f_a7_a8</bpmn:outgoing><bpmn:outgoing>f_a7_a9</bpmn:outgoing></bpmn:exclusiveGateway><bpmn:task id="a8" name="Entregar el repuesto y descontar stock"><bpmn:incoming>f_a7_a8</bpmn:incoming><bpmn:outgoing>f_a8_a9</bpmn:outgoing></bpmn:task><bpmn:task id="a9" name="Ejecutar el trabajo en campo"><bpmn:incoming>f_a7_a9</bpmn:incoming><bpmn:incoming>f_a8_a9</bpmn:incoming><bpmn:outgoing>f_a9_a10</bpmn:outgoing></bpmn:task><bpmn:task id="a10" name="Registrar evidencia, causa y consumo"><bpmn:incoming>f_a9_a10</bpmn:incoming><bpmn:outgoing>f_a10_a11</bpmn:outgoing></bpmn:task><bpmn:task id="a11" name="Verificar y cerrar la OM"><bpmn:incoming>f_a10_a11</bpmn:incoming><bpmn:incoming>f_a5_a11</bpmn:incoming><bpmn:outgoing>f_a11_a12</bpmn:outgoing></bpmn:task><bpmn:endEvent id="a12" name="Incidencia cerrada"><bpmn:incoming>f_a11_a12</bpmn:incoming></bpmn:endEvent><bpmn:sequenceFlow id="f_a1_a2" sourceRef="a1" targetRef="a2" /><bpmn:sequenceFlow id="f_a2_a3" sourceRef="a2" targetRef="a3" /><bpmn:sequenceFlow id="f_a3_a4" sourceRef="a3" targetRef="a4" /><bpmn:sequenceFlow id="f_a4_a5" sourceRef="a4" targetRef="a5" name="Si" /><bpmn:sequenceFlow id="f_a4_a6" sourceRef="a4" targetRef="a6" name="No" /><bpmn:sequenceFlow id="f_a6_a7" sourceRef="a6" targetRef="a7" /><bpmn:sequenceFlow id="f_a7_a8" sourceRef="a7" targetRef="a8" name="Si" /><bpmn:sequenceFlow id="f_a7_a9" sourceRef="a7" targetRef="a9" name="No" /><bpmn:sequenceFlow id="f_a8