# =============================================================================
#  SGIT-CCTV — PLANTILLA DE SECRETOS PARA docker compose
# =============================================================================
#  ESTE ARCHIVO ES UN EJEMPLO Y SÍ SE GUARDA EN EL REPOSITORIO.
#  El de verdad se llama `.env`, se crea copiando éste, y NUNCA se sube:
#
#      cp .env.compose.ejemplo .env
#
#  Los valores de planta se generan EN EL SERVIDOR y se pegan ahí directamente.
#  No se escriben en un chat, ni en un correo, ni salen en una captura de
#  pantalla. Un secreto que ha pasado por una pantalla compartida ya no es un
#  secreto y hay que cambiarlo.
# =============================================================================

# ---- Base de datos ----------------------------------------------------------
POSTGRES_USER=sgit
POSTGRES_DB=sgit_cctv
# Genera una larga y al azar. En Linux:      openssl rand -base64 32
# En PowerShell:  [Convert]::ToBase64String((1..32|%{Get-Random -Max 256}))
POSTGRES_PASSWORD=CAMBIAME-antes-de-arrancar

# Puerto por el que se ve la base DESDE ESTA MÁQUINA. Cambiarlo si el 5432 ya
# está ocupado por otro PostgreSQL del servidor.
POSTGRES_PORT=5432

# ---- Almacén de archivos (fotos de campo, informes) -------------------------
MINIO_ROOT_USER=sgit-minio
MINIO_ROOT_PASSWORD=CAMBIAME-antes-de-arrancar
MINIO_BUCKET=sgit-cctv

# ---- Los tres secretos de la aplicación -------------------------------------
#  Cada uno DISTINTO de los otros dos. Reutilizarlos significa que quien
#  descubra uno los tiene todos.
#
#    JWT_SECRET          firma la sesión de quien entra
#    JWT_REFRESH_SECRET  firma la renovación de esa sesión
#    CREDENTIAL_ENC_KEY  cifra en la base las contraseñas de las cámaras y
#                        grabadores. SI SE PIERDE, esas credenciales NO SE
#                        PUEDEN RECUPERAR: hay que volver a cargarlas equipo
#                        por equipo, en planta, subiendo a cada poste.
#                        Guárdala donde guardas lo que no se puede perder.
JWT_SECRET=CAMBIAME-cadena-larga-y-al-azar-numero-uno
JWT_REFRESH_SECRET=CAMBIAME-cadena-larga-y-al-azar-numero-dos
CREDENTIAL_ENC_KEY=CAMBIAME-cadena-larga-y-al-azar-numero-tres

# ---- Red --------------------------------------------------------------------
# Desde qué direcciones se acepta al navegador. En un servidor de planta esto
# es el nombre real del equipo, por ejemplo:
#     CORS_ORIGINS=http://sgit.pisco.acerosarequipa.local:8080
CORS_ORIGINS=http://localhost:8080

# A qué dirección llaman las pantallas. Se HORNEA al construir la imagen del
# frontend: si se cambia, hay que reconstruirla, no basta con reiniciar.
#     docker compose build frontend
VITE_API_URL=http://localhost:3000/api/v1

# Puerto por el que la gente de planta abre el sistema en su navegador.
FRONTEND_PORT=8080
