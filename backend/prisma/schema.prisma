// =============================================================================
//  SGIT-CCTV — Esquema de datos (Prisma / PostgreSQL)
//  Aceros Arequipa · Planta Pisco · Trenes 1, 2 y 3 (Laminación)
//  Diseño: monolito modular, herencia por tipo de activo, topología PMP,
//          campos SAP-ready, auditoría append-only.
// =============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// =====================================================================
//  SEGURIDAD Y CONTROL DE ACCESO (Módulo 1)
// =====================================================================

model User {
  id           String    @id @default(uuid())
  email        String    @unique
  fullName     String
  passwordHash String
  active       Boolean   @default(true)
  roleId       String
  role         Role      @relation(fields: [roleId], references: [id])
  lastLoginAt  DateTime?
  /// PIN corto para reanudar una orden en campo sin teclear la contraseña
  /// completa con guantes. Se guarda cifrado (argon2), igual que la contraseña.
  /// La apertura y el cierre de la orden SIEMPRE exigen contraseña completa.
  pinHash      String?
  pinUpdatedAt DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  workOrders   WorkOrder[] @relation("AssignedTechnician")
  incidents    Incident[]  @relation("IncidentResponsible")
  auditLogs    AuditLog[]
  stockMovements StockMovement[]
  stockChecks    StockCheck[]
  materialesRetirados WorkOrderMaterial[] @relation("MaterialRetiradoPor")
  accessRequested AccessRequest[] @relation("AccessRequester")
  accessReviewed  AccessRequest[] @relation("AccessReviewer")
  woOpened        WorkOrder[]     @relation("WoOpenedBy")
  woClosed        WorkOrder[]     @relation("WoClosedBy")
  woAccompanied   WorkOrder[]     @relation("WoCompanion")
  woProgress      WorkOrderProgress[] @relation("WoProgressBy")

  @@map("users")
}

model Role {
  id          String           @id @default(uuid())
  name        String           @unique // Administrador, Supervisor TI, Técnico, Consulta
  description String?
  users       User[]
  permissions RolePermission[]

  @@map("roles")
}

model Permission {
  id          String           @id @default(uuid())
  code        String           @unique // ej: asset.create, wo.approve, incident.close
  description String?
  roles       RolePermission[]

  @@map("permissions")
}

model RolePermission {
  roleId       String
  permissionId String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

// =====================================================================
//  UBICACIONES — jerarquía física (Módulo 3)
//  Empresa > Planta > Tren > Área > Sala/Zona > Rack > (Equipo=Asset)
// =====================================================================

enum LocationType {
  EMPRESA
  PLANTA
  TREN
  AREA
  SALA
  ZONA
  RACK
  /// Etapa del proceso de laminación (F8). Va al FINAL porque PostgreSQL
  /// siempre añade los valores nuevos de un enum al final: si aquí figurara
  /// en otra posición, el esquema y la base no coincidirían.
  ETAPA
}

/// Ambiente físico donde vive el equipo. Es lo que REALMENTE lo degrada.
/// No es lo mismo una cámara sobre el horno recalentador (1,100 °C) que una
/// en el púlpito climatizado: el intervalo de mantenimiento preventivo se
/// deriva de aquí y no de una casilla "crítico sí/no" marcada a criterio.
enum Environment {
  CALOR_RADIANTE    // horno recalentador — radiación directa, degrada sellos y óptica
  VAPOR_AGUA        // trenes — refrigeración de rodillos, condensación interna
  POLVO_METALICO    // cascarilla, taller de rodillos, cizalla — abrasión
  INTEMPERIE_SALINA // patios y almacenes — Pisco es costa: corrosión acelerada
  EMI_ALTA          // salas eléctricas y MCC — interferencia electromagnética
  CLIMATIZADO       // púlpitos de control — polvo normal
}

// =====================================================================
//  ETAPAS DEL PROCESO DE LAMINACIÓN (F8)
//
//  Es CATÁLOGO EDITABLE, no un enum. Razón técnica concreta: los tres
//  trenes NO comparten las mismas etapas —el Tren 1 produce perfiles, el
//  Tren 2 sólo corrugado y el Tren 3 es una línea distinta—. Con un enum,
//  cada diferencia obligaría a migración de base de datos y redespliegue;
//  con una tabla lo edita el Jefe de Mantenimiento desde la interfaz.
//
//  El catálogo define la etapa UNA vez; el árbol de ubicaciones la
//  instancia en cada tren que la tenga.
// =====================================================================
model ProcessStage {
  id                  String      @id @default(uuid())
  code                String      @unique // ej: DESBASTE, HORNO_RECAL
  name                String
  /// Orden dentro del proceso (palanquilla -> producto terminado). Permite
  /// dibujar el tren de izquierda a derecha y detectar tramos ciegos seguidos.
  sequence            Int
  environment         Environment
  /// Criticidad MÍNIMA de todo activo instalado en esta etapa. Una cámara
  /// caída en el tren de desbaste deja al operador ciego ante un atasco a
  /// 1,100 °C; una caída en el almacén no detiene nada.
  baseCriticality     Criticality
  /// Intervalo preventivo sugerido en días, derivado del ambiente. Editable.
  defaultIntervalDays Int
  /// Qué vigila el CCTV en esta etapa (para el informe y la capacitación).
  watches             String?
  active              Boolean     @default(true)
  createdAt           DateTime    @default(now())
  updatedAt           DateTime    @updatedAt

  locations           Location[]

  @@index([sequence])
  @@map("process_stages")
}

model Location {
  id               String       @id @default(uuid())
  type             LocationType
  code             String       @unique // ej: AASA-PISCO-T1-LAMIN-R01
  name             String
  parentId         String?
  parent           Location?    @relation("LocationTree", fields: [parentId], references: [id])
  children         Location[]   @relation("LocationTree")
  path             String       @default("") // ruta materializada para navegación rápida
  photoFileId      String?      // foto de referencia de la ubicación (MinIO)
  /// CÓMO LLEGAR, en texto llano.
  /// "Desde el púlpito del Tren 2, bajar la escalera norte, 20 m hacia el
  /// lecho de enfriamiento, poste de la izquierda."
  /// Es la mejora de mayor impacto para el personal nuevo, que hoy recibe una
  /// orden con un código de activo y no tiene idea de dónde está.
  howToGet         String?
  // ---- Proceso de laminación (F8) ----
  /// Etapa del proceso que representa esta ubicación. Sólo aplica a type=ETAPA.
  stageId          String?
  stage            ProcessStage? @relation(fields: [stageId], references: [id])
  /// Ambiente puntual. Normalmente se hereda de la etapa; se usa sólo cuando
  /// un punto concreto difiere del resto (ej. una cámara dentro de un cofre
  /// refrigerado en plena zona de calor).
  environment      Environment?
  // ---- Campos SAP-ready ----
  sapLocationCode  String?
  costCenter       String?
  responsibleArea  String?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  assets           Asset[]
  documents        Document[]
  cabinets         Cabinet[]
  workOrders       WorkOrder[]

  @@index([parentId])
  @@index([path])
  @@index([stageId])
  @@map("locations")
}

// =====================================================================
//  GABINETES / RACKS (F6.3) — parámetro de mantenimiento, NO es un activo.
//  Un gabinete tiene rótulo propio, ubicación y foto; los equipos montados
//  (NVR, switch, etc.) indican en qué gabinete están para ubicarlos rápido.
// =====================================================================
model Cabinet {
  id          String    @id @default(uuid())
  code        String    @unique // rótulo del gabinete (ej. GAB-T1-R01)
  name        String
  locationId  String?
  location    Location? @relation(fields: [locationId], references: [id])
  referencePlace String? // referencia física (texto libre)
  photoFileId String?    // foto del gabinete en MinIO
  notes       String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  assets      Asset[]

  @@index([locationId])
  @@map("cabinets")
}

// =====================================================================
//  CABLEADO — enums (Bloque 2)
// =====================================================================

enum CableCategory {
  CAT5E
  CAT6
  CAT6A
  FIBRA_MONOMODO
  FIBRA_MULTIMODO
  COAXIAL          // cámaras analógicas conectadas a DVR
  OTRO
}

/// Por dónde corre el tramo. Importa para el diagnóstico: un cable sin
/// blindaje que corre por la misma bandeja que la fuerza, en una planta con
/// hornos y centros de control de motores, se llena de ruido y da fallas
/// intermitentes imposibles de reproducir.
enum CableRoute {
  AEREA
  CANALETA
  BANDEJA          // compartida con fuerza: revisar blindaje
  SUBTERRANEA
  TUBERIA
  INTEMPERIE
}

enum CableStatus {
  INSTALADO
  DANADO
  A_REEMPLAZAR
  RETIRADO
}

enum VideoOutputType {
  HDMI
  VGA
  DVI
  DISPLAYPORT
  BNC
}

/// Distribución del videowall en una pantalla.
enum ScreenLayout {
  UNO              // 1x1, una cámara a pantalla completa
  DOS_X_DOS        // 4 cuadros
  TRES_X_TRES      // 9 cuadros
  CUATRO_X_CUATRO  // 16 cuadros
  OTRO
}

/// De dónde recibe la señal una pantalla. En varios púlpitos la maneja el PC
/// con iVMS-4200 y no un decodificador: hay que contemplar los dos casos o la
/// mitad de los púlpitos no se puede registrar.
enum ScreenSource {
  DECODIFICADOR
  PC
}

/// En qué red vive la IP de gestión de un equipo.
/// En Pisco la gestión va en 10.x.x.x y las cámaras y antenas en 192.x.x.x.
/// Saberlo determina si el servidor puede alcanzar el equipo por ping.
enum MgmtNetwork {
  GESTION      // 10.x.x.x — alcanzable desde el servidor
  CAMARAS      // 192.x.x.x — detrás del grabador, no alcanzable
  OTRA
}

// =====================================================================
//  ACTIVOS TECNOLÓGICOS (Módulo 2) — tabla base + herencia por tipo
// =====================================================================

enum AssetType {
  CAMERA
  NVR
  SWITCH
  WIRELESS   // antena / radioenlace (Ubiquiti, Mimosa)
  ROUTER
  FIREWALL
  SERVER
  UPS
  FIBER
  CABINET
  DECODER    // video wall / decoder Hikvision
  PC         // estación de visualización (iVMS-4200) — parte del mantenimiento CCTV
  OTHER
  /// Monitor del videowall del púlpito. Es activo propio y no un campo del
  /// decodificador porque se quema, se raya y pierde brillo: eso genera su
  /// propia orden de mantenimiento y su propio historial.
  /// Va al final: PostgreSQL añade los valores nuevos de un enum al final.
  PANTALLA
}

enum AssetStatus {
  OPERATIVO
  FUERA_SERVICIO
  MANTENIMIENTO
  BAJA
  STOCK
}

enum Criticality {
  BAJA
  MEDIA
  ALTA
  CRITICA // pérdida de visión que detiene o arriesga producción
}

/// OBSOLETO desde F8 — se conserva sólo por seguridad de reversión.
///
/// Este enum creaba una SEGUNDA jerarquía en competencia con el árbol de
/// ubicaciones: nada impedía que un activo colgara de "Tren 2" en el árbol y
/// dijera TREN_1 aquí. Es el mismo problema de duplicación de verdad que se
/// corrigió en F5 con el estado derivado, pero en la dimensión de ubicación.
///
/// A partir de F8 el tren se DEDUCE subiendo el árbol de ubicaciones
/// (ver common/plant-context.ts). La columna Asset.train permanece poblada
/// durante una fase de transición y se eliminará cuando todos los módulos
/// lean del árbol. No escribir lógica nueva contra este campo.
enum PlantTrain {
  TREN_1
  TREN_2
  TREN_3
  PATIO           // patios, almacenes y exteriores
  PLANTA_GENERAL  // servicios comunes, oficinas, accesos
}

model Asset {
  id            String      @id @default(uuid())
  assetCode     String      @unique // ej: AA-CAM-T1-FX-001
  type          AssetType
  brand         String?
  model         String?
  serialNumber  String?
  firmware      String?
  ipAddress     String?     // IP principal (sensible: solo roles con credential.read)
  referencePlace String?    // lugar de referencia en planta (texto libre)
  status        AssetStatus @default(OPERATIVO)
  criticality   Criticality @default(MEDIA)
  /// OBSOLETO desde F8: el tren se deduce del árbol de ubicaciones.
  /// Se mantiene poblado en la transición para poder revertir sin pérdida.
  train         PlantTrain?
  installDate   DateTime?
  warrantyEnd   DateTime?
  locationId    String?
  location      Location?   @relation(fields: [locationId], references: [id])
  cabinetId     String?     // gabinete donde está montado (NVR, switch, etc.)
  cabinet       Cabinet?    @relation(fields: [cabinetId], references: [id])
  // ---- Campos SAP-ready ----
  sapId         String?     @unique
  costCenter    String?
  responsibleArea String?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  deletedAt     DateTime?   // soft delete

  // Extensiones por tipo (1:1)
  camera        AssetCamera?
  nvr           AssetNvr?
  switchDev     AssetSwitch?
  wireless      AssetWireless?

  // Relaciones operativas y de red
  credentials   Credential[]
  workOrders    WorkOrder[]
  incidents     Incident[]
  documents     Document[]
  history       AssetHistory[]
  portsOnSwitch SwitchPort[]  @relation("PortSwitch")
  connectedPort SwitchPort?   @relation("PortConnectedAsset")
  linksA        NetworkLink[] @relation("LinkEndpointA")
  linksB        NetworkLink[] @relation("LinkEndpointB")
  spareLinks    SparePartAsset[]
  swapsRemoved   WorkOrderSwap[] @relation("SwapRemoved")
  swapsInstalled WorkOrderSwap[] @relation("SwapInstalled")
  preventivePlan PreventivePlan?
  photos        AssetPhoto[]
  // ---- Fichas por tipo (Bloque 2) ----
  decoder       AssetDecoder?
  screen        AssetScreen?
  pc            AssetPc?
  // ---- Tramos de cable (Bloque 2) ----
  cablesFrom    AssetCable[]  @relation("CableFrom")
  cablesTo      AssetCable[]  @relation("CableTo")
  /// Cuadros de videowall donde aparece esta cámara.
  screenCells   ScreenCell[]  @relation("ScreenCellCamera")
  /// Orden de MAPEO en la que se levantó este activo. Permite reconstruir
  /// quién lo registró, cuándo y con quién.
  /// FICHA INCOMPLETA. El técnico guarda en campo con lo mínimo y completa
  /// después; el sistema no bloquea el registro. Sin esto, ante un formulario
  /// exigente el técnico inventa datos para poder guardar, y eso es peor que
  /// dejarlo vacío.
  isDraft       Boolean     @default(false)
  mappedInWorkOrderId String?
  mappedInWorkOrder   WorkOrder? @relation("AssetMappedInWo", fields: [mappedInWorkOrderId], references: [id])
  accessRequests AccessRequest[]

  @@index([type])
  @@index([status])
  @@index([locationId])
  @@index([cabinetId])
  @@index([train])
  @@map("assets")
}

model AssetCamera {
  assetId          String  @id
  asset            Asset   @relation(fields: [assetId], references: [id], onDelete: Cascade)
  resolution       String? // ej: 2560x1440 (4MP)
  cameraUser       String?
  rtspUrl          String?
  ipAddress        String? // se valida como INET a nivel de app/migración
  macAddress       String?
  vlanId           String?
  vlan             Vlan?   @relation(fields: [vlanId], references: [id])
  nvrId            String? // NVR asociado (Asset de tipo NVR)
  /// CANAL del grabador donde entra esta cámara. Sin él no hay mapa de canales
  /// ni forma de traducir lo que reporta el púlpito.
  nvrChannel       Int?
  /// NOMBRE tal como aparece en el grabador y en la pantalla del púlpito.
  /// Es el IDIOMA COMÚN: el operador no dice "AA-CAM-T2-045", dice "la de la
  /// grúa 2". Sin este campo cada reporte hay que traducirlo a mano.
  nvrName          String?
  /// Tipo físico: fija, domo, PTZ, bullet, térmica.
  cameraStyle      String?
  /// De qué puerto PoE se alimenta. Es lo que el técnico necesita en sitio:
  /// "es PoE y cuelga del puerto 8 del switch de la caja R-03".
  poeSourcePortId  String?
  poeSourcePort    SwitchPort? @relation("CameraPoeSource", fields: [poeSourcePortId], references: [id])
  switchPortId     String? @unique
  switchPort       SwitchPort? @relation(fields: [switchPortId], references: [id])
  wirelessUplinkId String? // antena suscriptora/PMP por la que cuelga

  @@map("asset_cameras")
}

model AssetNvr {
  assetId       String  @id
  asset         Asset   @relation(fields: [assetId], references: [id], onDelete: Cascade)
  channels      Int?
  diskCount     Int?
  capacityTb    Float?
  hasLocalDisk  Boolean @default(false) // relevante para grúas (informe GRU-107)
  switchIdDirect String? // switch al que se conecta directo (topología anillo)
  nicPrimary    String? // ej: 172.16.x (segmento industrial)
  nicSecondary  String? // ej: 10.0.x   (segmento visualización iVMS-4200)

  @@map("asset_nvrs")
}

model AssetSwitch {
  assetId    String       @id
  asset      Asset        @relation(fields: [assetId], references: [id], onDelete: Cascade)
  portCount  Int?
  /// Cuántos puertos entregan PoE y con qué presupuesto total en watts.
  /// Permite saber si el switch aún puede alimentar otra cámara. Agregar
  /// equipos sin revisar el presupuesto es causa habitual de caídas
  /// intermitentes que nadie asocia al switch.
  poePorts   Int?
  poeBudgetW Int?
  mgmtIp     String?
  /// En qué red vive esa IP de gestión. Determina si el servidor la alcanza
  /// por ping: en Pisco la gestión va en 10.x y las cámaras en 192.x.
  mgmtNetwork MgmtNetwork?
  vendor     String?      // Fortinet / FortiSwitch / TP-Link
  switchRole SwitchRole   @default(DISTRIBUCION)
  ports      SwitchPort[]

  @@map("asset_switches")
}

enum SwitchRole {
  CORE_ANILLO
  DISTRIBUCION
  AJENO       // switch de terceros colgado del FortiSwitch
  POE_ACCESO
}

enum WirelessMode {
  PMP_BASE    // antena principal punto-multipunto (púlpito)
  SUSCRIPTOR  // antena que cuelga de la PMP base
  PTP         // radioenlace punto a punto
  ESTACION
}

model AssetWireless {
  assetId         String       @id
  asset           Asset        @relation(fields: [assetId], references: [id], onDelete: Cascade)
  vendor          String?      // Ubiquiti (airMAX), Mimosa C6x, TP-Link
  frequency       String?
  mode            WirelessMode @default(SUSCRIPTOR)
  parentWirelessId String?     // auto-referencia lógica: suscriptor -> PMP base
  switchPortId    String?      @unique
  switchPort      SwitchPort?  @relation(fields: [switchPortId], references: [id])
  originPoint     String?
  destPoint       String?
  signalDbm       Int?
  ssid            String?
  /// ¿Tenemos las credenciales de esta antena?
  /// Hay antenas en planta de las que nadie tiene la clave. Marcarlo permite
  /// planificar la campaña de barrido con datos y no de memoria.
  hasCredentials  Boolean      @default(false)
  linkStable      Boolean      @default(true) // caídas abruptas => sesiones NVR colgadas

  @@map("asset_wireless")
}

// =====================================================================
//  RED / TOPOLOGÍA (Módulo transversal — soporte a troubleshooting)
// =====================================================================


// =====================================================================
//  TRAMOS DE CABLE (Bloque 2)
//
//  POR QUÉ ES UN TRAMO ENTRE DOS PUNTOS Y NO UN DATO DE LA CÁMARA
//  Ethernet tiene un límite duro de 90 m de tramo horizontal. Pasado eso el
//  enlace NO falla: falla A VECES. Funciona con frío, se cae con calor.
//  Eso es exactamente el "se arregla y vuelve a fallar" que nadie explica.
//  Y nadie lo va a descubrir si no está anotado que ese tramo mide 118 m.
//
//  Modelado como tramo (de dónde a dónde) y no como atributo del equipo,
//  porque así alimenta el diagrama de topología, el análisis de impacto y la
//  detección de reincidencia POR TRAMO: varias cámaras que fallan y comparten
//  el mismo tramo apuntan al cable, no a las cámaras.
// =====================================================================
model AssetCable {
  id              String        @id @default(uuid())
  code            String?       // rótulo del tramo, si lo tiene
  category        CableCategory
  /// Longitud del tramo en metros. El almacén compra por rollo, pero el
  /// tramo instalado se mide en metros.
  meters          Float?
  /// true = estimado a ojo · false = medido con metrajo.
  /// Se distingue porque no se puede decidir un reemplazo sobre un número
  /// inventado: el aviso de los 90 m dice si el dato es medido o aproximado.
  metersEstimated Boolean       @default(true)
  /// Blindado (STP/FTP). En una siderúrgica un UTP común corriendo junto a
  /// una bandeja de fuerza se llena de ruido: mismo síntoma intermitente.
  shielded        Boolean       @default(false)
  route           CableRoute?
  status          CableStatus   @default(INSTALADO)

  // ---- Extremos del tramo ----
  /// Equipo de origen (switch, grabador, antena) y puerto del que sale.
  fromAssetId     String?
  fromAsset       Asset?        @relation("CableFrom", fields: [fromAssetId], references: [id])
  fromPortNumber  Int?
  /// Equipo de destino.
  toAssetId       String?
  toAsset         Asset?        @relation("CableTo", fields: [toAssetId], references: [id])

  installedAt     DateTime?
  notes           String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([fromAssetId])
  @@index([toAssetId])
  @@index([status])
  @@map("asset_cables")
}

// =====================================================================
//  DECODIFICADOR Y VIDEOWALL DEL PÚLPITO (Bloque 2)
//
//  La cadena real es:
//    GRABADOR -> DECODIFICADOR -> salida HDMI 1 -> PANTALLA 1 -> 2x2 -> cámaras
//
//  Para qué sirve tenerla completa: cuando el operador llama por radio no dice
//  un código, dice "se puso negro el cuadro de arriba a la izquierda de la
//  pantalla 2". Con esta cadena eso se traduce solo a una cámara concreta,
//  su canal y la antena de la que cuelga.
// =====================================================================
model AssetDecoder {
  assetId      String  @id
  asset        Asset   @relation(fields: [assetId], references: [id], onDelete: Cascade)
  /// Cuántas salidas de video tiene el equipo.
  outputCount  Int?
  /// De qué grabador consume el video.
  sourceNvrId  String?
  mgmtIp       String?
  outputs      DecoderOutput[]

  @@map("asset_decoders")
}

model DecoderOutput {
  id            String          @id @default(uuid())
  decoderAssetId String
  decoder       AssetDecoder    @relation(fields: [decoderAssetId], references: [assetId], onDelete: Cascade)
  /// Número de salida física (1, 2, 3…).
  number        Int
  type          VideoOutputType @default(HDMI)
  /// A qué pantalla alimenta esta salida.
  screenAssetId String?
  screen        AssetScreen?    @relation(fields: [screenAssetId], references: [assetId])

  @@unique([decoderAssetId, number])
  @@map("decoder_outputs")
}

// =====================================================================
//  PANTALLA DEL PÚLPITO (Bloque 2)
//
//  Es un ACTIVO propio y no un campo del decodificador: una pantalla se
//  quema, se raya y pierde brillo. Eso genera su propia orden de
//  mantenimiento, su historial y su garantía. Como texto dentro del
//  decodificador no se podría abrir una OM por "Pantalla 2 quemada".
// =====================================================================
model AssetScreen {
  assetId    String        @id
  asset      Asset         @relation(fields: [assetId], references: [id], onDelete: Cascade)
  /// Rótulo con el que la llaman en el púlpito: "Pantalla 1", "Pantalla 2".
  label      String?
  sizeInch   Float?
  layout     ScreenLayout?
  /// De dónde recibe la señal. En varios púlpitos la maneja el PC con
  /// iVMS-4200 y no un decodificador: si no se contemplan los dos casos, la
  /// mitad de los púlpitos no se puede registrar.
  sourceKind ScreenSource?
  sourcePcAssetId String?

  fedByOutputs DecoderOutput[]
  cells        ScreenCell[]

  @@map("asset_screens")
}

/// Qué cámara se ve en cada cuadro de la pantalla.
/// Es lo que traduce "el cuadro de arriba a la izquierda" a un equipo real.
model ScreenCell {
  id            String       @id @default(uuid())
  screenAssetId String
  screen        AssetScreen  @relation(fields: [screenAssetId], references: [assetId], onDelete: Cascade)
  /// Posición en la rejilla, empezando en 1 arriba a la izquierda.
  position      Int
  cameraAssetId String?
  camera        Asset?       @relation("ScreenCellCamera", fields: [cameraAssetId], references: [id])

  @@unique([screenAssetId, position])
  @@map("screen_cells")
}

// =====================================================================
//  PC DEL PÚLPITO (Bloque 2)
//  Estación con iVMS-4200. En varios púlpitos es la que pinta las pantallas.
// =====================================================================
model AssetPc {
  assetId        String  @id
  asset          Asset   @relation(fields: [assetId], references: [id], onDelete: Cascade)
  hostname       String?
  os             String?
  ivmsVersion    String?
  /// Cuántas salidas de video tiene, para saber cuántas pantallas maneja.
  videoOutputs   Int?
  /// Qué grabadores tiene configurados, en texto: es lo que se pierde cuando
  /// se reinstala el equipo y nadie recuerda qué tenía.
  nvrsConfigured String?

  @@map("asset_pcs")
}

model Vlan {
  id        String        @id @default(uuid())
  number    Int           @unique
  name      String
  subnet    String?       // CIDR
  role      String?       // tren / nvr / gestion / visualizacion / industrial
  cameras   AssetCamera[]

  @@map("vlans")
}

model SwitchPort {
  id               String        @id @default(uuid())
  switchId         String
  switchAsset      Asset         @relation("PortSwitch", fields: [switchId], references: [id], onDelete: Cascade)
  assetSwitchId    String?
  assetSwitch      AssetSwitch?  @relation(fields: [assetSwitchId], references: [assetId])
  portNumber       Int
  poe              Boolean       @default(false)
  vlanNumber       Int?
  connectedAssetId String?       @unique
  connectedAsset   Asset?        @relation("PortConnectedAsset", fields: [connectedAssetId], references: [id])

  cameraLink       AssetCamera?
  wirelessLink     AssetWireless?
  /// Cámaras que este puerto ALIMENTA por PoE. Es distinto de cameraLink:
  /// una cámara puede recibir datos por antena y energía por este puerto.
  poweredCameras   AssetCamera[] @relation("CameraPoeSource")

  @@unique([switchId, portNumber])
  @@map("switch_ports")
}

enum LinkMedium {
  FIBRA
  COBRE
  INALAMBRICO
}

model NetworkLink {
  id         String     @id @default(uuid())
  medium     LinkMedium
  endpointAId String
  endpointA  Asset      @relation("LinkEndpointA", fields: [endpointAId], references: [id], onDelete: Cascade)
  endpointBId String
  endpointB  Asset      @relation("LinkEndpointB", fields: [endpointBId], references: [id], onDelete: Cascade)
  isRing     Boolean    @default(false) // tramo del anillo de fibra del core
  description String?

  @@map("network_links")
}

// =====================================================================
//  CREDENCIALES CIFRADAS (soporte a seguridad y reposición rápida)
// =====================================================================

model Credential {
  id        String   @id @default(uuid())
  assetId   String
  asset     Asset    @relation(fields: [assetId], references: [id], onDelete: Cascade)
  username  String
  secretEnc String   // cifrado AES a nivel de aplicación
  type      String?  // admin, viewer, rtsp
  createdAt DateTime @default(now())

  @@map("credentials")
}

// =====================================================================
//  MANTENIMIENTO (Módulo 4)
// =====================================================================

enum WorkOrderType {
  PREVENTIVO
  CORRECTIVO
  MEJORA
  PREDICTIVO  // anticipado por condición (curva P-F): señal, recurrencia, desgaste
  /// Levantamiento de activos en campo. El mapeo TAMBIÉN es una orden de
  /// trabajo: se recibe, se asigna, se ejecuta y se cierra con informe.
  /// Va al final del enum porque PostgreSQL añade los valores nuevos al final.
  MAPEO
}

/// Por dónde llegó el pedido de Producción.
/// Hoy llega por WhatsApp al ingeniero y de ahí se pasa de boca: al registrar
/// la vía queda constancia de cómo entró y deja de perderse.
enum RequestChannel {
  SAP        // orden creada en SAP por Producción
  WHATSAPP   // mensaje al ingeniero
  RADIO      // pedido por radio desde el púlpito
  CORREO
  VERBAL     // en persona
  SISTEMA    // generada por el propio SGIT (preventivo automático)
}

/// Causa encontrada al cerrar la orden.
/// Es una LISTA y no texto libre porque el técnico cierra contra el reloj de
/// la parada: con texto libre se escribe "se solucionó" y el dato no sirve
/// para detectar por qué algo vuelve a fallar.
enum RootCause {
  ENERGIA_CORTE          // corte o falla eléctrica
  FUENTE_POE             // inyector / fuente PoE
  CABLE_DANADO           // cable cortado, aplastado, quemado
  CABLE_FUERA_NORMA      // tramo por encima de los 90 m
  CONECTOR                // RJ45 / empalme / conector mal ponchado
  EQUIPO_QUEMADO
  EQUIPO_FIN_VIDA        // desgaste, ya no da más
  PUERTO_SWITCH          // puerto del switch en falla
  ENLACE_INALAMBRICO     // antena / enlace PMP degradado
  SATURACION_NVR         // sesiones agotadas
  DISCO_NVR
  CONFIGURACION          // configuración incorrecta
  FIRMWARE
  AMBIENTAL              // polvo, calor, humedad, escoria, vibración
  GOLPE_VANDALISMO
  /// El técnico fue, revisó y NO encontró falla. Es un dato valioso, no un
  /// fracaso: varias órdenes seguidas así sobre el mismo equipo apuntan a una
  /// falla intermitente (cable largo, interferencia) que nadie está viendo.
  SIN_FALLA_ENCONTRADA
  OTRO
}

enum WorkOrderStatus {
  ABIERTA
  EN_PROCESO
  EN_ESPERA
  CERRADA
  CANCELADA
}

model WorkOrder {
  id           String          @id @default(uuid())
  code         String          @unique // ej: OT-2026-0001
  /// OPCIONAL desde el Bloque 1. Una orden de MAPEO cubre una ZONA, no un
  /// activo: el técnico va al lecho de enfriamiento y registra 12 cámaras.
  /// Lo mismo con un corte de energía que deja media sala sin visión.
  assetId      String?
  asset        Asset?          @relation(fields: [assetId], references: [id])
  /// Alcance por ubicación, para las órdenes que no son de un solo equipo.
  locationId   String?
  location     Location?       @relation(fields: [locationId], references: [id])
  type         WorkOrderType
  status       WorkOrderStatus @default(ABIERTA)
  technicianId String?
  technician   User?           @relation("AssignedTechnician", fields: [technicianId], references: [id])
  scheduledDate DateTime?
  executedDate  DateTime?
  activity     String?
  diagnosis    String?
  responsible  String?         // responsable de la OM
  materials    String?         // materiales usados / a usar (uno por línea)
  spareParts   Json?
  condition    Json?           // checklist de condición del preventivo (limpieza, cableado, etc.)
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  /// REFERENCIA DEL SITIO en esta orden concreta, en texto libre.
  /// No se retira: complementa a `locationId`. La ubicación dice DÓNDE de
  /// forma estructurada; esto recoge el detalle que el técnico anota ese día
  /// ("columna 14, junto a la escalera norte, poste de la izquierda").
  zone         String?
  incidentId   String?         // incidencia que originó la OM (opcional)
  incident     Incident?          @relation(fields: [incidentId], references: [id])
  evidences    WorkOrderEvidence[]

  // ---- RECEPCIÓN (Bloque 1) ----
  // Producción crea la orden en SAP y la manda por WhatsApp al ingeniero, que
  // la pasa de boca. Aquí queda por escrito quién la pidió y por dónde entró.
  requestedBy    String?          // nombre de quien la solicitó (Producción)
  requestChannel RequestChannel?  // por dónde llegó
  receivedAt     DateTime?        // cuándo se recibió
  externalRef    String?          // número de la orden en SAP, si lo tiene

  // ---- PARADA Y EJECUCIÓN (Bloque 1) ----
  /// Hora de parada ESTIMADA por Producción al crear la orden. Es tentativa:
  /// cambia según la producción del turno.
  plannedStopAt DateTime?
  /// Cuánto estima Producción que dura la parada, en minutos. Junto con las
  /// horas reales permite medir la DESVIACIÓN de lo planificado.
  plannedDurationMin Int?
  /// Horas REALES. Las pone el técnico ya en campo, después de confirmar por
  /// radio con Producción a qué hora se detiene de verdad.
  startedAt     DateTime?
  endedAt       DateTime?
  /// Quién abrió y quién cerró la orden (firma electrónica verificada).
  openedById    String?
  openedBy      User?            @relation("WoOpenedBy", fields: [openedById], references: [id])
  closedById    String?
  closedBy      User?            @relation("WoClosedBy", fields: [closedById], references: [id])
  /// Acompañante en campo. En planta van dos: el técnico de red registra y el
  /// técnico eléctrico acompaña. Queda declarado para trazabilidad y SSOMA.
  companionId   String?
  companion     User?            @relation("WoCompanion", fields: [companionId], references: [id])

  // ---- CIERRE (Bloque 1) ----
  rootCause     RootCause?       // causa encontrada — enum LEGADO, ver nota
  /// CÓDIGO de causa del catálogo editable (3E). Es la fuente de verdad de
  /// aquí en adelante.
  ///
  /// POR QUÉ CONVIVEN LOS DOS
  /// Las órdenes cerradas antes de 3E guardaron el valor en el enum. Borrarlo
  /// las dejaría sin causa. Las 17 opciones del catálogo tienen exactamente
  /// los mismos códigos, así que al cerrar se escriben AMBOS cuando el código
  /// elegido existe en el enum; una causa nueva creada por el usuario solo
  /// puede ir aquí. Al leer: rootCauseCode ?? rootCause.
  rootCauseCode String?
  rootCauseNote String?          // observación libre, ahora OPCIONAL y corta
  /// Qué vio el técnico ANTES de intervenir. Del catálogo SINTOMA.
  /// Separado de la causa a propósito: el síntoma es lo que se observa y la
  /// causa lo que se descubre. Confundirlos es lo que hace que "no hay imagen"
  /// figure como causa de 40 órdenes sin que nadie sepa por qué.
  symptomCode   String?
  /// Qué hizo. Del catálogo ACCION.
  actionCode    String?
  isRecurrent   Boolean          @default(false) // el técnico marca si ya había pasado

  // ---- AVANCE (Bloque 1) ----
  /// Porcentaje de avance declarado, 0 a 100.
  /// Una orden no siempre se termina el mismo día: la parada se acorta, falta
  /// el manlift, no llega el repuesto. En vez de forzar el cierre, la orden
  /// queda EN PROCESO con su avance a la vista del Jefe de Mantenimiento.
  /// Se guarda aquí, además del historial, para poder listar sin consultas extra.
  progressPct   Int              @default(0)
  progress      WorkOrderProgress[]

  /// Activos levantados durante esta orden (solo aplica a las de tipo MAPEO).
  mappedAssets  Asset[]          @relation("AssetMappedInWo")
  // ---- Preparación y consumo (Bloque 2f) ----
  tools         WorkOrderTool[]
  materialItems WorkOrderMaterial[]
  checklist     WorkOrderChecklist[]
  swaps         WorkOrderSwap[]

  @@index([assetId])
  @@index([locationId])
  @@index([status])
  @@index([incidentId])
  @@index([type, status])
  @@map("work_orders")
}

// =====================================================================
//  AVANCE DE LA ORDEN (Bloque 1)
//
//  Es un HISTORIAL, no un solo número. Para el Jefe de Mantenimiento la
//  justificación no es "quedó al 60%", sino la secuencia:
//    29/07  30%  "la parada se acortó, Producción reinició antes"
//    30/07  60%  "faltó manlift, no se alcanzó la cámara del lecho"
//    31/07 100%  "terminado"
//  Esa cadena es la que responde por qué un trabajo tomó tres paradas.
// =====================================================================
model WorkOrderProgress {
  id           String    @id @default(uuid())
  workOrderId  String
  workOrder    WorkOrder @relation(fields: [workOrderId], references: [id], onDelete: Cascade)
  /// Avance acumulado declarado en este reporte (0-100).
  pct          Int
  /// Por qué no se avanzó más, ELEGIDO de la lista (catálogo MOTIVO_AVANCE).
  /// Escrito a mano no se podía contar: ahora se puede saber cuántas paradas
  /// se pierden por falta de repuesto y cuántas por falta de manlift.
  reasonCode   String?
  /// Detalle libre, opcional. La válvula de escape para lo que la lista no
  /// prevé — y la señal de que a la lista le falta una opción.
  note         String?
  reportedById String?
  reportedBy   User?     @relation("WoProgressBy", fields: [reportedById], references: [id])
  reportedAt   DateTime  @default(now())

  @@index([workOrderId])
  @@map("work_order_progress")
}

model WorkOrderEvidence {
  id          String    @id @default(uuid())
  workOrderId String
  workOrder   WorkOrder @relation(fields: [workOrderId], references: [id], onDelete: Cascade)
  fileId      String    // referencia a objeto en MinIO
  caption     String?
  createdAt   DateTime  @default(now())

  @@map("work_order_evidences")
}

// =====================================================================
//  INCIDENCIAS (Módulo 5) + soporte a troubleshooting (Módulo 7)
// =====================================================================

enum Priority {
  BAJA
  MEDIA
  ALTA
  CRITICA
}

enum IncidentStatus {
  ABIERTA
  EN_DIAGNOSTICO
  EN_PROCESO
  EN_ESPERA        // el técnico la deja en espera (a la espera de repuesto/manlift/decisión)
  RESUELTA
  CERRADA
}

enum IncidentCategory {
  GENERAL
  SATURACION_SESIONES_NVR   // "NO MORE USER CAN BE CONNECTED"
  CAIDA_ENLACE_INALAMBRICO  // enlace PMP/Ubiquiti inestable
  FALLA_ALMACENAMIENTO_NVR
  DECODER_VIDEOWALL
  CAMARA_SIN_IMAGEN
  RED
  // ---- Categorías específicas de planta siderúrgica (F5) ----
  CORTE_ENERGIA             // corte / falla eléctrica que deja sin servicio equipos CCTV
  FALLA_GABINETE            // gabinete: temperatura, ventilación, humedad, daño físico
  FALLA_FUENTE_POE          // fuente / inyector / switch PoE que no energiza la cámara
  FALLA_SWITCH              // switch o puerto (core anillo / distribución / acceso)
  FALLA_FIBRA               // enlace de fibra / tramo del anillo dañado o degradado
  FALLA_UPS                 // respaldo de energía (UPS) agotado o en falla
  PERDIDA_CONECTIVIDAD      // pérdida de IP / VLAN / ping al equipo
  FALLA_NVR                 // NVR general (reinicios, cuelgue, no graba)
  AMBIENTAL_SIDERURGICO     // polvo, calor, escoria, vibración, agua propios de la planta
  SEGURIDAD_FISICA          // vandalismo, robo, golpe o corte de cable
  CONFIGURACION_FIRMWARE    // config incorrecta / firmware / actualización fallida
  // ---- Fallas ELÉCTRICAS específicas (planta siderúrgica) ----
  TABLERO_ELECTRICO         // tablero, breaker, llave térmica, borneras
  VARIACION_TENSION         // caída/pico de tensión, fluctuación por carga del horno
  PUESTA_A_TIERRA           // falla o ausencia de puesta a tierra
  CORTOCIRCUITO             // cortocircuito en el ramal o el equipo
  SOBRECARGA                // circuito sobrecargado
  CABLEADO_ELECTRICO        // cable eléctrico dañado, quemado o mal empalmado
  TRANSFORMADOR             // falla en transformador / fuente de alimentación mayor
}

model Incident {
  id              String           @id @default(uuid())
  code            String           @unique // ej: INC-2026-0001 / IT-CCTV-GRU-...
  title           String
  description     String?
  category        IncidentCategory @default(GENERAL)
  priority        Priority         @default(MEDIA)
  status          IncidentStatus   @default(ABIERTA)
  assetId         String?
  asset           Asset?           @relation(fields: [assetId], references: [id])
  responsibleId   String?
  responsible     User?            @relation("IncidentResponsible", fields: [responsibleId], references: [id])
  rootCause       String?
  concurrentSessions Int?          // sesiones en NVR al momento de la falla
  affectedCameras Int?             // cámaras aguas abajo afectadas
  reportedAt      DateTime         @default(now())
  resolvedAt      DateTime?
  visionDownMin   Int?             // minutos sin visión (impacto en producción)
  mttrMinutes     Int?             // tiempo de resolución calculado
  zone            String?          // área/zona en planta (Horno, Laminación, Púlpito...)
  solution        String?          // qué se hizo para resolver
  materials       String?          // materiales utilizados
  interveners     String?          // técnicos que intervinieron
  responsibleName String?          // responsable de la solución
  observations    String?          // observaciones / recomendaciones
  lineManagerNotified Boolean @default(false) // ¿jefe de línea enterado?
  // ---- Propuesta técnica de solución (documentación previa al cierre) ----
  // El ERP no solo registra la falla: deja constancia de QUÉ se propone hacer,
  // qué se necesita y qué pasa si no se atiende. Sirve para sustentar ante Jefatura.
  proposal        String?          // propuesta de solución planteada por el técnico
  proposalCost    String?          // materiales / recursos que demanda
  proposalRisk    String?          // riesgo o consecuencia de no atenderla
  requiresThirdParty Boolean @default(false) // requiere apoyo de terceros (eléctrica, contratista)

  workOrders      WorkOrder[]        // OM generadas a partir de esta incidencia
  evidences       IncidentEvidence[] // fotografías de campo

  @@index([assetId])
  @@index([status])
  @@index([category])
  @@map("incidents")
}

// =====================================================================
//  DOCUMENTACIÓN TÉCNICA (Módulo 6)
// =====================================================================

enum DocumentCategory {
  MANUAL
  DIAGRAMA
  PLANO
  FOTO
  CONFIG
  BACKUP
}

model Document {
  id         String           @id @default(uuid())
  title      String
  category   DocumentCategory
  fileId     String           // objeto en MinIO
  version    Int              @default(1)
  assetId    String?
  asset      Asset?           @relation(fields: [assetId], references: [id])
  locationId String?
  location   Location?        @relation(fields: [locationId], references: [id])
  uploadedBy String?
  createdAt  DateTime         @default(now())

  @@index([assetId])
  @@index([locationId])
  @@map("documents")
}

// =====================================================================
//  AUDITORÍA E HISTORIAL (transversal)

// =====================================================================
//  HERRAMIENTAS (Bloque 2f)
//
//  UNA HERRAMIENTA NO ES UN REPUESTO.
//  El engrimpador no se consume: se lleva y se devuelve. Modelarlo como stock
//  sería un error porque el stock nunca bajaría y el dato no diría nada.
//
//  Se modela como VERIFICACIÓN al abrir la orden: el sistema sugiere las
//  herramientas según el tipo de trabajo y el técnico confirma cuáles lleva.
//  Queda registrado y el Jefe de Mantenimiento lo ve: si el técnico salió sin
//  el engrimpador y la orden se cerró sin resolver, ahí está la explicación.
// =====================================================================
model Tool {
  id           String          @id @default(uuid())
  code         String?         @unique
  name         String
  /// Familia: Red, Eléctrica, Medición, Altura, Seguridad.
  category     String?
  /// Tipos de orden donde se SUGIERE llevarla. Vacío = se sugiere en todas.
  /// Una orden de mapeo necesita metrajo y etiquetas; una correctiva de red,
  /// engrimpador y probador. Sugerir todo en todas haría que nadie lea la lista.
  suggestedFor WorkOrderType[]
  active       Boolean         @default(true)
  notes        String?
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  checks       WorkOrderTool[]

  @@map("tools")
}

/// Qué herramientas declaró llevar el técnico al abrir la orden.
model WorkOrderTool {
  id          String    @id @default(uuid())
  workOrderId String
  workOrder   WorkOrder @relation(fields: [workOrderId], references: [id], onDelete: Cascade)
  toolId      String
  tool        Tool      @relation(fields: [toolId], references: [id], onDelete: Cascade)
  /// true = la lleva · false = declaró que NO la tiene.
  /// Se guarda el "no" a propósito: es el dato que explica un viaje perdido.
  carried     Boolean   @default(false)
  note        String?

  @@unique([workOrderId, toolId])
  @@index([workOrderId])
  @@map("work_order_tools")
}

// =====================================================================
//  MATERIALES DE LA ORDEN (Bloque 2f)
//
//  POR QUÉ NO SE DESCUENTA STOCK AUTOMÁTICAMENTE
//  El almacén de verdad está en SAP. Si este sistema descontara por su cuenta
//  y SAP también, ninguno de los dos cuadraría nunca. Aquí se registra qué se
//  PREVIÓ y qué se USÓ en cada orden; el catálogo local se actualiza subiendo
//  la exportación de SAP y sirve para comparar, no para reemplazarlo.
// =====================================================================
/// Estado de una LÍNEA de material dentro de la orden.
/// El flujo real de planta: el técnico lista lo que necesita con su código SAP,
/// el ingeniero lo autoriza y sale de almacén, y lo que sobra VUELVE.
/// Sin el último paso el almacén miente y en tres meses nadie se fía del stock.
enum MaterialStatus {
  SOLICITADO  // el técnico lo pidió; todavía no salió de almacén
  RETIRADO    // el ingeniero firmó y se descontó del stock
  DEVUELTO    // sobró y volvió al almacén
  RECHAZADO   // el ingeniero no lo autoriza, con motivo
}

/// Tipo de catálogo editable (bloque 3E).
///
/// POR QUÉ ESTO NO ES UN ENUM MÁS
/// Las causas de cierre vivían en el enum RootCause, con 17 valores fijos en
/// el código. Añadir una exigía migración y despliegue, y en PostgreSQL los
/// valores de un enum solo se pueden añadir al final. Eso significa que la
/// gente de planta no podía nombrar lo que ve sin pedírselo a un programador.
///
/// Es el mismo error que cometí inventando las etapas del proceso. Aquí no se
/// repite: son filas, y las edita quien sabe cómo se llaman las cosas.
enum CatalogKind {
  CAUSA          // por qué falló — sustituye al enum RootCause
  SINTOMA        // qué vio el técnico antes de intervenir
  ACCION         // qué hizo
  MOTIVO_AVANCE  // por qué no se avanzó más de lo declarado
}

/// Una entrada de catálogo. Cuatro listas distintas en una sola tabla porque
/// se comportan igual: código, nombre, grupo y orden. Cuatro tablas iguales
/// serían cuatro CRUD iguales que se desviarían con el tiempo.
model CatalogItem {
  id        String      @id @default(uuid())
  kind      CatalogKind
  /// Código estable. Es lo que se guarda en la orden: si mañana se corrige la
  /// redacción del nombre, el histórico no cambia de significado.
  code      String
  name      String
  /// Familia para agrupar el desplegable. Con 17 opciones en una lista plana,
  /// dentro de un teléfono y con la parada corriendo, el técnico elige la
  /// primera que ve. Agrupadas se encuentran.
  group     String?
  sequence  Int         @default(0)
  /// Se desactiva en vez de borrarse: las órdenes viejas que la usaron tienen
  /// que seguir mostrando qué se eligió.
  active    Boolean     @default(true)
  notes     String?
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  @@unique([kind, code])
  @@index([kind, active])
  @@map("catalog_items")
}

/// Resultado de un punto de la rutina preventiva.
enum ChecklistResult {
  OK
  NO_OK
  NO_APLICA
}

/// RUTINA PREVENTIVA POR TIPO DE ACTIVO (bloque 3F-2).
///
/// POR QUÉ POR TIPO DE ACTIVO Y NO UNA SOLA
/// Una cámara, un grabador y una antena no se mantienen igual. La cámara lleva
/// limpieza de lente, sello y fijación; el grabador lleva discos, ventilación y
/// sesiones; la antena, alineación y tensado. Una lista única obligaría al
/// técnico a ir descartando lo que no toca, que es justo el trabajo mental que
/// queremos quitarle.
///
/// LO QUE HAY DENTRO NO LO ESCRIBO YO. La plantilla nace vacía y la llenan
/// ustedes: yo no sé qué se revisa en una cámara del Tren 2.
model ChecklistTemplate {
  id        String    @id @default(uuid())
  /// Una rutina por tipo de activo. Única: dos rutinas para cámaras acabarían
  /// divergiendo y nadie sabría cuál es la buena.
  assetType AssetType @unique
  name      String
  active    Boolean   @default(true)
  items     ChecklistItem[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@map("checklist_templates")
}

model ChecklistItem {
  id         String            @id @default(uuid())
  templateId String
  template   ChecklistTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  /// Lo que el técnico tiene que comprobar, en imperativo y sin ambigüedad.
  /// "Limpiar el lente y comprobar imagen en el púlpito", no "revisar cámara".
  text       String
  /// Ayuda opcional: cómo se hace o con qué. Se enseña bajo el punto.
  help       String?
  sequence   Int               @default(0)
  /// Si este punto sale NO OK, el sistema PROPONE un correctivo. Se marca solo
  /// en lo que de verdad deja el equipo comprometido: no todo hallazgo es una
  /// orden nueva, y llenar el tablero de órdenes que nadie pidió lo vuelve
  /// papel mojado.
  critical   Boolean           @default(false)
  active     Boolean           @default(true)
  answers    WorkOrderChecklist[]
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt

  @@index([templateId, active])
  @@map("checklist_items")
}

/// Lo que el técnico respondió en UNA orden concreta.
model WorkOrderChecklist {
  id          String          @id @default(uuid())
  workOrderId String
  workOrder   WorkOrder       @relation(fields: [workOrderId], references: [id], onDelete: Cascade)
  itemId      String
  item        ChecklistItem   @relation(fields: [itemId], references: [id], onDelete: Cascade)
  result      ChecklistResult
  /// Detalle solo cuando hace falta: obligatorio si el punto sale NO OK.
  /// Un "no conforme" sin explicación no sirve para nada.
  note        String?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  /// Una respuesta por punto y orden: volver a responder ACTUALIZA, no duplica.
  @@unique([workOrderId, itemId])
  @@index([workOrderId])
  @@map("work_order_checklist")
}

model WorkOrderMaterial {
  id          String     @id @default(uuid())
  workOrderId String
  workOrder   WorkOrder  @relation(fields: [workOrderId], references: [id], onDelete: Cascade)
  /// Repuesto del catálogo, si está catalogado.
  sparePartId String?
  sparePart   SparePart? @relation(fields: [sparePartId], references: [id])
  /// Código SAP copiado al momento del registro. Se guarda aquí a propósito:
  /// si el catálogo cambia después, el histórico de la orden no se altera.
  sapCode     String?
  /// Descripción libre, para lo que no esté catalogado. Siempre se llena.
  description String
  unit        String?
  /// Cantidad PREVISTA al preparar el trabajo.
  plannedQty  Float?
  /// Cantidad REALMENTE usada, al cerrar. La diferencia entre las dos es lo
  /// que dice si se está estimando bien.
  usedQty     Float?

  // ---- Retiro de almacén (3D) ----
  status         MaterialStatus @default(SOLICITADO)
  /// Cantidad que SALIÓ de almacén. Puede no coincidir con lo previsto: el
  /// ingeniero entrega lo que hay, no lo que se pidió.
  withdrawnQty   Float?
  /// Cantidad que VOLVIÓ. Se guarda, no se recalcula: el dato tiene que quedar.
  returnedQty    Float?
  /// Movimiento de stock del retiro. Es el hilo que une la orden con el
  /// almacén: sin él, "se retiró" sería una afirmación sin respaldo.
  movementId     String?
  movement       StockMovement? @relation("MaterialRetiro", fields: [movementId], references: [id])
  /// Movimiento de la devolución, si la hubo.
  returnMovementId String?
  returnMovement   StockMovement? @relation("MaterialDevolucion", fields: [returnMovementId], references: [id])
  /// Quién firmó el retiro y cuándo. El ingeniero, no el técnico.
  withdrawnById  String?
  withdrawnBy    User?          @relation("MaterialRetiradoPor", fields: [withdrawnById], references: [id])
  withdrawnAt    DateTime?
  /// Motivo del rechazo. Obligatorio al rechazar: un "no" sin explicación hace
  /// que el técnico vuelva a pedir lo mismo la semana siguiente.
  rejectedReason String?

  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@index([workOrderId])
  @@index([sparePartId])
  // Estos dos los crea la migracion 20260802000000 y hay que DECLARARLOS aquí:
  // si el esquema no los nombra, la comprobación de desfase del CI entiende que
  // sobran en la base y falla. Fue un descuido mío y el CI lo cazó.
  // Por estado, porque la consulta que se hará mil veces es "qué hay pendiente
  // de retirar", no "dame todas las líneas".
  @@index([status])
  @@index([movementId])
  @@map("work_order_materials")
}

// =====================================================================
//  REEMPLAZO DE EQUIPO (Bloque 2f)
//
//  Cuando se cambia una cámara o una antena, lo que ocurre es un intercambio:
//  sale una y entra otra que estaba en almacén. Registrarlo permite saber a
//  dónde fue cada equipo de repuesto, algo que hoy se pierde por completo.
//
//  El sistema ya tiene el estado STOCK para activos: esta tabla cierra la
//  cadena  STOCK -> asignado a la orden -> instalado -> OPERATIVO.
// =====================================================================
model WorkOrderSwap {
  id               String    @id @default(uuid())
  workOrderId      String
  workOrder        WorkOrder @relation(fields: [workOrderId], references: [id], onDelete: Cascade)
  /// Equipo retirado. Pasa a BAJA o a STOCK según su estado.
  removedAssetId   String?
  removedAsset     Asset?    @relation("SwapRemoved", fields: [removedAssetId], references: [id])
  /// Equipo instalado. Venía de STOCK y pasa a OPERATIVO en la ubicación.
  installedAssetId String?
  installedAsset   Asset?    @relation("SwapInstalled", fields: [installedAssetId], references: [id])
  note             String?
  createdAt        DateTime  @default(now())

  @@index([workOrderId])
  @@map("work_order_swaps")
}

// =====================================================================

model AuditLog {
  id        String   @id @default(uuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id])
  action    String   // CREATE / UPDATE / DELETE / LOGIN / ...
  entity    String
  entityId  String?
  before    Json?
  after     Json?
  ip        String?
  createdAt DateTime @default(now())

  @@index([entity, entityId])
  @@map("audit_logs")
}

model AssetHistory {
  id         String   @id @default(uuid())
  assetId    String
  asset      Asset    @relation(fields: [assetId], references: [id], onDelete: Cascade)
  field      String
  oldValue   String?
  newValue   String?
  changedBy  String?
  createdAt  DateTime @default(now())

  @@index([assetId])
  @@map("asset_history")
}


// ===================== INVENTARIO / REPUESTOS (F3) =====================

enum MovementType {
  INGRESO   // entrada a almacén
  RETIRO    // salida (retiro por código SAP)
  AJUSTE    // corrección de stock
}

/// Repuesto de almacén. El código SAP es libre (para retirar del almacén) y
/// queda listo para sincronizar con SAP a futuro.
model SparePart {
  id            String   @id @default(uuid())
  sapCode       String?  // código SAP (libre)
  name          String
  description   String?
  category      String?  // ej: Fuente PoE, Cámara, Conector, Antena, Disco NVR
  brand         String?
  model         String?  // modelo compatible (compatibilidad por modelo)
  unit          String?  @default("unidad")
  warehouse     String?  // ubicación/almacén
  /// DECIMAL a propósito. El almacén no solo guarda unidades: el cable UTP se
  /// mide en METROS y se consume por tramos. Con enteros, retirar 12,5 m
  /// registraba 13 y devolver 5,2 acreditaba 5. Cada operación perdía décimas
  /// y en pocos meses el stock dejaba de parecerse al estante.
  currentStock  Float    @default(0)
  minStock      Float    @default(0)  // umbral mínimo (alerta)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  lastCheckedAt DateTime?             // última comprobación física

  assets        SparePartAsset[]
  movements     StockMovement[]
  woMaterials   WorkOrderMaterial[]
  checks        StockCheck[]

  @@index([sapCode])
  @@index([category])
  @@map("spare_parts")
}

/// Compatibilidad repuesto <-> activo específico (además del match por modelo).
model SparePartAsset {
  id          String    @id @default(uuid())
  sparePartId String
  sparePart   SparePart @relation(fields: [sparePartId], references: [id], onDelete: Cascade)
  assetId     String
  asset       Asset     @relation(fields: [assetId], references: [id], onDelete: Cascade)

  @@unique([sparePartId, assetId])
  @@index([assetId])
  @@map("spare_part_assets")
}

/// Movimiento de stock (ingreso/retiro/ajuste). El retiro lleva su código SAP.
model StockMovement {
  id          String       @id @default(uuid())
  sparePartId String
  sparePart   SparePart    @relation(fields: [sparePartId], references: [id], onDelete: Cascade)
  type        MovementType
  /// DECIMAL: ver la nota en SparePart.currentStock. Positivo siempre; el
  /// signo lo da el tipo de movimiento.
  quantity    Float
  sapCode     String?      // código SAP del retiro/ingreso
  reason      String?
  userId      String?
  user        User?        @relation(fields: [userId], references: [id])
  createdAt   DateTime     @default(now())

  // Lado inverso del retiro y la devolución de una línea de material (3D).
  materialRetiro     WorkOrderMaterial[] @relation("MaterialRetiro")
  materialDevolucion WorkOrderMaterial[] @relation("MaterialDevolucion")

  @@index([sparePartId])
  @@map("stock_movements")
}

/// Comprobación física periódica (control diario del almacén).
model StockCheck {
  id          String    @id @default(uuid())
  sparePartId String
  sparePart   SparePart @relation(fields: [sparePartId], references: [id], onDelete: Cascade)
  countedQty  Int       // cantidad física comprobada
  previousQty Int?      // stock que había antes de comprobar
  note        String?
  userId      String?
  user        User?     @relation(fields: [userId], references: [id])
  checkedAt   DateTime  @default(now())

  @@index([sparePartId])
  @@map("stock_checks")
}


// ===================== MANTENIMIENTO PREVENTIVO (F6.1) =====================

/// Plan de mantenimiento preventivo por activo.
/// El intervalo depende de la criticidad de la zona (3 meses críticas, 6 meses el resto),
/// editable por el Jefe. nextDueAt = lastServiceAt (o alta) + intervalo.
model PreventivePlan {
  id            String    @id @default(uuid())
  assetId       String    @unique
  asset         Asset     @relation(fields: [assetId], references: [id], onDelete: Cascade)
  intervalDays  Int       @default(60) // 30 días = zona crítica (suciedad), 60 = no crítica (editable)
  zoneCritical  Boolean   @default(false)
  lastServiceAt DateTime?
  nextDueAt     DateTime?
  active        Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([nextDueAt])
  @@index([active])
  @@map("preventive_plans")
}

// ============ ACCESIBILIDAD / TRABAJO EN ALTURA — SSOMA (F6.9) ============
// Hay cámaras y antenas en altura o sobre grúas donde NO se puede intervenir sin
// manlift, izaje o andamio. El manlift es un recurso caro y el trabajo en altura
// (desde 1.80 m) exige PETAR/IPERC/ATS. Por eso el técnico sustenta la solicitud
// con fotos y datos de seguridad, y SOLO el Jefe de Mantenimiento la aprueba.

enum AccessMeans {
  MANLIFT           // plataforma elevadora
  GRUA              // izaje / permiso de grúa
  ANDAMIO
  ESCALERA
  LINEA_VIDA
  OTRO
}

enum AccessRequestStatus {
  SOLICITADO
  EN_REVISION
  APROBADO
  RECHAZADO
}

/// Solicitud de acceso especial a un activo inaccesible (trabajo en altura).
model AccessRequest {
  id             String              @id @default(uuid())
  code           String              @unique // ej: ACC-2026-0001
  assetId        String
  asset          Asset               @relation(fields: [assetId], references: [id], onDelete: Cascade)
  requestedById  String?
  requestedBy    User?               @relation("AccessRequester", fields: [requestedById], references: [id])

  // ---- Sustento técnico ----
  heightMeters   Float?              // altura estimada (trabajo en altura desde 1.80 m)
  means          AccessMeans         @default(MANLIFT)
  locationKind   String?             // poste / estructura / grúa / techo / puente grúa
  justification  String              // por qué es inaccesible sin ese medio
  accessRoute    String?             // cómo se llega / restricciones de la zona

  // ---- Datos SSOMA (seguridad) ----
  requiresPetar  Boolean             @default(true)  // permiso de trabajo de alto riesgo
  hasIperc       Boolean             @default(false) // IPERC elaborado
  hasAts         Boolean             @default(false) // ATS del día
  personnelCount Int?                @default(2)     // mínimo 2 personas en altura
  eppDetail      String?             // arnés, línea de vida, casco con barbiquejo...
  risks          String?             // riesgos identificados
  productionImpact String?           // ¿requiere parar el tren / coordinar con Producción?

  // ---- Revisión (solo Jefe de Mantenimiento) ----
  status         AccessRequestStatus @default(SOLICITADO)
  reviewedById   String?
  reviewedBy     User?               @relation("AccessReviewer", fields: [reviewedById], references: [id])
  reviewedAt     DateTime?
  decisionNotes  String?

  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  photos         AccessRequestPhoto[]

  @@index([assetId])
  @@index([status])
  @@map("access_requests")
}

/// Fotografías que sustentan la inaccesibilidad (obligatorias para aprobar).
model AccessRequestPhoto {
  id        String        @id @default(uuid())
  requestId String
  request   AccessRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  fileId    String
  caption   String?
  createdAt DateTime      @default(now())

  @@index([requestId])
  @@map("access_request_photos")
}

// ===================== FOTOGRAFÍAS DE ACTIVO (F6.4) =====================
enum PhotoKind {
  APUNTA      // a qué apunta (campo de visión, cámaras de púlpito)
  REFERENCIA  // ubicación de referencia física
  PLANO       // ubicación en plano (a futuro)
  GENERAL     // otra foto del equipo
}

/// Fotografías del activo (a qué apunta, referencia, plano) — en MinIO.
model AssetPhoto {
  id        String    @id @default(uuid())
  assetId   String
  asset     Asset     @relation(fields: [assetId], references: [id], onDelete: Cascade)
  kind      PhotoKind @default(GENERAL)
  fileId    String
  caption   String?
  createdAt DateTime  @default(now())

  @@index([assetId])
  @@map("asset_photos")
}

/// Fotografías de campo de una incidencia (almacenadas en MinIO).
model IncidentEvidence {
  id          String   @id @default(uuid())
  incidentId  String
  incident    Incident @relation(fields: [incidentId], references: [id], onDelete: Cascade)
  fileId      String
  caption     String?
  createdAt   DateTime @default(now())

  @@map("incident_evidences")
}
