// =============================================================================
//  SGIT-CCTV — Esquema de datos (Prisma / PostgreSQL)
//  Aceros Arequipa · Planta Pisco · Trenes 1, 2 y 3 (Laminación)
//  Diseño: monolito modular, herencia por tipo de activo, topología PMP,
//          campos SAP-ready, auditoría append-only.
// =============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// =====================================================================
//  SEGURIDAD Y CONTROL DE ACCESO (Módulo 1)
// =====================================================================

model User {
  id           String    @id @default(uuid())
  email        String    @unique
  fullName     String
  passwordHash String
  active       Boolean   @default(true)
  roleId       String
  role         Role      @relation(fields: [roleId], references: [id])
  lastLoginAt  DateTime?
  /// PIN corto para reanudar una orden en campo sin teclear la contraseña
  /// completa con guantes. Se guarda cifrado (argon2), igual que la contraseña.
  /// La apertura y el cierre de la orden SIEMPRE exigen contraseña completa.
  pinHash      String?
  pinUpdatedAt DateTime?
  /// A qué trenes puede MIRAR este usuario. ARRAY VACÍO = TODOS.
  /// El vacío significa "sin restricción" a propósito: así los usuarios que
  /// ya existían siguen viéndolo todo. Si el vacío significara "ninguno",
  /// el día del despliegue la planta entera se queda sin ver nada.
  ambitoTrenes String[]  @default([]) @map("ambito_trenes")
  /// A dónde escribirle por Telegram. Telegram PROHÍBE que un bot inicie
  /// conversación: la persona tiene que escribirle /start primero. Por eso
  /// esto NO se puede rellenar a mano: se guarda cuando el bot recibe el
  /// mensaje con el código de vinculación.
  telegramChatId      String?   @unique @map("telegram_chat_id")
  telegramCodigo      String?   @unique @map("telegram_codigo")
  telegramVinculadoEn DateTime? @map("telegram_vinculado_en")
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  workOrders   WorkOrder[] @relation("AssignedTechnician")
  incidents    Incident[]  @relation("IncidentResponsible")
  /// Incidencias que esta persona LEVANTÓ (bloque 51-B). Es distinto de
  /// `incidents`: aquella dice quién resuelve, ésta dice quién avisó.
  incidenciasReportadas Incident[] @relation("IncidentReporter")
  /// Sus avisos sumados a incidencias que ya estaban abiertas.
  avisosDeProduccion    IncidentAviso[]
  auditLogs    AuditLog[]
  stockMovements StockMovement[]
  stockChecks    StockCheck[]
  materialesRetirados WorkOrderMaterial[] @relation("MaterialRetiradoPor")
  woAsignadas         WorkOrder[]         @relation("WoAssignedBy")
  woDetalladas        WorkOrder[]         @relation("WoDetailedBy")
  accessRequested AccessRequest[] @relation("AccessRequester")
  accessReviewed  AccessRequest[] @relation("AccessReviewer")
  woOpened        WorkOrder[]     @relation("WoOpenedBy")
  woClosed        WorkOrder[]     @relation("WoClosedBy")
  /// Zonas cuya criticidad productiva declaró esta persona (bloque 26).
  /// Prisma EXIGE el lado inverso aunque sólo Location guarde la clave.
  zonasDeclaradas Location[]      @relation("ZonaDeclaradaPor")
  /// Zonas en las que esta persona firmó cómo se interviene (bloque 28).
  zonasIntervencion Location[]    @relation("ZonaIntervencionFirmada")
  /// Equipos en los que esta persona declaró cómo se llega (bloque 41).
  accesosDeclarados Asset[]       @relation("AccesoDeclaradoPor")
  // ---- Bloque 29 ----
  procedimientosCreados ProcedimientoRestauracion[] @relation("ProcedimientoCreadoPor")
  mejorasPropuestas     MejoraProcedimiento[]       @relation("MejoraPropuestaPor")
  mejorasDecididas      MejoraProcedimiento[]       @relation("MejoraDecididaPor")
  notasDeCampo          NotaDeCampo[]               @relation("NotaDeCampoAutor")
  notasResueltas        NotaDeCampo[]               @relation("NotaResueltaPor")
  modelosVerificados    ModeloEquipo[]              @relation("ModeloVerificadoPor")
  woAccompanied   WorkOrder[]     @relation("WoCompanion")
  woProgress      WorkOrderProgress[] @relation("WoProgressBy")
  sesiones        Sesion[]

  @@map("users")
  inspeccionesGrua InspeccionGrua[] @relation("InspeccionGruaPor")
}

/// BLOQUE 42 — hay roles que NO deben ver la planta entera nunca.
///
/// El ámbito por tren (`User.ambitoTrenes`) existía desde el bloque 4C, pero un
/// ámbito vacío significaba «todos los trenes». Para el Jefe de Mantenimiento
/// está bien. Para un jefe de tren convertía un dato que falta en permiso
/// total, y en Aceros Arequipa ver la línea de otro no es ruido en pantalla:
/// es información que sale de su área.
///
/// Con `exigeAmbito` en true, sin tren asignado NO SE VE NADA y la pantalla
/// explica por qué. Nace en `false` para todos los roles existentes: nadie
/// pierde acceso al desplegar. Sólo la plantilla «Jefe de Tren» lo lleva.
model Role {
  id          String           @id @default(uuid())
  name        String           @unique // Administrador, Supervisor TI, Técnico, Consulta
  description String?
  /// Rol que vino con el sistema: no se borra ni se queda sin permisos.
  /// Evita el fallo del que solo se sale por base de datos: quitarte a ti
  /// mismo 'user.manage' y quedarte fuera de la administración.
  sistema     Boolean          @default(false)
  /// Bloque 42. Ver la cabecera del modelo: sin tren asignado, no ve nada.
  /// Es de ROL y no de usuario a propósito — si fuera por persona, cada alta
  /// nueva dependería de que alguien se acordara de marcar la casilla, y en
  /// tres meses habría media plantilla viendo la planta entera.
  exigeAmbito Boolean          @default(false) @map("exige_ambito")
  users       User[]
  permissions RolePermission[]

  @@map("roles")
}

model Permission {
  id          String           @id @default(uuid())
  code        String           @unique // ej: asset.create, wo.approve, incident.close
  description String?
  roles       RolePermission[]

  @@map("permissions")
}

model RolePermission {
  roleId       String
  permissionId String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

// =====================================================================
//  UBICACIONES — jerarquía física (Módulo 3)
//  Empresa > Planta > Tren > Área > Sala/Zona > Rack > (Equipo=Asset)
// =====================================================================

enum LocationType {
  EMPRESA
  PLANTA
  TREN
  AREA
  SALA
  ZONA
  RACK
  /// Etapa del proceso de laminación (F8). Va al FINAL porque PostgreSQL
  /// siempre añade los valores nuevos de un enum al final: si aquí figurara
  /// en otra posición, el esquema y la base no coincidirían.
  ETAPA
}

/// Ambiente físico donde vive el equipo. Es lo que REALMENTE lo degrada.
/// No es lo mismo una cámara sobre el horno recalentador (1,100 °C) que una
/// en el púlpito climatizado: el intervalo de mantenimiento preventivo se
/// deriva de aquí y no de una casilla "crítico sí/no" marcada a criterio.
/// ¿Se puede intervenir con el tren produciendo? (bloque 28)
/// El sistema la PROPONE desde el ambiente; sólo vale si alguien la FIRMA.
enum Intervencion {
  EN_MARCHA              // púlpito, cabina: se trabaja con el tren vivo
  CON_PERMISO_ELECTRICO  // sala eléctrica / MCC: bloqueo eléctrico
  CON_PERMISO_ALTURA     // hay que subir: PETAR y personal acreditado
  EXIGE_PARADA           // barra caliente, vapor, rodillos
  SIN_CLASIFICAR         // sin ambiente declarado: se trata como parada
}

enum Environment {
  CALOR_RADIANTE    // horno recalentador — radiación directa, degrada sellos y óptica
  VAPOR_AGUA        // trenes — refrigeración de rodillos, condensación interna
  POLVO_METALICO    // cascarilla, taller de rodillos, cizalla — abrasión
  INTEMPERIE_SALINA // patios y almacenes — Pisco es costa: corrosión acelerada
  EMI_ALTA          // salas eléctricas y MCC — interferencia electromagnética
  CLIMATIZADO       // púlpitos de control — polvo normal
}

// =====================================================================
//  ETAPAS DEL PROCESO DE LAMINACIÓN (F8)
//
//  Es CATÁLOGO EDITABLE, no un enum. Razón técnica concreta: los tres
//  trenes NO comparten las mismas etapas —el Tren 1 produce perfiles, el
//  Tren 2 sólo corrugado y el Tren 3 es una línea distinta—. Con un enum,
//  cada diferencia obligaría a migración de base de datos y redespliegue;
//  con una tabla lo edita el Jefe de Mantenimiento desde la interfaz.
//
//  El catálogo define la etapa UNA vez; el árbol de ubicaciones la
//  instancia en cada tren que la tenga.
// =====================================================================
model ProcessStage {
  id                  String      @id @default(uuid())
  code                String      @unique // ej: DESBASTE, HORNO_RECAL
  name                String
  /// Orden dentro del proceso (palanquilla -> producto terminado). Permite
  /// dibujar el tren de izquierda a derecha y detectar tramos ciegos seguidos.
  sequence            Int
  environment         Environment
  /// Criticidad MÍNIMA de todo activo instalado en esta etapa. Una cámara
  /// caída en el tren de desbaste deja al operador ciego ante un atasco a
  /// 1,100 °C; una caída en el almacén no detiene nada.
  baseCriticality     Criticality
  /// Intervalo preventivo sugerido en días, derivado del ambiente. Editable.
  defaultIntervalDays Int
  /// Qué vigila el CCTV en esta etapa (para el informe y la capacitación).
  watches             String?
  active              Boolean     @default(true)
  createdAt           DateTime    @default(now())
  updatedAt           DateTime    @updatedAt

  locations           Location[]

  @@index([sequence])
  @@map("process_stages")
}

model Location {
  id               String       @id @default(uuid())
  type             LocationType
  code             String       @unique // ej: AASA-PISCO-T1-LAMIN-R01
  name             String
  parentId         String?
  parent           Location?    @relation("LocationTree", fields: [parentId], references: [id])
  children         Location[]   @relation("LocationTree")
  path             String       @default("") // ruta materializada para navegación rápida
  photoFileId      String?      // foto de referencia de la ubicación (MinIO)
  /// CÓMO LLEGAR, en texto llano.
  /// "Desde el púlpito del Tren 2, bajar la escalera norte, 20 m hacia el
  /// lecho de enfriamiento, poste de la izquierda."
  /// Es la mejora de mayor impacto para el personal nuevo, que hoy recibe una
  /// orden con un código de activo y no tiene idea de dónde está.
  howToGet         String?
  /// LA SIGLA DEL TREN (bloque 43). Sólo aplica a type=TREN.
  ///
  /// Es el identificador corto que va EN EL RÓTULO del equipo —la T1 de
  /// `AA-CAM-T1-LECHO-014`— y el que se usa para el ámbito de un jefe de tren.
  ///
  /// Antes no existía: se sacaba cortando `Location.code` por el último guion
  /// (`AASA-PISCO-T2` -> `T2`). Era una convención implícita que nadie declaró
  /// y que se rompe sola: un tren creado como `AASA-PISCO-TREN1` daba rótulos
  /// `AA-CAM-TREN-...` sin que nada avisara. Y el ámbito usaba el código
  /// COMPLETO, así que había dos formas distintas de sacar «qué tren es» del
  /// mismo campo — que es exactamente lo que hizo que chocaran.
  ///
  /// Se edita desde Ubicaciones, como todo lo de planta. Si está vacía se
  /// sigue deduciendo del código, pero avisando.
  siglaTren        String?
  // ---- Proceso de laminación (F8) ----
  /// Etapa del proceso que representa esta ubicación. Sólo aplica a type=ETAPA.
  stageId          String?
  stage            ProcessStage? @relation(fields: [stageId], references: [id])
  /// Ambiente puntual. Normalmente se hereda de la etapa; se usa sólo cuando
  /// un punto concreto difiere del resto (ej. una cámara dentro de un cofre
  /// refrigerado en plena zona de calor).
  environment      Environment?
  // ---- CRITICIDAD PRODUCTIVA (bloque 26) — la declara PRODUCCIÓN ----
  /// Qué le pasa a la producción si esta zona se queda a ciegas.
  /// NO la pone Mantenimiento: la pone quien conoce el proceso. Sube la
  /// criticidad de todos los activos que cuelgan de aquí (nunca la baja).
  criticidadProduccion Criticality?
  /// El motivo, escrito. La base OBLIGA a rellenarlo si la criticidad es
  /// ALTA o CRÍTICA: sin esa regla, en tres meses todo es crítico y el campo
  /// deja de ordenar nada.
  porQueEsVital        String?
  /// Qué ocurre en concreto si se pierde la vista aquí: se para la línea, se
  /// pierde la trazabilidad del colado, no se ve a la cuadrilla en el foso…
  impactoSiSeCae       String?
  /// QUÉ SE VE DESDE AQUÍ. Es el campo que Producción pidió: no el nombre de
  /// la zona, sino a qué da visión. «Salida del horno y entrada al desbaste».
  queSeVigila          String?
  /// Quién firmó la declaración. Si el usuario se da de baja, la declaración
  /// sobrevive sin nombre: borrarla dejaría zonas críticas en silencio.
  declaradoPorId       String?
  declaradoPor         User?    @relation("ZonaDeclaradaPor", fields: [declaradoPorId], references: [id], onDelete: SetNull)
  declaradoEn          DateTime?
  /// Hasta cuándo vale. La planta cambia; una criticidad de 2026 aplicada en
  /// 2029 es una mentira con fecha.
  revisarAntesDe       DateTime?

  // ---- INTERVENIBILIDAD (bloque 28) — la firman Tercería y Mantenimiento ----
  /// Lo que alguien FIRMÓ. Vacío = el sistema exige parada, diga lo que diga
  /// la propuesta. La propuesta sugiere; sólo la firma autoriza.
  intervencionFirmada      Intervencion?
  /// Por qué se puede trabajar así. La base lo EXIGE salvo para las opciones
  /// restrictivas: una autorización sin motivo no es una autorización.
  intervencionMotivo       String?
  intervencionFirmadaPorId String?
  intervencionFirmadaPor   User?    @relation("ZonaIntervencionFirmada", fields: [intervencionFirmadaPorId], references: [id], onDelete: SetNull)
  intervencionFirmadaEn    DateTime?
  /// Si llegar al equipo exige manlift o escalera. Sube la exigencia sin
  /// importar lo fresca que esté la zona: subir es subir.
  requiereAltura           Boolean  @default(false)

  // ---- Campos SAP-ready ----
  sapLocationCode  String?
  costCenter       String?
  responsibleArea  String?
  instalaciones    Instalacion[]
  zonasCampana     ZonaCampana[]
  tablerosElectricos TableroElectrico[]
  subredes         Subred[]
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  assets           Asset[]
  documents        Document[]
  cabinets         Cabinet[]
  workOrders       WorkOrder[]

  @@index([parentId])
  // Bloque 43. El índice existe en el SQL de la migración; declararlo aquí es
  // obligatorio o Prisma genera una migración que lo borra (pasó el 17/08).
  @@index([siglaTren])
  @@index([path])
  @@index([stageId])
  /// Bloque 26. Este índice lo CREA la migración, así que tiene que estar
  /// declarado aquí también: si sólo vive en el SQL, `prisma migrate diff`
  /// ve un índice que el esquema no pide y lo marca como desfase. Fue el
  /// fallo del CI #89.
  @@index([criticidadProduccion])
  @@map("locations")
}

// =====================================================================
//  GABINETES / RACKS (F6.3) — parámetro de mantenimiento, NO es un activo.
//  Un gabinete tiene rótulo propio, ubicación y foto; los equipos montados
//  (NVR, switch, etc.) indican en qué gabinete están para ubicarlos rápido.
// =====================================================================
model Cabinet {
  id          String    @id @default(uuid())
  code        String    @unique // rótulo del gabinete (ej. GAB-T1-R01)
  name        String
  locationId  String?
  location    Location? @relation(fields: [locationId], references: [id])
  referencePlace String? // referencia física (texto libre)
  photoFileId String?    // foto del gabinete en MinIO
  notes       String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  assets      Asset[]

  @@index([locationId])
  @@map("cabinets")
}

// =====================================================================
//  CABLEADO — enums (Bloque 2)
// =====================================================================

enum CableCategory {
  CAT5E
  CAT6
  CAT6A
  FIBRA_MONOMODO
  FIBRA_MULTIMODO
  COAXIAL          // cámaras analógicas conectadas a DVR
  OTRO
}

/// Por dónde corre el tramo. Importa para el diagnóstico: un cable sin
/// blindaje que corre por la misma bandeja que la fuerza, en una planta con
/// hornos y centros de control de motores, se llena de ruido y da fallas
/// intermitentes imposibles de reproducir.
enum CableRoute {
  AEREA
  CANALETA
  BANDEJA          // compartida con fuerza: revisar blindaje
  SUBTERRANEA
  TUBERIA
  INTEMPERIE
}

enum CableStatus {
  INSTALADO
  DANADO
  A_REEMPLAZAR
  RETIRADO
}

enum VideoOutputType {
  HDMI
  VGA
  DVI
  DISPLAYPORT
  BNC
}

/// Distribución del videowall en una pantalla.
enum ScreenLayout {
  UNO              // 1x1, una cámara a pantalla completa
  DOS_X_DOS        // 4 cuadros
  TRES_X_TRES      // 9 cuadros
  CUATRO_X_CUATRO  // 16 cuadros
  OTRO
}

/// De dónde recibe la señal una pantalla. En varios púlpitos la maneja el PC
/// con iVMS-4200 y no un decodificador: hay que contemplar los dos casos o la
/// mitad de los púlpitos no se puede registrar.
enum ScreenSource {
  DECODIFICADOR
  PC
}

/// En qué red vive la IP de gestión de un equipo.
/// En Pisco la gestión va en 10.x.x.x y las cámaras y antenas en 192.x.x.x.
/// Saberlo determina si el servidor puede alcanzar el equipo por ping.
enum MgmtNetwork {
  GESTION      // 10.x.x.x — alcanzable desde el servidor
  CAMARAS      // 192.x.x.x — detrás del grabador, no alcanzable
  OTRA
}

// =====================================================================
//  PROCEDIMIENTO DE RESTAURACIÓN Y NOTAS DE CAMPO (bloque 29)
//  Los dos cuelgan del QR del equipo: es la única puerta que el técnico
//  abre de verdad estando en planta.
// =====================================================================

enum EstadoMejora {
  PROPUESTA
  ACEPTADA
  RECHAZADA
}

enum TipoNotaCampo {
  DEJADO_A_MEDIAS   // quedó provisional y hay que terminarlo
  VIGILAR           // puede volver a fallar
  RIESGO_ACCESO     // la escalera, el poste, el paso bloqueado
  ESPERANDO_A_OTRO  // almacén, TI, Producción, un tercero
}

/// CÓMO SE RESTAURA ESTE MODELO DE EQUIPO.
///
/// Va por MODELO, no por activo. Si colgara de cada cámara habría 300
/// procedimientos vacíos y nadie llenaría ninguno; por modelo se escribe una
/// vez y sirve para las 300. Marca y modelo vacíos = vale para todo el tipo,
/// que es la red de abajo para que siempre haya algo que enseñar.
model ProcedimientoRestauracion {
  id           String    @id @default(uuid())
  tipoActivo   AssetType
  marca        String?
  modelo       String?
  titulo       String
  pasos        String[]  @default([])
  advertencias String?
  /// Cuánto suele llevar. Sirve para saber si entra en la ventana y para
  /// comparar con el tiempo real: así se ve si el procedimiento mejora de
  /// verdad o sólo sobre el papel.
  minutosEstimados Int?
  activo       Boolean   @default(true)
  creadoPorId  String?
  creadoPor    User?     @relation("ProcedimientoCreadoPor", fields: [creadoPorId], references: [id], onDelete: SetNull)
  mejoras      MejoraProcedimiento[]
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([tipoActivo, marca, modelo])
  @@map("procedimientos_restauracion")
}

/// Una mejora propuesta DESDE una intervención real.
/// El que acaba de arreglarlo sabe el atajo; esto es donde lo deja escrito.
/// La acepta o la rechaza el Jefe: si entrara sola, el procedimiento se
/// llenaría de manías personales.
model MejoraProcedimiento {
  id              String  @id @default(uuid())
  procedimientoId String
  procedimiento   ProcedimientoRestauracion @relation(fields: [procedimientoId], references: [id], onDelete: Cascade)
  /// De qué orden salió. Una mejora sin trabajo detrás es una opinión.
  workOrderId     String?
  workOrder       WorkOrder? @relation("MejoraDesdeOm", fields: [workOrderId], references: [id], onDelete: SetNull)
  texto           String
  minutosReales   Int?
  estado          EstadoMejora @default(PROPUESTA)
  propuestaPorId  String?
  propuestaPor    User?   @relation("MejoraPropuestaPor", fields: [propuestaPorId], references: [id], onDelete: SetNull)
  decididaPorId   String?
  decididaPor     User?   @relation("MejoraDecididaPor", fields: [decididaPorId], references: [id], onDelete: SetNull)
  decididaEn      DateTime?
  motivoDecision  String?
  createdAt       DateTime @default(now())

  @@index([procedimientoId, estado])
  @@map("mejoras_procedimiento")
}

/// LA ENTREGA DE TURNO, PEGADA AL EQUIPO.
///
/// No es una bitácora de turno: eso se abandona en tres semanas porque hay
/// que acordarse de llenarla al final, cansado. Esto se escribe trabajando y
/// aparece solo cuando el siguiente escanea el QR de ese equipo.
model NotaDeCampo {
  id           String  @id @default(uuid())
  assetId      String
  asset        Asset   @relation(fields: [assetId], references: [id], onDelete: Cascade)
  tipo         TipoNotaCampo
  texto        String
  /// La nota MUERE SOLA. Sin esto, en seis meses el QR devuelve veinte avisos
  /// viejos y el técnico deja de leerlos — que es peor que no tenerlos,
  /// porque el que sí importa queda enterrado.
  vigenteHasta DateTime?
  resuelta     Boolean @default(false)
  resueltaPorId String?
  resueltaPor  User?   @relation("NotaResueltaPor", fields: [resueltaPorId], references: [id], onDelete: SetNull)
  resueltaEn   DateTime?
  workOrderId  String?
  workOrder    WorkOrder? @relation("NotaDesdeOm", fields: [workOrderId], references: [id], onDelete: SetNull)
  autorId      String?
  autor        User?   @relation("NotaDeCampoAutor", fields: [autorId], references: [id], onDelete: SetNull)
  createdAt    DateTime @default(now())

  @@index([assetId, resuelta])
  @@map("notas_de_campo")
}

/// OBSOLESCENCIA POR MODELO (bloque 32).
///
/// «¿Qué cámaras ya no se consiguen?» es una pregunta del MODELO, no del
/// activo. Por modelo se averigua UNA vez con el fabricante y sirve para las
/// 300; por activo habría que marcarlo 300 veces y en tres meses la mitad
/// estaría sin marcar.
model ModeloEquipo {
  id             String    @id @default(uuid())
  tipoActivo     AssetType
  marca          String
  modelo         String
  /// Cuándo el fabricante deja de dar parches de firmware.
  finDeSoporte   DateTime?
  /// Ya no se consigue en el mercado. Lo marca una persona: no se deduce.
  sinRecambio    Boolean   @default(false)
  /// Con qué se reemplaza. Es la respuesta que hará falta el día que falle,
  /// y averiguarla ese día cuesta una semana.
  reemplazadoPor String?
  notas          String?
  verificadoPorId String?
  verificadoPor  User?     @relation("ModeloVerificadoPor", fields: [verificadoPorId], references: [id], onDelete: SetNull)
  verificadoEn   DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@unique([tipoActivo, marca, modelo])
  @@map("modelos_equipo")
}

// =====================================================================
//  ACTIVOS TECNOLÓGICOS (Módulo 2) — tabla base + herencia por tipo
// =====================================================================

enum AssetType {
  CAMERA
  NVR
  SWITCH
  WIRELESS   // antena / radioenlace (Ubiquiti, Mimosa)
  ROUTER
  FIREWALL
  SERVER
  UPS
  FIBER
  CABINET
  DECODER    // video wall / decoder Hikvision
  PC         // estación de visualización (iVMS-4200) — parte del mantenimiento CCTV
  /// FUENTE / INYECTOR PoE (bloque 45). Es un activo propio y no un campo de la
  /// antena porque SE QUEMA Y SE CAMBIA: genera su propia orden, su propio
  /// historial y consume su propio repuesto de almacén. Hoy esas fallas se
  /// registraban como «falló la antena» y el repuesto real era otro.
  ///
  /// Va SIEMPRE colgado de su equipo padre con `parteDeId`, nunca suelto en el
  /// listado: trescientas fuentes flotando en Activos y nadie sabe cuál es de
  /// cuál.
  PSU
  /// Teléfono IP. No es de CCTV, y por eso se marca: para que nadie lo toque.
  PHONE
  OTHER
  /// Monitor del videowall del púlpito. Es activo propio y no un campo del
  /// decodificador porque se quema, se raya y pierde brillo: eso genera su
  /// propia orden de mantenimiento y su propio historial.
  /// Va al final: PostgreSQL añade los valores nuevos de un enum al final.
  PANTALLA
  /// Tablero eléctrico. Es un activo propio porque se inspecciona, se
  /// termografía y falla — y porque de él cuelga la alimentación de las
  /// cámaras: cuando salta una llave, hay que saber qué se apagó.
  TABLERO_ELECTRICO
}

enum AssetStatus {
  OPERATIVO
  FUERA_SERVICIO
  MANTENIMIENTO
  BAJA
  STOCK
}

enum Criticality {
  BAJA
  MEDIA
  ALTA
  CRITICA // pérdida de visión que detiene o arriesga producción
}

/// OBSOLETO desde F8 — se conserva sólo por seguridad de reversión.
///
/// Este enum creaba una SEGUNDA jerarquía en competencia con el árbol de
/// ubicaciones: nada impedía que un activo colgara de "Tren 2" en el árbol y
/// dijera TREN_1 aquí. Es el mismo problema de duplicación de verdad que se
/// corrigió en F5 con el estado derivado, pero en la dimensión de ubicación.
///
/// A partir de F8 el tren se DEDUCE subiendo el árbol de ubicaciones
/// (ver common/plant-context.ts). La columna Asset.train permanece poblada
/// durante una fase de transición y se eliminará cuando todos los módulos
/// lean del árbol. No escribir lógica nueva contra este campo.
enum PlantTrain {
  TREN_1
  TREN_2
  TREN_3
  PATIO           // patios, almacenes y exteriores
  PLANTA_GENERAL  // servicios comunes, oficinas, accesos
}

model Asset {
  id            String      @id @default(uuid())
  assetCode     String      @unique // ej: AA-CAM-T1-FX-001
  type          AssetType
  brand         String?
  model         String?
  serialNumber  String?
  firmware      String?
  ipAddress     String?     // IP principal (sensible: solo roles con credential.read)
  referencePlace String?    // lugar de referencia en planta (texto libre)
  status        AssetStatus @default(OPERATIVO)
  criticality   Criticality @default(MEDIA)
  /// OBSOLETO desde F8: el tren se deduce del árbol de ubicaciones.
  /// Se mantiene poblado en la transición para poder revertir sin pérdida.
  train         PlantTrain?
  installDate   DateTime?
  warrantyEnd   DateTime?
  locationId    String?
  location      Location?   @relation(fields: [locationId], references: [id])
  cabinetId     String?     // gabinete donde está montado (NVR, switch, etc.)
  /// MONTADO DENTRO DE UN TABLERO ELÉCTRICO.
  /// En planta hay tableros que llevan dentro switches pequeños. Ese switch
  /// no está en un gabinete de comunicaciones: está atornillado ahí dentro.
  /// Crear un "gabinete" falso por cada tablero daría dos registros para una
  /// sola cosa física, y a los tres meses uno se actualiza y el otro no.
  tableroId     String?
  tableroMontaje TableroElectrico? @relation("EquiposEnTablero", fields: [tableroId], references: [id])
  cabinet       Cabinet?    @relation(fields: [cabinetId], references: [id])

  // ---- CÓMO SE LLEGA A ESTE EQUIPO (bloque 41) ----
  /// El medio de acceso, DECLARADO POR ACTIVO. NULL significa «nadie lo ha
  /// dicho», que NO es lo mismo que «se llega a pie»: por eso no hay valor por
  /// defecto. `Location.requiereAltura` sigue existiendo y sigue sirviendo para
  /// PROPONER, pero la zona es demasiado gruesa para costear un manlift — en la
  /// misma zona hay una cámara en la pared a 2 m y otra en el poste a 8 m.
  /// COMPONENTE DE OTRO ACTIVO (bloque 45).
  ///
  /// La fuente PoE de una antena, la carcasa de una cámara, el calefactor, el
  /// conversor de medios: piezas que SE QUEMAN Y SE CAMBIAN sin que el equipo
  /// padre desaparezca. Necesitan orden, incidencia, historial y repuesto —
  /// exactamente lo que ya tiene un activo— así que son activos, no una tabla
  /// aparte que obligaría a duplicar las cuatro cosas.
  ///
  /// LO QUE EVITA EL DESORDEN: el listado de Activos OCULTA los componentes por
  /// defecto. Sólo aparecen dentro de la ficha de su equipo padre.
  ///
  /// Heredan del padre la ubicación, el tren, la zona y el acceso: la fuente
  /// está donde está la antena, y si hay que subir con manlift se sube UNA vez
  /// para las dos. No cuenta como una subida aparte.
  parteDeId     String?
  parteDe       Asset?      @relation("ComponentesDelActivo", fields: [parteDeId], references: [id], onDelete: SetNull)
  componentes   Asset[]     @relation("ComponentesDelActivo")

  medioAcceso   MedioAcceso?
  /// Altura del punto de montaje. Desde 1.80 m es trabajo en altura (SSOMA).
  alturaMetros  Float?
  /// El detalle que no cabe en el enum: «el manlift no entra con el tren en
  /// marcha, hay que posicionarlo desde el pasillo norte».
  accesoNota    String?
  /// Quién lo declaró. Si se da de baja, el dato sobrevive sin nombre: borrarlo
  /// dejaría el equipo como no declarado y alguien subiría sin preparar nada.
  accesoDeclaradoPorId String?
  accesoDeclaradoPor   User?  @relation("AccesoDeclaradoPor", fields: [accesoDeclaradoPorId], references: [id], onDelete: SetNull)
  accesoDeclaradoEn    DateTime?

  // ---- Campos SAP-ready ----
  sapId         String?     @unique
  costCenter    String?
  responsibleArea String?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  deletedAt     DateTime?   // soft delete

  // Extensiones por tipo (1:1)
  camera        AssetCamera?
  nvr           AssetNvr?
  switchDev     AssetSwitch?
  wireless      AssetWireless?

  // Relaciones operativas y de red
  credentials   Credential[]
  workOrders    WorkOrder[]
  incidents     Incident[]
  documents     Document[]
  history       AssetHistory[]
  portsOnSwitch SwitchPort[]  @relation("PortSwitch")
  connectedPort SwitchPort?   @relation("PortConnectedAsset")
  linksA        NetworkLink[] @relation("LinkEndpointA")
  linksB        NetworkLink[] @relation("LinkEndpointB")
  spareLinks    SparePartAsset[]
  swapsRemoved   WorkOrderSwap[] @relation("SwapRemoved")
  swapsInstalled WorkOrderSwap[] @relation("SwapInstalled")
  inspeccionesGrua InspeccionGrua[] @relation("InspeccionGruaAsset")
  preventivePlan PreventivePlan?
  photos        AssetPhoto[]
  // ---- Fichas por tipo (Bloque 2) ----
  decoder       AssetDecoder?
  screen        AssetScreen?
  pc            AssetPc?
  // ---- Tramos de cable (Bloque 2) ----
  cablesFrom    AssetCable[]  @relation("CableFrom")
  cablesTo      AssetCable[]  @relation("CableTo")
  /// Cuadros de videowall donde aparece esta cámara.
  screenCells   ScreenCell[]  @relation("ScreenCellCamera")
  /// Orden de MAPEO en la que se levantó este activo. Permite reconstruir
  /// quién lo registró, cuándo y con quién.
  /// FICHA INCOMPLETA. El técnico guarda en campo con lo mínimo y completa
  /// después; el sistema no bloquea el registro. Sin esto, ante un formulario
  /// exigente el técnico inventa datos para poder guardar, y eso es peor que
  /// dejarlo vacío.
  isDraft       Boolean     @default(false)
  mappedInWorkOrderId String?
  mappedInWorkOrder   WorkOrder? @relation("AssetMappedInWo", fields: [mappedInWorkOrderId], references: [id])
  accessRequests AccessRequest[]
  /// Instalaciones que dieron origen a este activo (normalmente una).
  instalacionesOrigen Instalacion[] @relation("AssetDeInstalacion")
  /// Campaña de mapeo en la que se levantó. Permite revisar por lotes.
  campanaId     String?
  campana       CampanaMapeo? @relation(fields: [campanaId], references: [id])
  /// De qué circuito(s) se alimenta. Contesta "¿qué llave le corta la luz?".
  alimentadoPor AlimentacionActivo[]
  /// Si este activo ES un tablero eléctrico.
  tableroElectrico TableroElectrico[]
  /// Reservas de IP declaradas para este equipo.
  reservasIp    ReservaIp[]
  /// Avisos pegados a ESTE equipo para el que llegue después (bloque 29).
  /// Es la entrega de turno: aparece sola al escanear el QR.
  notasDeCampo NotaDeCampo[]


  @@index([type])
  @@index([status])
  @@index([locationId])
  @@index([campanaId])
  @@index([tableroId])
  @@index([cabinetId])
  @@index([train])
  // Bloque 41. El tablero por tren separa constantemente «exige elevador» de
  // «sin declarar», y la clave foránea necesita índice para que dar de baja a
  // una persona no obligue a recorrer la tabla entera.
  @@index([medioAcceso])
  // Bloque 45. El listado filtra por «sin padre» en cada carga.
  @@index([parteDeId])
  @@index([accesoDeclaradoPorId])
  // NOTA PARA EL FUTURO: un índice creado en el SQL de una migración TIENE que
  // declararse también aquí. Si no, `prisma migrate dev` lo ve como algo que
  // sobra en la base y genera una migración que lo BORRA — con una fecha que
  // cae en medio del historial, así que en una base nueva se ejecutaría antes
  // de que el índice exista y el despliegue se caería. Pasó el 17/08 con
  // `locations_siglaTren_idx`.
  observacion     AssetObservation?
  @@map("assets")
}

model AssetCamera {
  assetId          String  @id
  asset            Asset   @relation(fields: [assetId], references: [id], onDelete: Cascade)
  resolution       String? // ej: 2560x1440 (4MP)
  cameraUser       String?
  rtspUrl          String?
  ipAddress        String? // se valida como INET a nivel de app/migración
  macAddress       String?
  vlanId           String?
  vlan             Vlan?   @relation(fields: [vlanId], references: [id])
  nvrId            String? // NVR asociado (Asset de tipo NVR)
  /// CANAL del grabador donde entra esta cámara. Sin él no hay mapa de canales
  /// ni forma de traducir lo que reporta el púlpito.
  nvrChannel       Int?
  /// NOMBRE tal como aparece en el grabador y en la pantalla del púlpito.
  /// Es el IDIOMA COMÚN: el operador no dice "AA-CAM-T2-045", dice "la de la
  /// grúa 2". Sin este campo cada reporte hay que traducirlo a mano.
  nvrName          String?
  /// Tipo físico: fija, domo, PTZ, bullet, térmica.
  cameraStyle      String?
  /// De qué puerto PoE se alimenta. Es lo que el técnico necesita en sitio:
  /// "es PoE y cuelga del puerto 8 del switch de la caja R-03".
  poeSourcePortId  String?
  poeSourcePort    SwitchPort? @relation("CameraPoeSource", fields: [poeSourcePortId], references: [id])
  switchPortId     String? @unique
  switchPort       SwitchPort? @relation(fields: [switchPortId], references: [id])
  wirelessUplinkId String? // antena suscriptora/PMP por la que cuelga

  @@map("asset_cameras")
}

model AssetNvr {
  assetId       String  @id
  asset         Asset   @relation(fields: [assetId], references: [id], onDelete: Cascade)
  channels      Int?
  diskCount     Int?
  capacityTb    Float?
  hasLocalDisk  Boolean @default(false) // relevante para grúas (informe GRU-107)
  switchIdDirect String? // switch al que se conecta directo (topología anillo)
  nicPrimary    String? // ej: 172.16.x (segmento industrial)
  nicSecondary  String? // ej: 10.0.x   (segmento visualización iVMS-4200)

  @@map("asset_nvrs")
}

model AssetSwitch {
  assetId    String       @id
  asset      Asset        @relation(fields: [assetId], references: [id], onDelete: Cascade)
  portCount  Int?
  /// Cuántos puertos entregan PoE y con qué presupuesto total en watts.
  /// Permite saber si el switch aún puede alimentar otra cámara. Agregar
  /// equipos sin revisar el presupuesto es causa habitual de caídas
  /// intermitentes que nadie asocia al switch.
  poePorts   Int?
  poeBudgetW Int?
  mgmtIp     String?
  /// En qué red vive esa IP de gestión. Determina si el servidor la alcanza
  /// por ping: en Pisco la gestión va en 10.x y las cámaras en 192.x.
  mgmtNetwork MgmtNetwork?
  vendor     String?      // Fortinet / FortiSwitch / TP-Link
  switchRole SwitchRole   @default(DISTRIBUCION)
  ports      SwitchPort[]

  @@map("asset_switches")
}

enum SwitchRole {
  CORE_ANILLO
  DISTRIBUCION
  AJENO       // switch de terceros colgado del FortiSwitch
  POE_ACCESO
}

enum WirelessMode {
  PMP_BASE    // antena principal punto-multipunto (púlpito)
  SUSCRIPTOR  // antena que cuelga de la PMP base
  PTP         // radioenlace punto a punto
  ESTACION
}

model AssetWireless {
  assetId         String       @id
  asset           Asset        @relation(fields: [assetId], references: [id], onDelete: Cascade)
  vendor          String?      // Ubiquiti (airMAX), Mimosa C6x, TP-Link
  frequency       String?
  mode            WirelessMode @default(SUSCRIPTOR)
  parentWirelessId String?     // auto-referencia lógica: suscriptor -> PMP base
  switchPortId    String?      @unique
  switchPort      SwitchPort?  @relation(fields: [switchPortId], references: [id])
  originPoint     String?
  destPoint       String?
  signalDbm       Int?
  ssid            String?
  /// ¿Tenemos las credenciales de esta antena?
  /// Hay antenas en planta de las que nadie tiene la clave. Marcarlo permite
  /// planificar la campaña de barrido con datos y no de memoria.
  hasCredentials  Boolean      @default(false)
  linkStable      Boolean      @default(true) // caídas abruptas => sesiones NVR colgadas

  @@map("asset_wireless")
}

// =====================================================================
//  RED / TOPOLOGÍA (Módulo transversal — soporte a troubleshooting)
// =====================================================================


// =====================================================================
//  TRAMOS DE CABLE (Bloque 2)
//
//  POR QUÉ ES UN TRAMO ENTRE DOS PUNTOS Y NO UN DATO DE LA CÁMARA
//  Ethernet tiene un límite duro de 90 m de tramo horizontal. Pasado eso el
//  enlace NO falla: falla A VECES. Funciona con frío, se cae con calor.
//  Eso es exactamente el "se arregla y vuelve a fallar" que nadie explica.
//  Y nadie lo va a descubrir si no está anotado que ese tramo mide 118 m.
//
//  Modelado como tramo (de dónde a dónde) y no como atributo del equipo,
//  porque así alimenta el diagrama de topología, el análisis de impacto y la
//  detección de reincidencia POR TRAMO: varias cámaras que fallan y comparten
//  el mismo tramo apuntan al cable, no a las cámaras.
// =====================================================================
model AssetCable {
  id              String        @id @default(uuid())
  code            String?       // rótulo del tramo, si lo tiene
  /// COLOR DE LA CHAQUETA (bloque 45).
  ///
  /// No es decoración: es el rótulo dicho en otro idioma, para quien está
  /// delante del rack con una linterna. El sistema lo DEDUCE de los dos
  /// extremos del tramo y avisa si lo declarado no coincide — pero no lo
  /// corrige: puede haber un motivo, y decidirlo en silencio sería elegir cuál
  /// de los dos datos vale.
  ///
  /// Apunta a un CATÁLOGO EDITABLE, no a un enum: un estándar de cableado es
  /// justo lo que una empresa revisa, y un enum obliga a desplegar para añadir
  /// un color.
  colorId         String?
  color           ColorDeCable? @relation(fields: [colorId], references: [id], onDelete: SetNull)
  category        CableCategory
  /// Longitud del tramo en metros. El almacén compra por rollo, pero el
  /// tramo instalado se mide en metros.
  meters          Float?
  /// true = estimado a ojo · false = medido con metrajo.
  /// Se distingue porque no se puede decidir un reemplazo sobre un número
  /// inventado: el aviso de los 90 m dice si el dato es medido o aproximado.
  metersEstimated Boolean       @default(true)
  /// Blindado (STP/FTP). En una siderúrgica un UTP común corriendo junto a
  /// una bandeja de fuerza se llena de ruido: mismo síntoma intermitente.
  shielded        Boolean       @default(false)
  route           CableRoute?
  status          CableStatus   @default(INSTALADO)

  // ---- Extremos del tramo ----
  /// Equipo de origen (switch, grabador, antena) y puerto del que sale.
  fromAssetId     String?
  fromAsset       Asset?        @relation("CableFrom", fields: [fromAssetId], references: [id])
  fromPortNumber  Int?
  /// Equipo de destino.
  toAssetId       String?
  toAsset         Asset?        @relation("CableTo", fields: [toAssetId], references: [id])

  installedAt     DateTime?
  notes           String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([fromAssetId])
  @@index([toAssetId])
  @@index([status])
  // Bloque 45. Declarado aquí ADEMÁS de crearlo en el SQL: si sólo está en la
  // migración, Prisma lo ve como algo que sobra en la base y genera otra que lo
  // BORRA, con fecha en medio del historial. Pasó el 17/08 con la sigla de tren.
  @@index([colorId])
  @@map("asset_cables")
}

// =====================================================================
//  DECODIFICADOR Y VIDEOWALL DEL PÚLPITO (Bloque 2)
//
//  La cadena real es:
//    GRABADOR -> DECODIFICADOR -> salida HDMI 1 -> PANTALLA 1 -> 2x2 -> cámaras
//
//  Para qué sirve tenerla completa: cuando el operador llama por radio no dice
//  un código, dice "se puso negro el cuadro de arriba a la izquierda de la
//  pantalla 2". Con esta cadena eso se traduce solo a una cámara concreta,
//  su canal y la antena de la que cuelga.
// =====================================================================
model AssetDecoder {
  assetId      String  @id
  asset        Asset   @relation(fields: [assetId], references: [id], onDelete: Cascade)
  /// Cuántas salidas de video tiene el equipo.
  outputCount  Int?
  /// De qué grabador consume el video.
  sourceNvrId  String?
  mgmtIp       String?
  outputs      DecoderOutput[]

  @@map("asset_decoders")
}

model DecoderOutput {
  id            String          @id @default(uuid())
  decoderAssetId String
  decoder       AssetDecoder    @relation(fields: [decoderAssetId], references: [assetId], onDelete: Cascade)
  /// Número de salida física (1, 2, 3…).
  number        Int
  type          VideoOutputType @default(HDMI)
  /// A qué pantalla alimenta esta salida.
  screenAssetId String?
  screen        AssetScreen?    @relation(fields: [screenAssetId], references: [assetId])

  @@unique([decoderAssetId, number])
  @@map("decoder_outputs")
}

// =====================================================================
//  PANTALLA DEL PÚLPITO (Bloque 2)
//
//  Es un ACTIVO propio y no un campo del decodificador: una pantalla se
//  quema, se raya y pierde brillo. Eso genera su propia orden de
//  mantenimiento, su historial y su garantía. Como texto dentro del
//  decodificador no se podría abrir una OM por "Pantalla 2 quemada".
// =====================================================================
model AssetScreen {
  assetId    String        @id
  asset      Asset         @relation(fields: [assetId], references: [id], onDelete: Cascade)
  /// Rótulo con el que la llaman en el púlpito: "Pantalla 1", "Pantalla 2".
  label      String?
  sizeInch   Float?
  layout     ScreenLayout?
  /// De dónde recibe la señal. En varios púlpitos la maneja el PC con
  /// iVMS-4200 y no un decodificador: si no se contemplan los dos casos, la
  /// mitad de los púlpitos no se puede registrar.
  sourceKind ScreenSource?
  sourcePcAssetId String?

  fedByOutputs DecoderOutput[]
  cells        ScreenCell[]

  @@map("asset_screens")
}

/// Qué cámara se ve en cada cuadro de la pantalla.
/// Es lo que traduce "el cuadro de arriba a la izquierda" a un equipo real.
model ScreenCell {
  id            String       @id @default(uuid())
  screenAssetId String
  screen        AssetScreen  @relation(fields: [screenAssetId], references: [assetId], onDelete: Cascade)
  /// Posición en la rejilla, empezando en 1 arriba a la izquierda.
  position      Int
  cameraAssetId String?
  camera        Asset?       @relation("ScreenCellCamera", fields: [cameraAssetId], references: [id])

  @@unique([screenAssetId, position])
  @@map("screen_cells")
}

// =====================================================================
//  PC DEL PÚLPITO (Bloque 2)
//  Estación con iVMS-4200. En varios púlpitos es la que pinta las pantallas.
// =====================================================================
model AssetPc {
  assetId        String  @id
  asset          Asset   @relation(fields: [assetId], references: [id], onDelete: Cascade)
  hostname       String?
  os             String?
  ivmsVersion    String?
  /// Cuántas salidas de video tiene, para saber cuántas pantallas maneja.
  videoOutputs   Int?
  /// Qué grabadores tiene configurados, en texto: es lo que se pierde cuando
  /// se reinstala el equipo y nadie recuerda qué tenía.
  nvrsConfigured String?

  @@map("asset_pcs")
}

model Vlan {
  id        String        @id @default(uuid())
  number    Int           @unique
  name      String
  subnet    String?       // CIDR
  role      String?       // tren / nvr / gestion / visualizacion / industrial
  cameras   AssetCamera[]

  @@map("vlans")
}

model SwitchPort {
  id               String        @id @default(uuid())
  switchId         String
  switchAsset      Asset         @relation("PortSwitch", fields: [switchId], references: [id], onDelete: Cascade)
  assetSwitchId    String?
  assetSwitch      AssetSwitch?  @relation(fields: [assetSwitchId], references: [assetId])
  portNumber       Int
  poe              Boolean       @default(false)
  vlanNumber       Int?
  connectedAssetId String?       @unique
  connectedAsset   Asset?        @relation("PortConnectedAsset", fields: [connectedAssetId], references: [id])

  cameraLink       AssetCamera?
  wirelessLink     AssetWireless?
  /// Cámaras que este puerto ALIMENTA por PoE. Es distinto de cameraLink:
  /// una cámara puede recibir datos por antena y energía por este puerto.
  poweredCameras   AssetCamera[] @relation("CameraPoeSource")

  @@unique([switchId, portNumber])
  @@map("switch_ports")
}

enum LinkMedium {
  FIBRA
  COBRE
  INALAMBRICO
}

model NetworkLink {
  id         String     @id @default(uuid())
  medium     LinkMedium
  endpointAId String
  endpointA  Asset      @relation("LinkEndpointA", fields: [endpointAId], references: [id], onDelete: Cascade)
  endpointBId String
  endpointB  Asset      @relation("LinkEndpointB", fields: [endpointBId], references: [id], onDelete: Cascade)
  isRing     Boolean    @default(false) // tramo del anillo de fibra del core
  description String?

  @@map("network_links")
}

// =====================================================================
//  CREDENCIALES CIFRADAS (soporte a seguridad y reposición rápida)
// =====================================================================

model Credential {
  id        String   @id @default(uuid())
  assetId   String
  asset     Asset    @relation(fields: [assetId], references: [id], onDelete: Cascade)
  username  String
  secretEnc String   // cifrado AES a nivel de aplicación
  type      String?  // admin, viewer, rtsp
  createdAt DateTime @default(now())

  @@map("credentials")
}

// =====================================================================
//  MANTENIMIENTO (Módulo 4)
// =====================================================================

enum WorkOrderType {
  PREVENTIVO
  CORRECTIVO
  MEJORA
  PREDICTIVO  // anticipado por condición (curva P-F): señal, recurrencia, desgaste
  /// Levantamiento de activos en campo. El mapeo TAMBIÉN es una orden de
  /// trabajo: se recibe, se asigna, se ejecuta y se cierra con informe.
  /// Va al final del enum porque PostgreSQL añade los valores nuevos al final.
  MAPEO
}

/// Por dónde llegó el pedido de Producción.
/// Hoy llega por WhatsApp al ingeniero y de ahí se pasa de boca: al registrar
/// la vía queda constancia de cómo entró y deja de perderse.
enum RequestChannel {
  SAP        // orden creada en SAP por Producción
  WHATSAPP   // mensaje al ingeniero
  RADIO      // pedido por radio desde el púlpito
  CORREO
  VERBAL     // en persona
  SISTEMA    // generada por el propio SGIT (preventivo automático)
}

/// Causa encontrada al cerrar la orden.
/// Es una LISTA y no texto libre porque el técnico cierra contra el reloj de
/// la parada: con texto libre se escribe "se solucionó" y el dato no sirve
/// para detectar por qué algo vuelve a fallar.
enum RootCause {
  ENERGIA_CORTE          // corte o falla eléctrica
  FUENTE_POE             // inyector / fuente PoE
  CABLE_DANADO           // cable cortado, aplastado, quemado
  CABLE_FUERA_NORMA      // tramo por encima de los 90 m
  CONECTOR                // RJ45 / empalme / conector mal ponchado
  EQUIPO_QUEMADO
  EQUIPO_FIN_VIDA        // desgaste, ya no da más
  PUERTO_SWITCH          // puerto del switch en falla
  ENLACE_INALAMBRICO     // antena / enlace PMP degradado
  SATURACION_NVR         // sesiones agotadas
  DISCO_NVR
  CONFIGURACION          // configuración incorrecta
  FIRMWARE
  AMBIENTAL              // polvo, calor, humedad, escoria, vibración
  GOLPE_VANDALISMO
  /// El técnico fue, revisó y NO encontró falla. Es un dato valioso, no un
  /// fracaso: varias órdenes seguidas así sobre el mismo equipo apuntan a una
  /// falla intermitente (cable largo, interferencia) que nadie está viendo.
  SIN_FALLA_ENCONTRADA
  OTRO
}

enum WorkOrderStatus {
  ABIERTA
  EN_PROCESO
  EN_ESPERA
  CERRADA
  CANCELADA
}

model WorkOrder {
  id           String          @id @default(uuid())
  code         String          @unique // ej: OT-2026-0001
  /// OPCIONAL desde el Bloque 1. Una orden de MAPEO cubre una ZONA, no un
  /// activo: el técnico va al lecho de enfriamiento y registra 12 cámaras.
  /// Lo mismo con un corte de energía que deja media sala sin visión.
  assetId      String?
  asset        Asset?          @relation(fields: [assetId], references: [id])
  /// Alcance por ubicación, para las órdenes que no son de un solo equipo.
  locationId   String?
  location     Location?       @relation(fields: [locationId], references: [id])
  type         WorkOrderType
  status       WorkOrderStatus @default(ABIERTA)
  technicianId String?
  technician   User?           @relation("AssignedTechnician", fields: [technicianId], references: [id])
  scheduledDate DateTime?
  executedDate  DateTime?
  activity     String?
  diagnosis    String?
  responsible  String?         // responsable de la OM
  materials    String?         // materiales usados / a usar (uno por línea)
  spareParts   Json?
  condition    Json?           // checklist de condición del preventivo (limpieza, cableado, etc.)
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  /// REFERENCIA DEL SITIO en esta orden concreta, en texto libre.
  /// No se retira: complementa a `locationId`. La ubicación dice DÓNDE de
  /// forma estructurada; esto recoge el detalle que el técnico anota ese día
  /// ("columna 14, junto a la escalera norte, poste de la izquierda").
  zone         String?
  incidentId   String?         // incidencia que originó la OM (opcional)
  incident     Incident?          @relation(fields: [incidentId], references: [id])
  evidences    WorkOrderEvidence[]
  inspeccionesGrua InspeccionGrua[] @relation("InspeccionGruaWo")

  // ---- RECEPCIÓN (Bloque 1) ----
  // Producción crea la orden en SAP y la manda por WhatsApp al ingeniero, que
  // la pasa de boca. Aquí queda por escrito quién la pidió y por dónde entró.
  requestedBy    String?          // nombre de quien la solicitó (Producción)
  requestChannel RequestChannel?  // por dónde llegó
  receivedAt     DateTime?        // cuándo se recibió
  externalRef    String?          // número de la orden en SAP, si lo tiene

  // ---- PARADA Y EJECUCIÓN (Bloque 1) ----
  /// Hora de parada ESTIMADA por Producción al crear la orden. Es tentativa:
  /// cambia según la producción del turno.
  plannedStopAt DateTime?
  /// Cuánto estima Producción que dura la parada, en minutos. Junto con las
  /// horas reales permite medir la DESVIACIÓN de lo planificado.
  plannedDurationMin Int?
  /// Horas REALES. Las pone el técnico ya en campo, después de confirmar por
  /// radio con Producción a qué hora se detiene de verdad.
  startedAt     DateTime?
  endedAt       DateTime?
  /// Quién abrió y quién cerró la orden (firma electrónica verificada).
  openedById    String?
  openedBy      User?            @relation("WoOpenedBy", fields: [openedById], references: [id])
  closedById    String?
  closedBy      User?            @relation("WoClosedBy", fields: [closedById], references: [id])
  /// Acompañante en campo. En planta van dos: el técnico de red registra y el
  /// técnico eléctrico acompaña. Queda declarado para trazabilidad y SSOMA.
  companionId   String?
  companion     User?            @relation("WoCompanion", fields: [companionId], references: [id])

  // ---- CIERRE (Bloque 1) ----
  rootCause     RootCause?       // causa encontrada — enum LEGADO, ver nota
  /// CÓDIGO de causa del catálogo editable (3E). Es la fuente de verdad de
  /// aquí en adelante.
  ///
  /// POR QUÉ CONVIVEN LOS DOS
  /// Las órdenes cerradas antes de 3E guardaron el valor en el enum. Borrarlo
  /// las dejaría sin causa. Las 17 opciones del catálogo tienen exactamente
  /// los mismos códigos, así que al cerrar se escriben AMBOS cuando el código
  /// elegido existe en el enum; una causa nueva creada por el usuario solo
  /// puede ir aquí. Al leer: rootCauseCode ?? rootCause.
  rootCauseCode String?
  rootCauseNote String?          // observación libre, ahora OPCIONAL y corta
  /// Qué vio el técnico ANTES de intervenir. Del catálogo SINTOMA.
  /// Separado de la causa a propósito: el síntoma es lo que se observa y la
  /// causa lo que se descubre. Confundirlos es lo que hace que "no hay imagen"
  /// figure como causa de 40 órdenes sin que nadie sepa por qué.
  symptomCode   String?
  /// Qué hizo. Del catálogo ACCION.
  actionCode    String?
  isRecurrent   Boolean          @default(false) // el técnico marca si ya había pasado

  // ---- AVANCE (Bloque 1) ----
  /// Porcentaje de avance declarado, 0 a 100.
  /// Una orden no siempre se termina el mismo día: la parada se acorta, falta
  /// el manlift, no llega el repuesto. En vez de forzar el cierre, la orden
  /// queda EN PROCESO con su avance a la vista del Jefe de Mantenimiento.
  /// Se guarda aquí, además del historial, para poder listar sin consultas extra.
  progressPct   Int              @default(0)

  // ---- Asignar y detallar (4A) ----
  //
  //  EL MODELO: el ingeniero ASIGNA (qué, sobre qué, a quién, para cuándo) y
  //  el técnico de red DETALLA (equipo exacto, materiales, herramientas). El
  //  ingeniero no sabe cuál cámara ni qué tramo; obligarle a rellenarlo le
  //  hace inventar datos que después alguien corrige.
  //
  //  NO se añade un estado nuevo al enum: en PostgreSQL los valores solo se
  //  pueden añadir AL FINAL, y meter ASIGNADA antes de ABIERTA obligaría a
  //  recrear el tipo con todo lo que cuelga. Con la marca de detallado el
  //  flujo se lee igual y la migración es aditiva.
  /// Quién asignó el trabajo. Es OTRA persona que quien lo detalla y otra que
  /// quien lo ejecuta: separarlos es lo que permite saber quién pidió qué.
  assignedById  String?
  assignedBy    User?            @relation("WoAssignedBy", fields: [assignedById], references: [id])
  /// Equipo que el ingeniero indicó al asignar. Se guarda aparte de assetId
  /// para poder ver QUÉ SE PIDIÓ frente a QUÉ SE HIZO.
  assignedAssetId String?
  /// Cuándo y quién la dejó lista para trabajar.
  detailedAt    DateTime?
  detailedById  String?
  detailedBy    User?            @relation("WoDetailedBy", fields: [detailedById], references: [id])
  /// El técnico cambió el equipo respecto a lo asignado. No se impide: si
  /// llega y ve que el problema es el switch, arreglar la cámara no sirve.
  /// Pero queda marcado para que el ingeniero lo vea.
  scopeChanged  Boolean          @default(false)
  scopeNote     String?
  progress      WorkOrderProgress[]

  /// Activos levantados durante esta orden (solo aplica a las de tipo MAPEO).
  mappedAssets  Asset[]          @relation("AssetMappedInWo")
  // ---- Preparación y consumo (Bloque 2f) ----
  tools         WorkOrderTool[]
  materialItems WorkOrderMaterial[]
  checklist     WorkOrderChecklist[]
  swaps         WorkOrderSwap[]

  /// Ventana de parada en la que se va a hacer. OPCIONAL: hay trabajo que no
  /// necesita que el tren pare (púlpito, oficina, sala de control).
  paradaId      String?
  parada        VentanaParada?  @relation(fields: [paradaId], references: [id])
  /// Instalaciones que se ejecutan con esta orden. Lado inverso obligatorio:
  /// Prisma exige el campo en AMBOS modelos aunque sólo uno lleve la clave.
  instalaciones Instalacion[]
  // ---- Bloque 29: lo que salió de esta orden ----
  mejorasPropuestas MejoraProcedimiento[] @relation("MejoraDesdeOm")
  notasDeCampo      NotaDeCampo[]         @relation("NotaDesdeOm")


  @@index([assetId])
  @@index([locationId])
  @@index([status])
  @@index([incidentId])
  @@index([type, status])
    /// Existe en la base desde 4A. Declararlo aquí es lo que evita que la
  /// CI lo vea como un índice "de más" en cada comprobación.
  @@index([detailedAt])
  @@index([rootCauseCode])
  @@index([paradaId])
  @@map("work_orders")
}

// =====================================================================
//  AVANCE DE LA ORDEN (Bloque 1)
//
//  Es un HISTORIAL, no un solo número. Para el Jefe de Mantenimiento la
//  justificación no es "quedó al 60%", sino la secuencia:
//    29/07  30%  "la parada se acortó, Producción reinició antes"
//    30/07  60%  "faltó manlift, no se alcanzó la cámara del lecho"
//    31/07 100%  "terminado"
//  Esa cadena es la que responde por qué un trabajo tomó tres paradas.
// =====================================================================
model WorkOrderProgress {
  id           String    @id @default(uuid())
  workOrderId  String
  workOrder    WorkOrder @relation(fields: [workOrderId], references: [id], onDelete: Cascade)
  /// Avance acumulado declarado en este reporte (0-100).
  pct          Int
  /// Por qué no se avanzó más, ELEGIDO de la lista (catálogo MOTIVO_AVANCE).
  /// Escrito a mano no se podía contar: ahora se puede saber cuántas paradas
  /// se pierden por falta de repuesto y cuántas por falta de manlift.
  reasonCode   String?
  /// Detalle libre, opcional. La válvula de escape para lo que la lista no
  /// prevé — y la señal de que a la lista le falta una opción.
  note         String?
  reportedById String?
  reportedBy   User?     @relation("WoProgressBy", fields: [reportedById], references: [id])
  reportedAt   DateTime  @default(now())

  @@index([workOrderId])
  @@map("work_order_progress")
}

model WorkOrderEvidence {
  id          String    @id @default(uuid())
  workOrderId String
  workOrder   WorkOrder @relation(fields: [workOrderId], references: [id], onDelete: Cascade)
  fileId      String    // referencia a objeto en MinIO
  caption     String?
  createdAt   DateTime  @default(now())

  @@map("work_order_evidences")
}

// =====================================================================
//  INCIDENCIAS (Módulo 5) + soporte a troubleshooting (Módulo 7)
// =====================================================================

enum Priority {
  BAJA
  MEDIA
  ALTA
  CRITICA
}

enum IncidentStatus {
  ABIERTA
  EN_DIAGNOSTICO
  EN_PROCESO
  EN_ESPERA        // el técnico la deja en espera (a la espera de repuesto/manlift/decisión)
  RESUELTA
  CERRADA
}

enum IncidentCategory {
  GENERAL
  SATURACION_SESIONES_NVR   // "NO MORE USER CAN BE CONNECTED"
  CAIDA_ENLACE_INALAMBRICO  // enlace PMP/Ubiquiti inestable
  FALLA_ALMACENAMIENTO_NVR
  DECODER_VIDEOWALL
  CAMARA_SIN_IMAGEN
  RED
  // ---- Categorías específicas de planta siderúrgica (F5) ----
  CORTE_ENERGIA             // corte / falla eléctrica que deja sin servicio equipos CCTV
  FALLA_GABINETE            // gabinete: temperatura, ventilación, humedad, daño físico
  FALLA_FUENTE_POE          // fuente / inyector / switch PoE que no energiza la cámara
  FALLA_SWITCH              // switch o puerto (core anillo / distribución / acceso)
  FALLA_FIBRA               // enlace de fibra / tramo del anillo dañado o degradado
  FALLA_UPS                 // respaldo de energía (UPS) agotado o en falla
  PERDIDA_CONECTIVIDAD      // pérdida de IP / VLAN / ping al equipo
  FALLA_NVR                 // NVR general (reinicios, cuelgue, no graba)
  AMBIENTAL_SIDERURGICO     // polvo, calor, escoria, vibración, agua propios de la planta
  SEGURIDAD_FISICA          // vandalismo, robo, golpe o corte de cable
  CONFIGURACION_FIRMWARE    // config incorrecta / firmware / actualización fallida
  // ---- Fallas ELÉCTRICAS específicas (planta siderúrgica) ----
  TABLERO_ELECTRICO         // tablero, breaker, llave térmica, borneras
  VARIACION_TENSION         // caída/pico de tensión, fluctuación por carga del horno
  PUESTA_A_TIERRA           // falla o ausencia de puesta a tierra
  CORTOCIRCUITO             // cortocircuito en el ramal o el equipo
  SOBRECARGA                // circuito sobrecargado
  CABLEADO_ELECTRICO        // cable eléctrico dañado, quemado o mal empalmado
  TRANSFORMADOR             // falla en transformador / fuente de alimentación mayor
}

model Incident {
  id              String           @id @default(uuid())
  code            String           @unique // ej: INC-2026-0001 / IT-CCTV-GRU-...
  title           String
  description     String?
  category        IncidentCategory @default(GENERAL)
  priority        Priority         @default(MEDIA)
  status          IncidentStatus   @default(ABIERTA)
  assetId         String?
  asset           Asset?           @relation(fields: [assetId], references: [id])
  responsibleId   String?
  responsible     User?            @relation("IncidentResponsible", fields: [responsibleId], references: [id])
  rootCause       String?
  concurrentSessions Int?          // sesiones en NVR al momento de la falla
  affectedCameras Int?             // cámaras aguas abajo afectadas
  reportedAt      DateTime         @default(now())
  resolvedAt      DateTime?
  visionDownMin   Int?             // minutos sin visión (impacto en producción)
  mttrMinutes     Int?             // tiempo de resolución calculado
  zone            String?          // área/zona en planta (Horno, Laminación, Púlpito...)
  solution        String?          // qué se hizo para resolver
  materials       String?          // materiales utilizados
  interveners     String?          // técnicos que intervinieron
  responsibleName String?          // responsable de la solución
  observations    String?          // observaciones / recomendaciones
  lineManagerNotified Boolean @default(false) // ¿jefe de línea enterado?
  // ---- Propuesta técnica de solución (documentación previa al cierre) ----
  // El ERP no solo registra la falla: deja constancia de QUÉ se propone hacer,
  // qué se necesita y qué pasa si no se atiende. Sirve para sustentar ante Jefatura.
  proposal        String?          // propuesta de solución planteada por el técnico
  proposalCost    String?          // materiales / recursos que demanda
  proposalRisk    String?          // riesgo o consecuencia de no atenderla
  requiresThirdParty Boolean @default(false) // requiere apoyo de terceros (eléctrica, contratista)

  // ---- Quién avisó y por qué vía (bloque 51-B) ----
  /// Por dónde entró el aviso. Saberlo cambia cómo se lee el dato: una
  /// incidencia abierta por Producción es una persona que se quedó sin ver;
  /// una abierta por el monitoreo puede ser un equipo que ni se usaba.
  canalOrigen     CanalOrigen      @default(SISTEMA)
  /// Quién LEVANTÓ el aviso. No es el responsable de resolverlo.
  reportedById    String?
  reportedBy      User?            @relation("IncidentReporter", fields: [reportedById], references: [id])
  /// La cámara se había dado por reparada y volvió a caer dentro de las 24 h.
  /// Es una reparación fallida y se cuenta como tal.
  reaparecio      Boolean          @default(false)

  workOrders      WorkOrder[]        // OM generadas a partir de esta incidencia
  evidences       IncidentEvidence[] // fotografías de campo
  avisos          IncidentAviso[]    // los reportes repetidos del mismo problema

  @@index([assetId])
  @@index([status])
  @@index([category])
  @@index([reportedById])
  @@index([canalOrigen])
  @@map("incidents")
}

/// Por dónde entró el aviso de la incidencia (bloque 51-B).
enum CanalOrigen {
  PRODUCCION  // el púlpito: alguien de la línea se quedó sin ver
  TECNICO     // el técnico de red lo detectó en ronda o en pantalla
  MONITOREO   // lo levantó el agente de monitoreo automático
  SISTEMA     // origen no declarado (todo lo anterior al bloque 51-B)
}

/// UN AVISO SUMADO A UNA INCIDENCIA QUE YA ESTABA ABIERTA (bloque 51-B).
///
/// Cinco personas del púlpito viendo la misma cámara apagada son UN incidente,
/// no cinco. Pero son cinco personas sin ver, y ese número no existía en
/// ninguna parte. Cada fila de aquí es una de ellas.
///
/// La restricción única sobre (incidencia, persona) es a propósito: en el
/// púlpito, con el celular y mala señal, tocar «enviar» dos veces es lo normal.
/// Sin ella el contador de impacto mentiría hacia arriba.
model IncidentAviso {
  id          String   @id @default(uuid())
  incidentId  String
  incident    Incident @relation(fields: [incidentId], references: [id], onDelete: Cascade)
  userId      String
  user        User     @relation(fields: [userId], references: [id])
  /// La zona que escribió quien avisó, si la escribió. Opcional siempre.
  zona        String?
  /// Foto del púlpito, si la subió. Opcional siempre.
  fileId      String?
  createdAt   DateTime @default(now())

  @@unique([incidentId, userId])
  @@index([incidentId])
  @@index([userId])
  @@map("incident_avisos")
}

// =====================================================================
//  DOCUMENTACIÓN TÉCNICA (Módulo 6)
// =====================================================================

enum DocumentCategory {
  MANUAL
  DIAGRAMA
  PLANO
  FOTO
  CONFIG
  BACKUP
}

model Document {
  id         String           @id @default(uuid())
  title      String
  category   DocumentCategory
  fileId     String           // objeto en MinIO
  version    Int              @default(1)
  assetId    String?
  asset      Asset?           @relation(fields: [assetId], references: [id])
  locationId String?
  location   Location?        @relation(fields: [locationId], references: [id])
  uploadedBy String?
  createdAt  DateTime         @default(now())

  @@index([assetId])
  @@index([locationId])
  @@map("documents")
}

// =====================================================================
//  AUDITORÍA E HISTORIAL (transversal)

// =====================================================================
//  HERRAMIENTAS (Bloque 2f)
//
//  UNA HERRAMIENTA NO ES UN REPUESTO.
//  El engrimpador no se consume: se lleva y se devuelve. Modelarlo como stock
//  sería un error porque el stock nunca bajaría y el dato no diría nada.
//
//  Se modela como VERIFICACIÓN al abrir la orden: el sistema sugiere las
//  herramientas según el tipo de trabajo y el técnico confirma cuáles lleva.
//  Queda registrado y el Jefe de Mantenimiento lo ve: si el técnico salió sin
//  el engrimpador y la orden se cerró sin resolver, ahí está la explicación.
// =====================================================================
model Tool {
  id           String          @id @default(uuid())
  code         String?         @unique
  name         String
  /// Familia: Red, Eléctrica, Medición, Altura, Seguridad.
  category     String?
  /// Tipos de orden donde se SUGIERE llevarla. Vacío = se sugiere en todas.
  /// Una orden de mapeo necesita metrajo y etiquetas; una correctiva de red,
  /// engrimpador y probador. Sugerir todo en todas haría que nadie lea la lista.
  suggestedFor WorkOrderType[]
  active       Boolean         @default(true)
  notes        String?
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  checks       WorkOrderTool[]

  @@map("tools")
}

/// Qué herramientas declaró llevar el técnico al abrir la orden.
model WorkOrderTool {
  id          String    @id @default(uuid())
  workOrderId String
  workOrder   WorkOrder @relation(fields: [workOrderId], references: [id], onDelete: Cascade)
  toolId      String
  tool        Tool      @relation(fields: [toolId], references: [id], onDelete: Cascade)
  /// true = la lleva · false = declaró que NO la tiene.
  /// Se guarda el "no" a propósito: es el dato que explica un viaje perdido.
  carried     Boolean   @default(false)
  note        String?

  @@unique([workOrderId, toolId])
  @@index([workOrderId])
  @@map("work_order_tools")
}

// =====================================================================
//  MATERIALES DE LA ORDEN (Bloque 2f)
//
//  POR QUÉ NO SE DESCUENTA STOCK AUTOMÁTICAMENTE
//  El almacén de verdad está en SAP. Si este sistema descontara por su cuenta
//  y SAP también, ninguno de los dos cuadraría nunca. Aquí se registra qué se
//  PREVIÓ y qué se USÓ en cada orden; el catálogo local se actualiza subiendo
//  la exportación de SAP y sirve para comparar, no para reemplazarlo.
// =====================================================================
/// Estado de una LÍNEA de material dentro de la orden.
/// El flujo real de planta: el técnico lista lo que necesita con su código SAP,
/// el ingeniero lo autoriza y sale de almacén, y lo que sobra VUELVE.
/// Sin el último paso el almacén miente y en tres meses nadie se fía del stock.
enum MaterialStatus {
  SOLICITADO  // el técnico lo pidió; todavía no salió de almacén
  RETIRADO    // el ingeniero firmó y se descontó del stock
  DEVUELTO    // sobró y volvió al almacén
  RECHAZADO   // el ingeniero no lo autoriza, con motivo
}

/// Tipo de catálogo editable (bloque 3E).
///
/// POR QUÉ ESTO NO ES UN ENUM MÁS
/// Las causas de cierre vivían en el enum RootCause, con 17 valores fijos en
/// el código. Añadir una exigía migración y despliegue, y en PostgreSQL los
/// valores de un enum solo se pueden añadir al final. Eso significa que la
/// gente de planta no podía nombrar lo que ve sin pedírselo a un programador.
///
/// Es el mismo error que cometí inventando las etapas del proceso. Aquí no se
/// repite: son filas, y las edita quien sabe cómo se llaman las cosas.
enum CatalogKind {
  CAUSA          // por qué falló — sustituye al enum RootCause
  SINTOMA        // qué vio el técnico antes de intervenir
  ACCION         // qué hizo
  MOTIVO_AVANCE  // por qué no se avanzó más de lo declarado
}

/// Una entrada de catálogo. Cuatro listas distintas en una sola tabla porque
/// se comportan igual: código, nombre, grupo y orden. Cuatro tablas iguales
/// serían cuatro CRUD iguales que se desviarían con el tiempo.
model CatalogItem {
  id        String      @id @default(uuid())
  kind      CatalogKind
  /// Código estable. Es lo que se guarda en la orden: si mañana se corrige la
  /// redacción del nombre, el histórico no cambia de significado.
  code      String
  name      String
  /// Familia para agrupar el desplegable. Con 17 opciones en una lista plana,
  /// dentro de un teléfono y con la parada corriendo, el técnico elige la
  /// primera que ve. Agrupadas se encuentran.
  group     String?
  sequence  Int         @default(0)
  /// Se desactiva en vez de borrarse: las órdenes viejas que la usaron tienen
  /// que seguir mostrando qué se eligió.
  active    Boolean     @default(true)
  notes     String?
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  @@unique([kind, code])
  @@index([kind, active])
  @@map("catalog_items")
}

/// Resultado de un punto de la rutina preventiva.
enum ChecklistResult {
  OK
  NO_OK
  NO_APLICA
}

/// RUTINA PREVENTIVA POR TIPO DE ACTIVO (bloque 3F-2).
///
/// POR QUÉ POR TIPO DE ACTIVO Y NO UNA SOLA
/// Una cámara, un grabador y una antena no se mantienen igual. La cámara lleva
/// limpieza de lente, sello y fijación; el grabador lleva discos, ventilación y
/// sesiones; la antena, alineación y tensado. Una lista única obligaría al
/// técnico a ir descartando lo que no toca, que es justo el trabajo mental que
/// queremos quitarle.
///
/// LO QUE HAY DENTRO NO LO ESCRIBO YO. La plantilla nace vacía y la llenan
/// ustedes: yo no sé qué se revisa en una cámara del Tren 2.
model ChecklistTemplate {
  id        String    @id @default(uuid())
  /// Una rutina por tipo de activo. Única: dos rutinas para cámaras acabarían
  /// divergiendo y nadie sabría cuál es la buena.
  assetType AssetType @unique
  name      String
  active    Boolean   @default(true)
  items     ChecklistItem[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@map("checklist_templates")
}

model ChecklistItem {
  id         String            @id @default(uuid())
  templateId String
  template   ChecklistTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  /// Lo que el técnico tiene que comprobar, en imperativo y sin ambigüedad.
  /// "Limpiar el lente y comprobar imagen en el púlpito", no "revisar cámara".
  text       String
  /// Ayuda opcional: cómo se hace o con qué. Se enseña bajo el punto.
  help       String?
  sequence   Int               @default(0)
  /// Si este punto sale NO OK, el sistema PROPONE un correctivo. Se marca solo
  /// en lo que de verdad deja el equipo comprometido: no todo hallazgo es una
  /// orden nueva, y llenar el tablero de órdenes que nadie pidió lo vuelve
  /// papel mojado.
  critical   Boolean           @default(false)
  active     Boolean           @default(true)
  answers    WorkOrderChecklist[]
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt

  @@index([templateId, active])
  @@map("checklist_items")
}

/// Lo que el técnico respondió en UNA orden concreta.
model WorkOrderChecklist {
  id          String          @id @default(uuid())
  workOrderId String
  workOrder   WorkOrder       @relation(fields: [workOrderId], references: [id], onDelete: Cascade)
  itemId      String
  item        ChecklistItem   @relation(fields: [itemId], references: [id], onDelete: Cascade)
  result      ChecklistResult
  /// Detalle solo cuando hace falta: obligatorio si el punto sale NO OK.
  /// Un "no conforme" sin explicación no sirve para nada.
  note        String?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  /// Una respuesta por punto y orden: volver a responder ACTUALIZA, no duplica.
  @@unique([workOrderId, itemId])
  @@index([workOrderId])
  @@map("work_order_checklist")
}

model WorkOrderMaterial {
  id          String     @id @default(uuid())
  workOrderId String
  workOrder   WorkOrder  @relation(fields: [workOrderId], references: [id], onDelete: Cascade)
  /// Repuesto del catálogo, si está catalogado.
  sparePartId String?
  sparePart   SparePart? @relation(fields: [sparePartId], references: [id])
  /// Código SAP copiado al momento del registro. Se guarda aquí a propósito:
  /// si el catálogo cambia después, el histórico de la orden no se altera.
  sapCode     String?
  /// Descripción libre, para lo que no esté catalogado. Siempre se llena.
  description String
  unit        String?
  /// Cantidad PREVISTA al preparar el trabajo.
  plannedQty  Float?
  /// Cantidad REALMENTE usada, al cerrar. La diferencia entre las dos es lo
  /// que dice si se está estimando bien.
  usedQty     Float?

  // ---- Retiro de almacén (3D) ----
  status         MaterialStatus @default(SOLICITADO)
  /// Cantidad que SALIÓ de almacén. Puede no coincidir con lo previsto: el
  /// ingeniero entrega lo que hay, no lo que se pidió.
  withdrawnQty   Float?
  /// Cantidad que VOLVIÓ. Se guarda, no se recalcula: el dato tiene que quedar.
  returnedQty    Float?
  /// Movimiento de stock del retiro. Es el hilo que une la orden con el
  /// almacén: sin él, "se retiró" sería una afirmación sin respaldo.
  movementId     String?
  movement       StockMovement? @relation("MaterialRetiro", fields: [movementId], references: [id])
  /// Movimiento de la devolución, si la hubo.
  returnMovementId String?
  returnMovement   StockMovement? @relation("MaterialDevolucion", fields: [returnMovementId], references: [id])
  /// Quién firmó el retiro y cuándo. El ingeniero, no el técnico.
  withdrawnById  String?
  withdrawnBy    User?          @relation("MaterialRetiradoPor", fields: [withdrawnById], references: [id])
  withdrawnAt    DateTime?
  /// Motivo del rechazo. Obligatorio al rechazar: un "no" sin explicación hace
  /// que el técnico vuelva a pedir lo mismo la semana siguiente.
  rejectedReason String?

  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@index([workOrderId])
  @@index([sparePartId])
  // Estos dos los crea la migracion 20260802000000 y hay que DECLARARLOS aquí:
  // si el esquema no los nombra, la comprobación de desfase del CI entiende que
  // sobran en la base y falla. Fue un descuido mío y el CI lo cazó.
  // Por estado, porque la consulta que se hará mil veces es "qué hay pendiente
  // de retirar", no "dame todas las líneas".
  @@index([status])
  @@index([movementId])
  @@map("work_order_materials")
}

// =====================================================================
//  REEMPLAZO DE EQUIPO (Bloque 2f)
//
//  Cuando se cambia una cámara o una antena, lo que ocurre es un intercambio:
//  sale una y entra otra que estaba en almacén. Registrarlo permite saber a
//  dónde fue cada equipo de repuesto, algo que hoy se pierde por completo.
//
//  El sistema ya tiene el estado STOCK para activos: esta tabla cierra la
//  cadena  STOCK -> asignado a la orden -> instalado -> OPERATIVO.
// =====================================================================
model WorkOrderSwap {
  id               String    @id @default(uuid())
  workOrderId      String
  workOrder        WorkOrder @relation(fields: [workOrderId], references: [id], onDelete: Cascade)
  /// Equipo retirado. Pasa a BAJA o a STOCK según su estado.
  removedAssetId   String?
  removedAsset     Asset?    @relation("SwapRemoved", fields: [removedAssetId], references: [id])
  /// Equipo instalado. Venía de STOCK y pasa a OPERATIVO en la ubicación.
  installedAssetId String?
  installedAsset   Asset?    @relation("SwapInstalled", fields: [installedAssetId], references: [id])
  note             String?
  createdAt        DateTime  @default(now())

  @@index([workOrderId])
  @@map("work_order_swaps")
}

// =====================================================================

model AuditLog {
  id        String   @id @default(uuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id])
  action    String   // CREATE / UPDATE / DELETE / LOGIN / ...
  entity    String
  entityId  String?
  before    Json?
  after     Json?
  ip        String?
  /// Navegador y sistema, resumidos: "Chrome en Windows".
  dispositivo   String?
  /// Identificador del aparato que manda el navegador. Sobrevive al cambio de IP.
  dispositivoId String?
  /// Nombre del equipo conocido AL QUE CORRESPONDÍA LA IP ESE DÍA.
  /// Copiado, no enlazado: si el registro se edita o se borra, el histórico
  /// tiene que seguir diciendo lo mismo.
  origen        String?
  createdAt DateTime @default(now())

  @@index([entity, entityId])
  @@index([dispositivoId])
  @@index([createdAt])
  @@map("audit_logs")
}

model AssetHistory {
  id         String   @id @default(uuid())
  assetId    String
  asset      Asset    @relation(fields: [assetId], references: [id], onDelete: Cascade)
  field      String
  oldValue   String?
  newValue   String?
  changedBy  String?
  createdAt  DateTime @default(now())

  @@index([assetId])
  @@map("asset_history")
}


// ===================== INVENTARIO / REPUESTOS (F3) =====================

enum MovementType {
  INGRESO   // entrada a almacén
  RETIRO    // salida (retiro por código SAP)
  AJUSTE    // corrección de stock
}

/// Repuesto de almacén. El código SAP es libre (para retirar del almacén) y
/// queda listo para sincronizar con SAP a futuro.
model SparePart {
  id            String   @id @default(uuid())
  sapCode       String?  // código SAP (libre)
  name          String
  description   String?
  category      String?  // ej: Fuente PoE, Cámara, Conector, Antena, Disco NVR
  brand         String?
  model         String?  // modelo compatible (compatibilidad por modelo)
  unit          String?  @default("unidad")
  warehouse     String?  // ubicación/almacén
  /// DECIMAL a propósito. El almacén no solo guarda unidades: el cable UTP se
  /// mide en METROS y se consume por tramos. Con enteros, retirar 12,5 m
  /// registraba 13 y devolver 5,2 acreditaba 5. Cada operación perdía décimas
  /// y en pocos meses el stock dejaba de parecerse al estante.
  currentStock  Float    @default(0)
  minStock      Float    @default(0)  // umbral mínimo (alerta)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  lastCheckedAt DateTime?             // última comprobación física

  assets        SparePartAsset[]
  movements     StockMovement[]
  woMaterials   WorkOrderMaterial[]
  checks        StockCheck[]

  @@index([sapCode])
  @@index([category])
  @@map("spare_parts")
}

/// Compatibilidad repuesto <-> activo específico (además del match por modelo).
model SparePartAsset {
  id          String    @id @default(uuid())
  sparePartId String
  sparePart   SparePart @relation(fields: [sparePartId], references: [id], onDelete: Cascade)
  assetId     String
  asset       Asset     @relation(fields: [assetId], references: [id], onDelete: Cascade)

  @@unique([sparePartId, assetId])
  @@index([assetId])
  @@map("spare_part_assets")
}

/// Movimiento de stock (ingreso/retiro/ajuste). El retiro lleva su código SAP.
model StockMovement {
  id          String       @id @default(uuid())
  sparePartId String
  sparePart   SparePart    @relation(fields: [sparePartId], references: [id], onDelete: Cascade)
  type        MovementType
  /// DECIMAL: ver la nota en SparePart.currentStock. Positivo siempre; el
  /// signo lo da el tipo de movimiento.
  quantity    Float
  sapCode     String?      // código SAP del retiro/ingreso
  reason      String?
  userId      String?
  user        User?        @relation(fields: [userId], references: [id])
  createdAt   DateTime     @default(now())

  // Lado inverso del retiro y la devolución de una línea de material (3D).
  materialRetiro     WorkOrderMaterial[] @relation("MaterialRetiro")
  materialDevolucion WorkOrderMaterial[] @relation("MaterialDevolucion")

  @@index([sparePartId])
  @@map("stock_movements")
}

/// Comprobación física periódica (control diario del almacén).
model StockCheck {
  id          String    @id @default(uuid())
  sparePartId String
  sparePart   SparePart @relation(fields: [sparePartId], references: [id], onDelete: Cascade)
  countedQty  Int       // cantidad física comprobada
  previousQty Int?      // stock que había antes de comprobar
  note        String?
  userId      String?
  user        User?     @relation(fields: [userId], references: [id])
  checkedAt   DateTime  @default(now())

  @@index([sparePartId])
  @@map("stock_checks")
}


// ===================== MANTENIMIENTO PREVENTIVO (F6.1) =====================

/// Plan de mantenimiento preventivo por activo.
/// El intervalo depende de la criticidad de la zona (3 meses críticas, 6 meses el resto),
/// editable por el Jefe. nextDueAt = lastServiceAt (o alta) + intervalo.
model PreventivePlan {
  id            String    @id @default(uuid())
  assetId       String    @unique
  asset         Asset     @relation(fields: [assetId], references: [id], onDelete: Cascade)
  intervalDays  Int       @default(60) // 30 días = zona crítica (suciedad), 60 = no crítica (editable)
  zoneCritical  Boolean   @default(false)
  lastServiceAt DateTime?
  nextDueAt     DateTime?
  active        Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([nextDueAt])
  @@index([active])
  @@map("preventive_plans")
}

// ============ ACCESIBILIDAD / TRABAJO EN ALTURA — SSOMA (F6.9) ============
// Hay cámaras y antenas en altura o sobre grúas donde NO se puede intervenir sin
// manlift, izaje o andamio. El manlift es un recurso caro y el trabajo en altura
// (desde 1.80 m) exige PETAR/IPERC/ATS. Por eso el técnico sustenta la solicitud
// con fotos y datos de seguridad, y SOLO el Jefe de Mantenimiento la aprueba.

/// CÓMO SE LLEGA A UN EQUIPO CONCRETO (bloque 41).
///
/// NO se reutiliza `AccessMeans` a propósito. Ése es el medio que se PIDE en
/// una solicitud de altura, y nadie pide permiso para llegar caminando: no
/// tiene A_PIE. Reutilizarlo obligaría a marcar «escalera» en una cámara del
/// púlpito a la que se llega andando — un dato falso metido para poder guardar.
enum MedioAcceso {
  A_PIE        /// gabinete, púlpito, sala eléctrica, tablero a nivel de piso
  ESCALERA     /// escalera portátil; bajo 1.80 m no es trabajo en altura
  ANDAMIO
  MANLIFT      /// plataforma elevadora — la cara, y la que costea Producción
  GRUA         /// izaje; además del equipo suele exigir parar la grúa
  LINEA_VIDA
  OTRO         /// válvula de escape; cuenta como no resuelto, no como «a pie»
}

enum AccessMeans {
  MANLIFT           // plataforma elevadora
  GRUA              // izaje / permiso de grúa
  ANDAMIO
  ESCALERA
  LINEA_VIDA
  OTRO
}

enum AccessRequestStatus {
  SOLICITADO
  EN_REVISION
  APROBADO
  RECHAZADO
}

/// Solicitud de acceso especial a un activo inaccesible (trabajo en altura).
model AccessRequest {
  id             String              @id @default(uuid())
  code           String              @unique // ej: ACC-2026-0001
  assetId        String
  asset          Asset               @relation(fields: [assetId], references: [id], onDelete: Cascade)
  requestedById  String?
  requestedBy    User?               @relation("AccessRequester", fields: [requestedById], references: [id])

  // ---- Sustento técnico ----
  heightMeters   Float?              // altura estimada (trabajo en altura desde 1.80 m)
  means          AccessMeans         @default(MANLIFT)
  locationKind   String?             // poste / estructura / grúa / techo / puente grúa
  justification  String              // por qué es inaccesible sin ese medio
  accessRoute    String?             // cómo se llega / restricciones de la zona

  // ---- Datos SSOMA (seguridad) ----
  requiresPetar  Boolean             @default(true)  // permiso de trabajo de alto riesgo
  hasIperc       Boolean             @default(false) // IPERC elaborado
  hasAts         Boolean             @default(false) // ATS del día
  personnelCount Int?                @default(2)     // mínimo 2 personas en altura
  eppDetail      String?             // arnés, línea de vida, casco con barbiquejo...
  risks          String?             // riesgos identificados
  productionImpact String?           // ¿requiere parar el tren / coordinar con Producción?

  // ---- Revisión (solo Jefe de Mantenimiento) ----
  status         AccessRequestStatus @default(SOLICITADO)
  reviewedById   String?
  reviewedBy     User?               @relation("AccessReviewer", fields: [reviewedById], references: [id])
  reviewedAt     DateTime?
  decisionNotes  String?

  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  photos         AccessRequestPhoto[]

  @@index([assetId])
  @@index([status])
  @@map("access_requests")
}

/// Fotografías que sustentan la inaccesibilidad (obligatorias para aprobar).
model AccessRequestPhoto {
  id        String        @id @default(uuid())
  requestId String
  request   AccessRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  fileId    String
  caption   String?
  createdAt DateTime      @default(now())

  @@index([requestId])
  @@map("access_request_photos")
}

// ===================== FOTOGRAFÍAS DE ACTIVO (F6.4) =====================
enum PhotoKind {
  APUNTA      // a qué apunta (campo de visión, cámaras de púlpito)
  REFERENCIA  // ubicación de referencia física
  PLANO       // ubicación en plano (a futuro)
  GENERAL     // otra foto del equipo
}

/// Fotografías del activo (a qué apunta, referencia, plano) — en MinIO.
model AssetPhoto {
  id        String    @id @default(uuid())
  assetId   String
  asset     Asset     @relation(fields: [assetId], references: [id], onDelete: Cascade)
  kind      PhotoKind @default(GENERAL)
  fileId    String
  caption   String?
  createdAt DateTime  @default(now())

  @@index([assetId])
  @@map("asset_photos")
}

/// Fotografías de campo de una incidencia (almacenadas en MinIO).
model IncidentEvidence {
  id          String   @id @default(uuid())
  incidentId  String
  incident    Incident @relation(fields: [incidentId], references: [id], onDelete: Cascade)
  fileId      String
  caption     String?
  createdAt   DateTime @default(now())

  @@map("incident_evidences")
}

// =====================================================================
//  MONITOREO — ESTADO OBSERVADO (bloque 8, preparado y apagado)
//
//  Lo OBSERVADO va aparte de lo DECLARADO, y es deliberado:
//    · assets.status  → lo pone una PERSONA. Es una decisión ("está de baja").
//    · AssetObservation → lo pone una MÁQUINA. Es un hecho ("no responde").
//  Una cámara declarada OPERATIVO que no responde no es una contradicción:
//  es justo la información que hoy no tenemos.
// =====================================================================

enum ProbeSource {
  AGENTE      // agente instalado dentro de planta
  ZABBIX
  HIKCENTRAL
  MANUAL      // alguien lo comprobó a mano
}

enum ProbeResult {
  RESPONDE
  NO_RESPONDE
  DEGRADADO      // responde, pero con pérdida o latencia alta
  DESCONOCIDO    // nunca se ha comprobado
}

/// UNA fila por activo, no un histórico. El histórico de pings de 2.000
/// cámaras cada minuto son 2,8 millones de filas al día y no dice nada que
/// no diga la última. El histórico que importa —cuándo se cayó y cuánto
/// duró— son las incidencias, que ya existen.
model AssetObservation {
  assetId          String      @id
  asset            Asset       @relation(fields: [assetId], references: [id], onDelete: Cascade)
  result           ProbeResult @default(DESCONOCIDO)
  source           ProbeSource @default(AGENTE)
  latencyMs        Int?
  lastSeenAt       DateTime?
  checkedAt        DateTime    @default(now())
  /// Fallos seguidos. Se exige más de uno antes de dar nada por caído: una
  /// pérdida suelta en una wifi industrial es lo normal, no una avería.
  consecutiveFails Int         @default(0)
  note             String?

  @@index([result])
  @@index([checkedAt])
  @@map("asset_observations")
}

/// Agentes autorizados a reportar. Sin esto el endpoint de ingesta sería un
/// buzón abierto donde cualquiera podría declarar media planta caída.
model MonitorAgent {
  id           String    @id @default(uuid())
  name         String    @unique
  /// Sólo el hash. El token se enseña UNA vez, al crearlo, y no se guarda.
  tokenHash    String
  active       Boolean   @default(true)
  lastReportAt DateTime?
  lastIp       String?
  createdAt    DateTime  @default(now())

  @@map("monitor_agents")
}

// =====================================================================
//  BANDEJA DE SALIDA DE AVISOS (bloque 4F)
//
//  CERRAR UNA ORDEN NO PUEDE FALLAR PORQUE TELEGRAM ESTÉ CAÍDO.
//  El aviso no se envía en el momento: se guarda aquí dentro de la misma
//  transacción —lo que no puede fallar, es la misma base— y otro proceso
//  lo manda y reintenta.
// =====================================================================

enum NotificacionEstado {
  PENDIENTE
  ENVIADA
  FALLIDA
  DESCARTADA
}

enum NotificacionCanal {
  TELEGRAM
  CORREO
  TEAMS
}

model NotificacionSaliente {
  id             String             @id @default(uuid())
  canal          NotificacionCanal  @default(TELEGRAM)
  estado         NotificacionEstado @default(PENDIENTE)
  /// Identificador de chat, correo o lo que necesite el canal.
  destino        String
  asunto         String
  cuerpo         String
  /// Qué lo disparó: OM_CERRADA, OM_EN_ESPERA, OM_ASIGNADA, INCIDENCIA_ALTA…
  evento         String
  referenciaId   String?
  intentos       Int                @default(0)
  /// Espera creciente: 1, 5, 15 y 60 minutos. Si el servidor de Telegram
  /// está caído no tiene sentido machacarlo cada minuto.
  proximoIntento DateTime?
  ultimoError    String?
  /// Los resúmenes van sin sonido. Si todo suena igual, se silencia el bot
  /// entero y el sistema de avisos deja de existir.
  silencioso     Boolean            @default(false)
  creadaEn       DateTime           @default(now())
  enviadaEn      DateTime?

  @@index([estado, proximoIntento])
  @@index([evento])
  @@map("notificaciones_salientes")
}

// =====================================================================
//  SESIONES REVOCABLES Y FRENO PERSISTENTE
//
//  Las dos cosas vivían en la memoria del proceso, y eso significaba:
//   · cerrar sesión no invalidaba nada — el refresh token seguía valiendo
//     hasta caducar, aunque la persona hubiera cambiado la contraseña;
//   · el freno de fuerza bruta se borraba en cada despliegue.
// =====================================================================

/// Una fila por sesión viva. El refresh token lleva su `id` dentro (jti):
/// si la fila no existe o está revocada, el token no sirve.
model Sesion {
  id               String    @id
  userId           String
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  creadaEn         DateTime  @default(now())
  expiraEn         DateTime
  ultimoUsoEn      DateTime?
  revocadaEn       DateTime?
  motivoRevocacion String?
  ip               String?
  /// Navegador o aparato, recortado. Sirve para que alguien reconozca su
  /// propia sesión en la lista: "Chrome en Windows" dice más que un id.
  dispositivo      String?
  /// Identificador estable del aparato (ver src/common/origen.ts).
  dispositivoId    String?
  /// Nombre del equipo conocido, si la IP estaba en el registro.
  equipo           String?

  @@index([userId])
  @@index([expiraEn])
  @@map("sesiones")
}

/// Freno por origen, persistido. Clave = ruta + origen.
model IntentoAcceso {
  clave          String    @id
  golpes         Int       @default(0)
  ventanaDesde   DateTime  @default(now())
  bloqueadoHasta DateTime?
  actualizadoEn  DateTime  @default(now())

  @@index([bloqueadoHasta])
  @@map("intentos_acceso")
}

/// Ajustes que hoy están en variables de entorno y que tiene sentido que
/// cambie el ingeniero sin entrar al panel de despliegue.
///
/// El token de Telegram NO se puede generar por programa —lo emite
/// @BotFather—, pero sí se puede pegar aquí una vez en lugar de en Railway:
/// sin reinicio, con comprobación inmediata y sin necesitar acceso al panel.
model ConfiguracionSistema {
  clave          String   @id
  /// Cifrado con el mismo mecanismo que las credenciales de las cámaras
  /// cuando `secreto` es true. Nunca se devuelve en claro a la pantalla.
  valor          String?
  secreto        Boolean  @default(false)
  descripcion    String?
  actualizadoEn  DateTime @default(now())
  actualizadoPor String?

  @@map("configuracion_sistema")
}

// =============================================================================
//  INSPECCIÓN DE CÁMARAS DE GRÚA (bloque 14)
// =============================================================================
//  POR QUÉ UN MODELO PROPIO Y NO UNA ORDEN NORMAL
//  Una cámara de grúa no falla como una cámara de pared. Falla por tres cosas
//  que ninguna otra cámara de la planta tiene:
//
//   1. EL CABLE SE ROMPE POR FATIGA. La grúa se mueve todo el día y el cable
//      viaja en cadena portacables o festón. No se corta de golpe: se van
//      partiendo hilos y el enlace empieza a caerse "a veces". Ese es el
//      "se arregla y vuelve a fallar" clásico, y sin registrar los ciclos y
//      el estado del chicote nadie lo relaciona jamás.
//
//   2. LA ANTENA SE DESALINEA. La imagen viaja por radioenlace porque un
//      cable fijo hasta una grúa en movimiento no existe. Con vibración y
//      golpes de viento, la antena pierde puntería y la señal cae. Anotar el
//      dBm en cada visita es lo que convierte "se ve mal" en una curva.
//
//   3. NO SE LLEGA SIN MANLIFT. Cada intervención cuesta un equipo caro, un
//      permiso de altura y a veces parar la grúa. Por eso la inspección se
//      planifica: hay que subir UNA vez y revisarlo TODO.
//
//  De ahí que el formulario sea largo a propósito: subir dos veces cuesta
//  más que rellenar veinte campos.
// =============================================================================

model InspeccionGrua {
  id            String   @id @default(uuid())
  code          String   @unique // ej: GRU-2026-0001

  /// La cámara inspeccionada. Es el ancla: todo lo demás describe su entorno.
  assetId       String
  asset         Asset    @relation("InspeccionGruaAsset", fields: [assetId], references: [id], onDelete: Cascade)

  /// Orden de mantenimiento que la originó, si vino de una. Puede ser null:
  /// también se registran inspecciones de campaña sin OM previa.
  workOrderId   String?
  workOrder     WorkOrder? @relation("InspeccionGruaWo", fields: [workOrderId], references: [id])

  /// Identificación de la grúa en planta. Texto libre a propósito: los
  /// nombres de grúa los pone Producción y no están en ningún catálogo
  /// nuestro ("Puente grúa 2", "GRU-107", "la del patio de palanquilla").
  grua          String
  posicionEnGrua String?  // cabina, pluma, lecho, gancho, sala eléctrica

  // ---------------- ACCESO ----------------
  /// Lo primero que hay que saber antes de programar nada.
  requiereManlift Boolean @default(true)
  alturaMetros    Float?
  /// A veces la grúa se puede bajar a piso o llevar a la zona de parqueo, y
  /// entonces NO hace falta manlift. Es la diferencia entre una intervención
  /// de una hora y una de un día con permiso de altura.
  seBajaAPiso     Boolean @default(false)
  requiereParada  Boolean @default(false) // hay que parar la grúa / coordinar con Producción
  accessRequestId String?                 // permiso de altura asociado, si se pidió

  // ---------------- CÁMARA ----------------
  camaraEstado    ComponenteEstado @default(NO_REVISADO)
  camaraObs       String?
  lenteSucio      Boolean @default(false)
  carcasaDanada   Boolean @default(false)
  soporteFlojo    Boolean @default(false)

  // ---------------- ANTENA / RADIOENLACE ----------------
  /// La imagen sale de la grúa por radio. Sin esto no hay video.
  antenaAssetId   String?
  antenaEstado    ComponenteEstado @default(NO_REVISADO)
  senalDbm        Int?     // -45 buena, -70 justa, -80 se cae
  senalDbmAnterior Int?    // se copia de la última inspección para ver la deriva
  antenaAlineada  Boolean @default(true)
  antenaObs       String?

  // ---------------- CABLEADO ----------------
  /// El punto que más falla y el que menos se mira.
  cableEstado     ComponenteEstado @default(NO_REVISADO)
  enCadenaPortacables Boolean @default(false)
  chicoteDanado   Boolean @default(false) // el tramo flexible, el que se fatiga
  prensaestopaOk  Boolean @default(true)  // si entra agua o polvo, el conector se pica
  conectorOxidado Boolean @default(false)
  metrosAproximados Float?
  cableObs        String?

  // ---------------- ALIMENTACIÓN ----------------
  alimentacionEstado ComponenteEstado @default(NO_REVISADO)
  poe             Boolean @default(true)
  fuenteAssetId   String?
  alimentacionObs String?

  // ---------------- GRABACIÓN ----------------
  /// Muchas grúas llevan grabador local porque el radioenlace se cae y la
  /// grabación no puede depender de él.
  grabadorLocal   Boolean @default(false)
  nvrAssetId      String?
  canalNvr        Int?
  grabaOk         Boolean @default(true)
  diasRetencion   Int?
  grabacionObs    String?

  // ---------------- GABINETE EN LA GRÚA ----------------
  gabineteEstado  ComponenteEstado @default(NO_REVISADO)
  gabineteHermetico Boolean @default(true)
  gabineteObs     String?

  // ---------------- RESULTADO ----------------
  resultado       ResultadoInspeccion @default(OPERATIVA)
  hallazgos       String?
  accionesRealizadas String?
  requiereSeguimiento Boolean @default(false)
  proximaRevision DateTime?

  inspeccionadoPorId String?
  inspeccionadoPor   User?    @relation("InspeccionGruaPor", fields: [inspeccionadoPorId], references: [id])
  fecha           DateTime @default(now())
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([assetId])
  @@index([grua])
  @@index([fecha])
  @@map("inspecciones_grua")
}

/// Estado de cada parte revisada. NO_REVISADO es el valor por defecto a
/// propósito: si el técnico no lo miró, el sistema no debe decir que estaba
/// bien. "Sin revisar" y "conforme" son cosas distintas y confundirlas es
/// exactamente cómo se pierde una avería.
enum ComponenteEstado {
  NO_REVISADO
  CONFORME
  OBSERVADO   // funciona, pero hay que volver
  NO_CONFORME // hay que intervenir
}

enum ResultadoInspeccion {
  OPERATIVA
  OPERATIVA_CON_OBSERVACIONES
  FUERA_DE_SERVICIO
  NO_SE_PUDO_ACCEDER   // faltó manlift, la grúa estaba en producción, etc.
}

// =====================================================================
//  EQUIPOS CONOCIDOS — el diccionario de "¿desde qué PC?"
//
//  POR QUÉ LA MAC SE ESCRIBE A MANO Y NO SE DETECTA
//  Porque no se puede detectar. La MAC es de capa 2 y no pasa del primer
//  router: al servidor le llega la del gateway, la misma para toda la planta.
//  El técnico de redes la saca de la reserva DHCP o de la tabla MAC del
//  switch —que es donde vive— y la escribe aquí. Declarada, no adivinada.
//
//  Con esto, una línea de auditoría deja de decir "10.20.3.14" y pasa a decir
//  "PC Púlpito Tren 2", que es lo que alguien necesita para ir a mirar.
// =====================================================================
model EquipoConocido {
  id          String   @id @default(uuid())
  /// "PC Púlpito Tren 2", "Laptop de mantenimiento", "Celular del supervisor".
  nombre      String
  /// IP fija o reservada por DHCP. Única: si se repite, la traducción miente.
  ip          String?  @unique
  /// Se escribe a mano. Ver el comentario de arriba.
  mac         String?  @unique
  /// PC | LAPTOP | CELULAR | TABLET | SERVIDOR | OTRO
  tipo        String   @default("PC")
  area        String?
  ubicacion   String?
  responsable String?
  notas       String?
  activo      Boolean  @default(true)
  /// Si se marca, este equipo exige que el acceso venga de él: su IP tiene
  /// que coincidir. Ver `acceso-dispositivo.guard.ts` para lo que esto puede
  /// y NO puede hacer.
  soloDesdeAqui Boolean @default(false)
  /// Red permitida en notación CIDR, ej. `10.20.3.0/24`. Sirve para la
  /// planta entera, que sale por una sola IP pública.
  redPermitida  String?
  dispositivos  DispositivoAutorizado[]
  creadoEn    DateTime @default(now())
  editadoEn   DateTime @default(now()) @updatedAt

  @@index([activo])
  @@map("equipos_conocidos")
}

// =====================================================================
//  VENTANAS DE PARADA (F8-F)  —  desbloqueado: SON MANUALES
//
//  LA RESPUESTA QUE FALTABA
//  Las paradas NO salen de SAP ni de un sistema de Producción. Producción
//  AVISA, muchas veces a última hora, y la hora se mueve. Por eso el modelo
//  separa DOS cosas que un diseño ingenuo mezclaría en una:
//
//    · lo PREVISTO  — lo que dijo Producción. Cambia.
//    · lo REAL      — lo que pasó. Lo escribe el técnico en campo.
//
//  Y por eso cada cambio de hora se guarda en `CambioParada`. Sin ese
//  registro, cuando la ventana se mueve tres veces y el trabajo no se hace,
//  no hay forma de demostrar que no fue culpa de mantenimiento. Con él, la
//  desviación entre previsto y real es un dato, no una discusión.
// =====================================================================
enum EstadoParada {
  ANUNCIADA    // Producción avisó. La hora todavía se mueve.
  CONFIRMADA   // Confirmada por radio, ya se puede movilizar gente.
  EN_CURSO
  TERMINADA
  CANCELADA
}

enum OrigenParada {
  PRODUCCION     // la pide Producción (cambio de canal, de producto)
  MANTENIMIENTO  // la pide mantenimiento mecánico/eléctrico
  FALLA          // parada no programada
  PROGRAMADA     // parada mayor de calendario
}

model VentanaParada {
  id              String        @id @default(uuid())
  tren            PlantTrain
  estado          EstadoParada  @default(ANUNCIADA)
  origen          OrigenParada  @default(PRODUCCION)

  /// Lo que dijo Producción. Se mueve, y por eso está aparte de lo real.
  inicioPrevisto  DateTime
  finPrevisto     DateTime?
  duracionPrevMin Int?

  /// Lo que pasó de verdad. Lo escribe quien está en campo.
  inicioReal      DateTime?
  finReal         DateTime?

  motivo          String?
  /// Quién avisó y por dónde. En planta esto llega por radio o WhatsApp:
  /// dejarlo por escrito es lo que convierte un recado en un dato.
  avisadoPor      String?
  canalAviso      String?
  notas           String?

  creadoPorId     String?
  creadoEn        DateTime      @default(now())
  editadoEn       DateTime      @default(now()) @updatedAt

  cambios         CambioParada[]
  ordenes         WorkOrder[]

  @@index([tren, estado])
  @@index([inicioPrevisto])
  @@map("ventanas_parada")
}

/// Cada vez que se mueve la hora, queda escrito quién, cuándo y por qué.
model CambioParada {
  id            String        @id @default(uuid())
  paradaId      String
  parada        VentanaParada @relation(fields: [paradaId], references: [id], onDelete: Cascade)
  campo         String
  valorAntes    String?
  valorDespues  String?
  motivo        String?
  porId         String?
  en            DateTime      @default(now())

  @@index([paradaId])
  @@map("cambios_parada")
}

// =====================================================================
//  INSTALACIONES (Bloque 16)
//
//  POR QUÉ NO ES UNA ORDEN DE MANTENIMIENTO
//  Una OM arregla algo que existe. Una instalación pone algo que NO existe,
//  y las preguntas son otras: ¿hay corriente ahí? ¿llega la red? ¿cuántos
//  metros de cable? ¿se puede subir sin manlift? ¿quién autoriza entrar?
//  Meter eso en la OM habría llenado el formulario de mantenimiento de
//  cuarenta campos que no aplican al 95 % de las órdenes.
//
//  EL FORMULARIO CAMBIA SEGÚN EL SITIO, Y ESO ES LO IMPORTANTE
//  Instalar en un PÚLPITO y en una GRÚA no se parecen en nada:
//
//    PÚLPITO / OFICINA  → ¿falso techo? ¿canaleta? ¿climatizado? ¿qué
//                         pantalla hay? ¿quién autoriza entrar en turno?
//    GRÚA               → ¿manlift? ¿la grúa se detiene? ¿va por la cadena
//                         portacables o por antena? ¿hay línea de vista?
//    SALA ELÉCTRICA     → ¿permiso eléctrico? ¿bloqueo LOTO? ¿riesgo de arco?
//    PATIO / INTEMPERIE → ¿gabinete estanco? ¿qué grado IP?
//
//  Todos los campos son OPCIONALES en la base a propósito: la pantalla
//  enseña sólo los que aplican al tipo de sitio, y el servicio exige los
//  que ese tipo necesita. Hacerlos obligatorios en el esquema habría
//  obligado a rellenar "¿necesita manlift?" para una cámara de oficina.
//
//  TERMINA CREANDO EL ACTIVO. Ése es el remate: cuando la instalación pasa
//  a INSTALADA, nace el registro en el inventario, con su ubicación y su
//  ficha. Sin eso, el equipo queda puesto en la pared y fuera del sistema.
// =====================================================================
enum TipoSitio {
  OFICINA
  PULPITO
  GRUA
  SALA_ELECTRICA
  NAVE
  PATIO
  ALMACEN
  CASETA
  SUBESTACION
  LABORATORIO
  OTRO
}

enum EstadoInstalacion {
  SOLICITADA     // alguien la pide
  EN_EVALUACION  // asignada a un técnico para visita
  EVALUADA       // se fue, midió y llenó las condiciones del sitio
  APROBADA       // el Jefe la aprueba
  RECHAZADA
  EN_EJECUCION   // hay OM abierta
  INSTALADA      // hecha, y con el activo creado
  CANCELADA
}

model Instalacion {
  id             String            @id @default(uuid())
  codigo         String            @unique // INS-2026-0001
  estado         EstadoInstalacion @default(SOLICITADA)

  tipoSitio      TipoSitio
  tipoEquipo     AssetType
  cantidad       Int               @default(1)
  tren           PlantTrain?
  locationId     String?
  location       Location?         @relation(fields: [locationId], references: [id])
  /// Dónde exactamente, en texto llano: "columna 14, junto a la escalera norte".
  referenciaSitio String?
  comoLlegar     String?
  justificacion  String
  solicitadaPor  String?
  areaSolicitante String?

  // ---- Condiciones del sitio: SE MIDEN EN LA VISITA ----
  hayEnergia      Boolean?
  tipoEnergia     String?   // 220V tomacorriente / PoE / 24VDC / tablero
  hayPuntoRed     Boolean?
  gabineteCercano String?
  metrosCable     Float?
  rutaCable       String?
  necesitaPoe     Boolean?
  switchDestinoId String?
  nvrDestinoId    String?
  canalNvr        Int?

  // ---- Acceso y seguridad ----
  alturaMetros            Float?
  necesitaManlift         Boolean?
  necesitaAndamio         Boolean?
  /// ¿Hay que parar el tren para hacerlo? Enlaza con las ventanas de parada.
  necesitaParada          Boolean?
  necesitaLoto            Boolean?
  necesitaPermisoAltura   Boolean?
  necesitaPermisoCaliente Boolean?
  riesgos                 String?
  quienAutoriza           String?

  // ---- Sólo GRÚA ----
  gruaNombre           String?
  gruaSeDetiene        Boolean?
  porCadenaPortacables Boolean?
  porAntena            Boolean?
  antenaModelo         String?
  distanciaEnlaceM     Float?
  hayLineaVista        Boolean?

  // ---- Sólo OFICINA / PÚLPITO ----
  hayFalsoTecho     Boolean?
  hayCanaleta       Boolean?
  esClimatizado     Boolean?
  pantallaExistente String?
  puestoOperador    String?

  // ---- Ambiente ----
  ambiente                 Environment?
  necesitaGabineteEstanco  Boolean?
  gradoIpRequerido         String?

  materialesEstimados String?
  costoEstimado       Float?
  moneda              String?  @default("PEN")

  evaluadaPorId   String?
  evaluadaEn      DateTime?
  aprobadaPorId   String?
  aprobadaEn      DateTime?
  motivoRechazo   String?

  workOrderId     String?
  workOrder       WorkOrder? @relation(fields: [workOrderId], references: [id])
  /// El activo que nació de esta instalación. El remate del ciclo.
  assetCreadoId   String?
  assetCreado     Asset?     @relation("AssetDeInstalacion", fields: [assetCreadoId], references: [id])
  instaladaEn     DateTime?

  notas           String?
  creadoPorId     String?
  creadoEn        DateTime  @default(now())
  editadoEn       DateTime  @default(now()) @updatedAt

  fotos           FotoInstalacion[]

  @@index([estado])
  @@index([tipoSitio])
  @@index([tren])
  @@index([locationId])
  @@map("instalaciones")
}

/// Fotos del sitio. Una foto del techo del púlpito ahorra la segunda visita.
model FotoInstalacion {
  id            String      @id @default(uuid())
  instalacionId String
  instalacion   Instalacion @relation(fields: [instalacionId], references: [id], onDelete: Cascade)
  fileId        String
  descripcion   String?
  /// ANTES | DURANTE | DESPUES
  momento       String      @default("ANTES")
  creadoEn      DateTime    @default(now())

  @@index([instalacionId])
  @@map("fotos_instalacion")
}

// =====================================================================
//  CAMPAÑAS DE MAPEO (12.5) — el control de calidad del levantamiento
//
//  POR QUÉ ESTO NO ES UNA BARRA DE PROGRESO
//  Contra un dato mal cargado NINGÚN respaldo sirve: el respaldo devuelve
//  fielmente el dato equivocado. Y un mapeo de 300 cámaras hecho a prisa,
//  con el teléfono, en una nave a 40 grados, va a traer códigos repetidos,
//  fichas a medias y equipos sin ubicación.
//
//  LA REGLA QUE LO CONVIERTE EN CONTROL DE CALIDAD:
//    **quien revisa NO puede ser quien cargó.**
//  Sin eso es una casilla que se marca sola, y el error entra igual.
//
//  Y LA SEGUNDA: una zona con defectos BLOQUEANTES no se aprueba. No es un
//  aviso que se pueda ignorar pulsando dos veces.
// =====================================================================
enum EstadoCampana {
  PLANIFICADA
  EN_CURSO
  EN_REVISION
  CERRADA
  CANCELADA
}

enum EstadoZona {
  PENDIENTE   // repartida, nadie ha ido
  EN_CAMPO    // el técnico está levantando
  CARGADA     // dice que terminó
  EN_REVISION // otra persona la está mirando
  APROBADA    // revisada y sin defectos bloqueantes
  DEVUELTA    // revisada y con cosas que corregir
}

model CampanaMapeo {
  id             String        @id @default(uuid())
  codigo         String        @unique // CAM-2026-01
  nombre         String
  estado         EstadoCampana @default(PLANIFICADA)
  tren           PlantTrain?
  descripcion    String?
  responsableId  String?
  inicioPrevisto DateTime?
  finPrevisto    DateTime?
  cerradaEn      DateTime?
  creadoPorId    String?
  creadoEn       DateTime      @default(now())
  editadoEn      DateTime      @default(now()) @updatedAt

  zonas          ZonaCampana[]
  activos        Asset[]

  @@index([estado])
  @@index([tren])
  @@map("campanas_mapeo")
}

/// Una zona repartida a una persona. Es la unidad que se revisa y se aprueba.
model ZonaCampana {
  id            String       @id @default(uuid())
  campanaId     String
  campana       CampanaMapeo @relation(fields: [campanaId], references: [id], onDelete: Cascade)
  locationId    String
  location      Location     @relation(fields: [locationId], references: [id], onDelete: Cascade)
  estado        EstadoZona   @default(PENDIENTE)
  asignadoAId   String?
  /// Cuántos equipos se esperan aquí. Si el ingeniero no lo sabe, se deja
  /// vacío: NO se inventa un número, porque después alguien lo daría por
  /// bueno y "faltan 3" sería una alarma falsa.
  esperados     Int?
  notas         String?

  /// Quién dijo "terminé" y quién lo revisó. Tienen que ser distintos.
  cargadaPorId  String?
  cargadaEn     DateTime?
  revisadaPorId String?
  revisadaEn    DateTime?
  observaciones String?

  creadoEn      DateTime     @default(now())
  editadoEn     DateTime     @default(now()) @updatedAt

  @@unique([campanaId, locationId])
  @@index([campanaId])
  @@index([estado])
  @@index([asignadoAId])
  @@map("zonas_campana")
}

// =====================================================================
//  ACCESO POR DISPOSITIVO (bloque 18)
//
//  LO QUE SE PUEDE Y LO QUE NO — hay que decirlo antes de nada
//
//  · Por MAC: IMPOSIBLE. La MAC es de capa 2 y no llega al servidor. El
//    filtrado por MAC se hace en el SWITCH (802.1X o port-security), no
//    aquí. Cualquier cosa que diga lo contrario está mintiendo.
//
//  · Por IP: SÓLO sirve para la red de planta, que sale por una IP pública
//    fija. NO sirve para los técnicos con DATOS MÓVILES: el operador les
//    cambia la IP constantemente (CGNAT). Un filtro estricto por IP dejaría
//    fuera justo a quien más lo necesita.
//
//  · Por DISPOSITIVO: esto sí. El navegador se presenta con un identificador
//    estable que sobrevive al cambio de IP. El Jefe aprueba los aparatos una
//    vez y los demás no entran. Es lo que de verdad contesta la pregunta
//    "¿sólo desde los equipos que yo diga?".
//
//  NO ES INFALIBLE, y así está tratado: el identificador se puede copiar si
//  alguien tiene acceso al navegador de un aparato aprobado. Es UNA CAPA MÁS
//  sobre la contraseña y el token, no un sustituto.
// =====================================================================
enum EstadoDispositivo {
  PENDIENTE  // se vio por primera vez y espera decisión
  APROBADO
  BLOQUEADO
}

model DispositivoAutorizado {
  id              String            @id @default(uuid())
  /// El identificador que manda el navegador en `X-Dispositivo`.
  dispositivoId   String            @unique
  estado          EstadoDispositivo @default(PENDIENTE)
  /// Nombre que le pone el Jefe: "Celular de Juan", "PC del púlpito T2".
  nombre          String?
  equipoConocidoId String?
  equipoConocido  EquipoConocido?   @relation(fields: [equipoConocidoId], references: [id])
  userAgent       String?
  ultimaIp        String?
  /// Últimas IP distintas desde las que se vio, separadas por coma. Sirve
  /// para distinguir un PC fijo de un celular que salta de red.
  ipsVistas       String?
  /// Último usuario que entró desde aquí. Un aparato compartido es normal.
  usuarioId       String?
  primerVistoEn   DateTime          @default(now())
  ultimoVistoEn   DateTime          @default(now())
  vistas          Int               @default(1)
  aprobadoPorId   String?
  aprobadoEn      DateTime?
  motivo          String?

  @@index([estado])
  @@map("dispositivos_autorizados")
}

// =====================================================================
//  ELECTRICIDAD (bloque 18)
//
//  POR QUÉ UN MÓDULO ELÉCTRICO EN UN SISTEMA DE CCTV
//  Porque la causa número uno de "se cayeron ocho cámaras de golpe" no es
//  la red ni las cámaras: es que saltó una llave. Y hoy nadie puede
//  contestar "¿qué se apagó cuando saltó el térmico 12 del MCC-T2?".
//
//  La tabla que importa es `AlimentacionActivo`: qué equipo cuelga de qué
//  circuito. Con eso, el análisis de impacto que ya existe puede contestar
//  la pregunta de verdad, y el técnico sabe QUÉ llave levantar antes de
//  subirse a mirar la cámara.
// =====================================================================
enum TipoTablero {
  MCC
  DISTRIBUCION
  CONTROL
  ILUMINACION
  UPS
  TRANSFORMADOR
  OTRO
}

enum TipoProteccion {
  TERMOMAGNETICO
  DIFERENCIAL
  FUSIBLE
  GUARDAMOTOR
  SECCIONADOR
  OTRO
}

enum EstadoCircuito {
  ACTIVO
  FUERA_SERVICIO
  RESERVA
  DESCONOCIDO
}

model TableroElectrico {
  id            String       @id @default(uuid())
  codigo        String       @unique // TAB-T2-MCC-01
  nombre        String
  tipo          TipoTablero  @default(DISTRIBUCION)
  locationId    String?
  location      Location?    @relation(fields: [locationId], references: [id])
  tren          PlantTrain?
  referencia    String?
  comoLlegar    String?
  tensionV      Int?
  fases         Int?
  corrienteNominalA Float?
  /// De qué tablero cuelga éste. Permite seguir la cadena hacia arriba:
  /// si cae el general, cae todo lo que hay debajo.
  alimentadoDeId String?
  alimentadoDe  TableroElectrico?  @relation("CadenaTableros", fields: [alimentadoDeId], references: [id])
  alimenta      TableroElectrico[] @relation("CadenaTableros")
  /// Si además está dado de alta como activo, para tener su historial de OM.
  assetId       String?
  asset         Asset?       @relation(fields: [assetId], references: [id])
  fotoFileId    String?
  riesgos       String?
  /// Casi siempre sí: un tablero se abre con permiso eléctrico y bloqueo.
  requierePermiso Boolean    @default(true)
  notas         String?
  creadoPorId   String?
  creadoEn      DateTime     @default(now())
  editadoEn     DateTime     @default(now()) @updatedAt

  circuitos     CircuitoElectrico[]
  mediciones    MedicionElectrica[]
  /// Equipos atornillados DENTRO del tablero (switches pequeños, fuentes).
  /// Distinto de `alimenta`: eso es lo que cuelga eléctricamente y puede
  /// estar a cien metros. Esto es lo que está físicamente aquí dentro.
  equiposMontados Asset[]         @relation("EquiposEnTablero")

  @@index([locationId])
  @@index([tren])
  @@map("tableros_electricos")
}

model CircuitoElectrico {
  id          String           @id @default(uuid())
  tableroId   String
  tablero     TableroElectrico @relation(fields: [tableroId], references: [id], onDelete: Cascade)
  /// Como está rotulado en la puerta del tablero: "12", "Q-04", "F3".
  numero      String
  designacion String?
  proteccion  TipoProteccion   @default(TERMOMAGNETICO)
  amperajeA   Float?
  curva       String?
  polos       Int?
  tensionV    Int?
  estado      EstadoCircuito   @default(ACTIVO)
  /// Marca los circuitos que alimentan CCTV. Es el filtro que usa el
  /// técnico de red cuando busca por qué se le cayó media nave.
  esCctv      Boolean          @default(false)
  notas       String?
  creadoEn    DateTime         @default(now())
  editadoEn   DateTime         @default(now()) @updatedAt

  alimenta    AlimentacionActivo[]
  mediciones  MedicionElectrica[]

  @@unique([tableroId, numero])
  @@index([tableroId])
  @@index([esCctv])
  @@map("circuitos_electricos")
}

/// QUÉ EQUIPO CUELGA DE QUÉ LLAVE. La tabla que hace útil todo lo demás.
model AlimentacionActivo {
  id         String            @id @default(uuid())
  circuitoId String
  circuito   CircuitoElectrico @relation(fields: [circuitoId], references: [id], onDelete: Cascade)
  assetId    String
  asset      Asset             @relation(fields: [assetId], references: [id], onDelete: Cascade)
  /// La cámara no cuelga del breaker: cuelga del switch PoE, que sí. Marcarlo
  /// evita que alguien vaya a buscar un enchufe que no existe.
  viaPoe     Boolean           @default(false)
  notas      String?
  creadoEn   DateTime          @default(now())

  @@unique([circuitoId, assetId])
  @@index([assetId])
  @@map("alimentacion_activo")
}

model MedicionElectrica {
  id           String             @id @default(uuid())
  circuitoId   String?
  circuito     CircuitoElectrico? @relation(fields: [circuitoId], references: [id], onDelete: Cascade)
  tableroId    String?
  tablero      TableroElectrico?  @relation(fields: [tableroId], references: [id], onDelete: Cascade)
  fecha        DateTime           @default(now())
  tensionV     Float?
  corrienteA   Float?
  /// Termografía. Un borne a 80 grados es una avería con fecha.
  temperaturaC Float?
  observacion  String?
  medidoPorId  String?

  @@index([circuitoId])
  @@index([tableroId])
  @@map("mediciones_electricas")
}

// =====================================================================
//  DIRECCIONAMIENTO IP — IPAM (bloque 20)
//
//  LA PREGUNTA QUE HOY NADIE PUEDE CONTESTAR
//  «Voy a instalar una cámara. ¿Qué IP le pongo?»
//
//  Hoy se contesta mirando un Excel desactualizado o, peor, haciendo ping y
//  usando la que no responde. Eso funciona hasta el día que el equipo que la
//  tenía estaba apagado por mantenimiento — y entonces hay dos equipos con la
//  misma IP tumbándose entre ellos de forma intermitente. Es el fallo más
//  difícil de diagnosticar de una red, porque funciona a ratos.
//
//  LA OCUPACIÓN NO SE LEE SÓLO DE AQUÍ. Se cruza con `assets.ipAddress`: un
//  equipo puede tener IP configurada y no estar reservada en esta tabla, y
//  eso es justamente lo que hay que sacar a la luz, no esconder.
// =====================================================================
enum PropositoSubred {
  CCTV
  GESTION      // gestión de switches, NVR, UPS
  CORPORATIVA
  PROCESO      // PLC, HMI — no se toca sin Automatización
  WIFI
  OTRO
}

enum TipoAsignacion {
  ESTATICA      // configurada a mano en el equipo
  RESERVA_DHCP  // el DHCP siempre le da la misma, por MAC
  DHCP          // dinámica del pool
  RESERVADA     // apartada para algo futuro
  LIBRE
}

model Subred {
  id          String          @id @default(uuid())
  /// Notación CIDR: 10.20.4.0/24
  cidr        String          @unique
  nombre      String
  proposito   PropositoSubred @default(CCTV)
  vlan        Int?
  gateway     String?
  dns1        String?
  dns2        String?
  tren        PlantTrain?
  locationId  String?
  location    Location?       @relation(fields: [locationId], references: [id])
  /// Rango que gestiona el DHCP. Fuera de ahí van las estáticas: declararlo
  /// evita que alguien ponga una estática dentro del pool y el servidor la
  /// entregue a otro equipo la semana siguiente.
  dhcpDesde   String?
  dhcpHasta   String?
  descripcion String?
  activa      Boolean         @default(true)
  creadoPorId String?
  creadoEn    DateTime        @default(now())
  editadoEn   DateTime        @default(now()) @updatedAt

  reservas    ReservaIp[]

  @@index([tren])
  @@map("subredes")
}

model ReservaIp {
  id          String         @id @default(uuid())
  ip          String         @unique
  subredId    String?
  subred      Subred?        @relation(fields: [subredId], references: [id])
  tipo        TipoAsignacion @default(ESTATICA)
  assetId     String?
  asset       Asset?         @relation(fields: [assetId], references: [id])
  hostname    String?
  /// Se escribe a mano, igual que en Equipos conocidos: la MAC no llega al
  /// servidor. Sale de la reserva DHCP o de la tabla MAC del switch.
  mac         String?
  descripcion String?
  notas       String?
  creadoPorId String?
  creadoEn    DateTime       @default(now())
  editadoEn   DateTime       @default(now()) @updatedAt

  @@index([subredId])
  @@index([assetId])
  @@map("reservas_ip")
}

// =====================================================================
//  CATÁLOGO DE COLORES DE CABLE — bloque 45
//
//  ANSI/TIA-606-C recomienda el color como ayuda visual pero NO impone
//  cuál: no existe un color universal obligatorio. Lo exigible es la
//  COHERENCIA — que, elegido el esquema, se mantenga idéntico en toda la
//  instalación. El valor no está en cuál sea, está en que signifique
//  SIEMPRE lo mismo.
//
//  POR ESO ES UNA TABLA Y NO UN ENUM. Un enum obliga a migración y
//  despliegue para añadir un color, y un estándar de cableado es
//  exactamente la clase de cosa que una empresa revisa. Regla del
//  proyecto: todo lo de planta se edita desde la interfaz.
//
//  Se siembra con los seis acordados con Aceros Arequipa, pero COMO
//  DATOS. Si mañana hay un séptimo, se añade desde la pantalla.
// =====================================================================
model ColorDeCable {
  id        String  @id @default(uuid())
  /// Estable: es lo que guarda el tramo. Cambiar el nombre no rompe nada.
  code      String  @unique
  nombre    String
  /// Para qué sirve. Es lo que se lee en la leyenda de Rotulado.
  uso       String
  /// Por qué se separa de los demás. Sin esto la leyenda es una lista de
  /// colores y nadie entiende la regla.
  porQue    String?
  /// Sólo para pintar la pastilla en pantalla. El dato de verdad es el nombre:
  /// el técnico no mira un hexadecimal, mira el cable.
  hex       String
  orden     Int     @default(0)
  /// DESACTIVAR EN VEZ DE BORRAR. Si alguien elimina un color que ya está en
  /// doscientos tramos, se pierde el dato. Desactivado deja de ofrecerse en
  /// formularios nuevos y sigue viéndose en los que lo tienen.
  activo    Boolean @default(true)

  tramos    AssetCable[]

  @@map("colores_de_cable")
}
