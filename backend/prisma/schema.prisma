// =============================================================================
//  SGIT-CCTV — Esquema de datos (Prisma / PostgreSQL)
//  Aceros Arequipa · Planta Pisco · Trenes 1, 2 y 3 (Laminación)
//  Diseño: monolito modular, herencia por tipo de activo, topología PMP,
//          campos SAP-ready, auditoría append-only.
// =============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// =====================================================================
//  SEGURIDAD Y CONTROL DE ACCESO (Módulo 1)
// =====================================================================

model User {
  id           String    @id @default(uuid())
  email        String    @unique
  fullName     String
  passwordHash String
  active       Boolean   @default(true)
  roleId       String
  role         Role      @relation(fields: [roleId], references: [id])
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  workOrders   WorkOrder[] @relation("AssignedTechnician")
  incidents    Incident[]  @relation("IncidentResponsible")
  auditLogs    AuditLog[]
  stockMovements StockMovement[]
  stockChecks    StockCheck[]
  accessRequested AccessRequest[] @relation("AccessRequester")
  accessReviewed  AccessRequest[] @relation("AccessReviewer")

  @@map("users")
}

model Role {
  id          String           @id @default(uuid())
  name        String           @unique // Administrador, Supervisor TI, Técnico, Consulta
  description String?
  users       User[]
  permissions RolePermission[]

  @@map("roles")
}

model Permission {
  id          String           @id @default(uuid())
  code        String           @unique // ej: asset.create, wo.approve, incident.close
  description String?
  roles       RolePermission[]

  @@map("permissions")
}

model RolePermission {
  roleId       String
  permissionId String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

// =====================================================================
//  UBICACIONES — jerarquía física (Módulo 3)
//  Empresa > Planta > Tren > Área > Sala/Zona > Rack > (Equipo=Asset)
// =====================================================================

enum LocationType {
  EMPRESA
  PLANTA
  TREN
  AREA
  SALA
  ZONA
  RACK
  /// Etapa del proceso de laminación (F8). Va al FINAL porque PostgreSQL
  /// siempre añade los valores nuevos de un enum al final: si aquí figurara
  /// en otra posición, el esquema y la base no coincidirían.
  ETAPA
}

/// Ambiente físico donde vive el equipo. Es lo que REALMENTE lo degrada.
/// No es lo mismo una cámara sobre el horno recalentador (1,100 °C) que una
/// en el púlpito climatizado: el intervalo de mantenimiento preventivo se
/// deriva de aquí y no de una casilla "crítico sí/no" marcada a criterio.
enum Environment {
  CALOR_RADIANTE    // horno recalentador — radiación directa, degrada sellos y óptica
  VAPOR_AGUA        // trenes — refrigeración de rodillos, condensación interna
  POLVO_METALICO    // cascarilla, taller de rodillos, cizalla — abrasión
  INTEMPERIE_SALINA // patios y almacenes — Pisco es costa: corrosión acelerada
  EMI_ALTA          // salas eléctricas y MCC — interferencia electromagnética
  CLIMATIZADO       // púlpitos de control — polvo normal
}

// =====================================================================
//  ETAPAS DEL PROCESO DE LAMINACIÓN (F8)
//
//  Es CATÁLOGO EDITABLE, no un enum. Razón técnica concreta: los tres
//  trenes NO comparten las mismas etapas —el Tren 1 produce perfiles, el
//  Tren 2 sólo corrugado y el Tren 3 es una línea distinta—. Con un enum,
//  cada diferencia obligaría a migración de base de datos y redespliegue;
//  con una tabla lo edita el Jefe de Mantenimiento desde la interfaz.
//
//  El catálogo define la etapa UNA vez; el árbol de ubicaciones la
//  instancia en cada tren que la tenga.
// =====================================================================
model ProcessStage {
  id                  String      @id @default(uuid())
  code                String      @unique // ej: DESBASTE, HORNO_RECAL
  name                String
  /// Orden dentro del proceso (palanquilla -> producto terminado). Permite
  /// dibujar el tren de izquierda a derecha y detectar tramos ciegos seguidos.
  sequence            Int
  environment         Environment
  /// Criticidad MÍNIMA de todo activo instalado en esta etapa. Una cámara
  /// caída en el tren de desbaste deja al operador ciego ante un atasco a
  /// 1,100 °C; una caída en el almacén no detiene nada.
  baseCriticality     Criticality
  /// Intervalo preventivo sugerido en días, derivado del ambiente. Editable.
  defaultIntervalDays Int
  /// Qué vigila el CCTV en esta etapa (para el informe y la capacitación).
  watches             String?
  active              Boolean     @default(true)
  createdAt           DateTime    @default(now())
  updatedAt           DateTime    @updatedAt

  locations           Location[]

  @@index([sequence])
  @@map("process_stages")
}

model Location {
  id               String       @id @default(uuid())
  type             LocationType
  code             String       @unique // ej: AASA-PISCO-T1-LAMIN-R01
  name             String
  parentId         String?
  parent           Location?    @relation("LocationTree", fields: [parentId], references: [id])
  children         Location[]   @relation("LocationTree")
  path             String       @default("") // ruta materializada para navegación rápida
  photoFileId      String?      // foto de referencia de la ubicación (MinIO)
  // ---- Proceso de laminación (F8) ----
  /// Etapa del proceso que representa esta ubicación. Sólo aplica a type=ETAPA.
  stageId          String?
  stage            ProcessStage? @relation(fields: [stageId], references: [id])
  /// Ambiente puntual. Normalmente se hereda de la etapa; se usa sólo cuando
  /// un punto concreto difiere del resto (ej. una cámara dentro de un cofre
  /// refrigerado en plena zona de calor).
  environment      Environment?
  // ---- Campos SAP-ready ----
  sapLocationCode  String?
  costCenter       String?
  responsibleArea  String?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  assets           Asset[]
  documents        Document[]
  cabinets         Cabinet[]

  @@index([parentId])
  @@index([path])
  @@index([stageId])
  @@map("locations")
}

// =====================================================================
//  GABINETES / RACKS (F6.3) — parámetro de mantenimiento, NO es un activo.
//  Un gabinete tiene rótulo propio, ubicación y foto; los equipos montados
//  (NVR, switch, etc.) indican en qué gabinete están para ubicarlos rápido.
// =====================================================================
model Cabinet {
  id          String    @id @default(uuid())
  code        String    @unique // rótulo del gabinete (ej. GAB-T1-R01)
  name        String
  locationId  String?
  location    Location? @relation(fields: [locationId], references: [id])
  referencePlace String? // referencia física (texto libre)
  photoFileId String?    // foto del gabinete en MinIO
  notes       String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  assets      Asset[]

  @@index([locationId])
  @@map("cabinets")
}

// =====================================================================
//  ACTIVOS TECNOLÓGICOS (Módulo 2) — tabla base + herencia por tipo
// =====================================================================

enum AssetType {
  CAMERA
  NVR
  SWITCH
  WIRELESS   // antena / radioenlace (Ubiquiti, Mimosa)
  ROUTER
  FIREWALL
  SERVER
  UPS
  FIBER
  CABINET
  DECODER    // video wall / decoder Hikvision
  PC         // estación de visualización (iVMS-4200) — parte del mantenimiento CCTV
  OTHER
}

enum AssetStatus {
  OPERATIVO
  FUERA_SERVICIO
  MANTENIMIENTO
  BAJA
  STOCK
}

enum Criticality {
  BAJA
  MEDIA
  ALTA
  CRITICA // pérdida de visión que detiene o arriesga producción
}

/// OBSOLETO desde F8 — se conserva sólo por seguridad de reversión.
///
/// Este enum creaba una SEGUNDA jerarquía en competencia con el árbol de
/// ubicaciones: nada impedía que un activo colgara de "Tren 2" en el árbol y
/// dijera TREN_1 aquí. Es el mismo problema de duplicación de verdad que se
/// corrigió en F5 con el estado derivado, pero en la dimensión de ubicación.
///
/// A partir de F8 el tren se DEDUCE subiendo el árbol de ubicaciones
/// (ver common/plant-context.ts). La columna Asset.train permanece poblada
/// durante una fase de transición y se eliminará cuando todos los módulos
/// lean del árbol. No escribir lógica nueva contra este campo.
enum PlantTrain {
  TREN_1
  TREN_2
  TREN_3
  PATIO           // patios, almacenes y exteriores
  PLANTA_GENERAL  // servicios comunes, oficinas, accesos
}

model Asset {
  id            String      @id @default(uuid())
  assetCode     String      @unique // ej: AA-CAM-T1-FX-001
  type          AssetType
  brand         String?
  model         String?
  serialNumber  String?
  firmware      String?
  ipAddress     String?     // IP principal (sensible: solo roles con credential.read)
  referencePlace String?    // lugar de referencia en planta (texto libre)
  status        AssetStatus @default(OPERATIVO)
  criticality   Criticality @default(MEDIA)
  /// OBSOLETO desde F8: el tren se deduce del árbol de ubicaciones.
  /// Se mantiene poblado en la transición para poder revertir sin pérdida.
  train         PlantTrain?
  installDate   DateTime?
  warrantyEnd   DateTime?
  locationId    String?
  location      Location?   @relation(fields: [locationId], references: [id])
  cabinetId     String?     // gabinete donde está montado (NVR, switch, etc.)
  cabinet       Cabinet?    @relation(fields: [cabinetId], references: [id])
  // ---- Campos SAP-ready ----
  sapId         String?     @unique
  costCenter    String?
  responsibleArea String?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  deletedAt     DateTime?   // soft delete

  // Extensiones por tipo (1:1)
  camera        AssetCamera?
  nvr           AssetNvr?
  switchDev     AssetSwitch?
  wireless      AssetWireless?

  // Relaciones operativas y de red
  credentials   Credential[]
  workOrders    WorkOrder[]
  incidents     Incident[]
  documents     Document[]
  history       AssetHistory[]
  portsOnSwitch SwitchPort[]  @relation("PortSwitch")
  connectedPort SwitchPort?   @relation("PortConnectedAsset")
  linksA        NetworkLink[] @relation("LinkEndpointA")
  linksB        NetworkLink[] @relation("LinkEndpointB")
  spareLinks    SparePartAsset[]
  preventivePlan PreventivePlan?
  photos        AssetPhoto[]
  accessRequests AccessRequest[]

  @@index([type])
  @@index([status])
  @@index([locationId])
  @@index([cabinetId])
  @@index([train])
  @@map("assets")
}

model AssetCamera {
  assetId          String  @id
  asset            Asset   @relation(fields: [assetId], references: [id], onDelete: Cascade)
  resolution       String? // ej: 2560x1440 (4MP)
  cameraUser       String?
  rtspUrl          String?
  ipAddress        String? // se valida como INET a nivel de app/migración
  macAddress       String?
  vlanId           String?
  vlan             Vlan?   @relation(fields: [vlanId], references: [id])
  nvrId            String? // NVR asociado (Asset de tipo NVR)
  switchPortId     String? @unique
  switchPort       SwitchPort? @relation(fields: [switchPortId], references: [id])
  wirelessUplinkId String? // antena suscriptora/PMP por la que cuelga

  @@map("asset_cameras")
}

model AssetNvr {
  assetId       String  @id
  asset         Asset   @relation(fields: [assetId], references: [id], onDelete: Cascade)
  channels      Int?
  diskCount     Int?
  capacityTb    Float?
  hasLocalDisk  Boolean @default(false) // relevante para grúas (informe GRU-107)
  switchIdDirect String? // switch al que se conecta directo (topología anillo)
  nicPrimary    String? // ej: 172.16.x (segmento industrial)
  nicSecondary  String? // ej: 10.0.x   (segmento visualización iVMS-4200)

  @@map("asset_nvrs")
}

model AssetSwitch {
  assetId    String       @id
  asset      Asset        @relation(fields: [assetId], references: [id], onDelete: Cascade)
  portCount  Int?
  mgmtIp     String?
  vendor     String?      // Fortinet / FortiSwitch / TP-Link
  switchRole SwitchRole   @default(DISTRIBUCION)
  ports      SwitchPort[]

  @@map("asset_switches")
}

enum SwitchRole {
  CORE_ANILLO
  DISTRIBUCION
  AJENO       // switch de terceros colgado del FortiSwitch
  POE_ACCESO
}

enum WirelessMode {
  PMP_BASE    // antena principal punto-multipunto (púlpito)
  SUSCRIPTOR  // antena que cuelga de la PMP base
  PTP         // radioenlace punto a punto
  ESTACION
}

model AssetWireless {
  assetId         String       @id
  asset           Asset        @relation(fields: [assetId], references: [id], onDelete: Cascade)
  vendor          String?      // Ubiquiti (airMAX), Mimosa C6x, TP-Link
  frequency       String?
  mode            WirelessMode @default(SUSCRIPTOR)
  parentWirelessId String?     // auto-referencia lógica: suscriptor -> PMP base
  switchPortId    String?      @unique
  switchPort      SwitchPort?  @relation(fields: [switchPortId], references: [id])
  originPoint     String?
  destPoint       String?
  signalDbm       Int?
  linkStable      Boolean      @default(true) // caídas abruptas => sesiones NVR colgadas

  @@map("asset_wireless")
}

// =====================================================================
//  RED / TOPOLOGÍA (Módulo transversal — soporte a troubleshooting)
// =====================================================================

model Vlan {
  id        String        @id @default(uuid())
  number    Int           @unique
  name      String
  subnet    String?       // CIDR
  role      String?       // tren / nvr / gestion / visualizacion / industrial
  cameras   AssetCamera[]

  @@map("vlans")
}

model SwitchPort {
  id               String        @id @default(uuid())
  switchId         String
  switchAsset      Asset         @relation("PortSwitch", fields: [switchId], references: [id], onDelete: Cascade)
  assetSwitchId    String?
  assetSwitch      AssetSwitch?  @relation(fields: [assetSwitchId], references: [assetId])
  portNumber       Int
  poe              Boolean       @default(false)
  vlanNumber       Int?
  connectedAssetId String?       @unique
  connectedAsset   Asset?        @relation("PortConnectedAsset", fields: [connectedAssetId], references: [id])

  cameraLink       AssetCamera?
  wirelessLink     AssetWireless?

  @@unique([switchId, portNumber])
  @@map("switch_ports")
}

enum LinkMedium {
  FIBRA
  COBRE
  INALAMBRICO
}

model NetworkLink {
  id         String     @id @default(uuid())
  medium     LinkMedium
  endpointAId String
  endpointA  Asset      @relation("LinkEndpointA", fields: [endpointAId], references: [id], onDelete: Cascade)
  endpointBId String
  endpointB  Asset      @relation("LinkEndpointB", fields: [endpointBId], references: [id], onDelete: Cascade)
  isRing     Boolean    @default(false) // tramo del anillo de fibra del core
  description String?

  @@map("network_links")
}

// =====================================================================
//  CREDENCIALES CIFRADAS (soporte a seguridad y reposición rápida)
// =====================================================================

model Credential {
  id        String   @id @default(uuid())
  assetId   String
  asset     Asset    @relation(fields: [assetId], references: [id], onDelete: Cascade)
  username  String
  secretEnc String   // cifrado AES a nivel de aplicación
  type      String?  // admin, viewer, rtsp
  createdAt DateTime @default(now())

  @@map("credentials")
}

// =====================================================================
//  MANTENIMIENTO (Módulo 4)
// =====================================================================

enum WorkOrderType {
  PREVENTIVO
  CORRECTIVO
  MEJORA
  PREDICTIVO  // anticipado por condición (curva P-F): señal, recurrencia, desgaste
}

enum WorkOrderStatus {
  ABIERTA
  EN_PROCESO
  EN_ESPERA
  CERRADA
  CANCELADA
}

model WorkOrder {
  id           String          @id @default(uuid())
  code         String          @unique // ej: OT-2026-0001
  assetId      String
  asset        Asset           @relation(fields: [assetId], references: [id])
  type         WorkOrderType
  status       WorkOrderStatus @default(ABIERTA)
  technicianId String?
  technician   User?           @relation("AssignedTechnician", fields: [technicianId], references: [id])
  scheduledDate DateTime?
  executedDate  DateTime?
  activity     String?
  diagnosis    String?
  responsible  String?         // responsable de la OM
  materials    String?         // materiales usados / a usar (uno por línea)
  spareParts   Json?
  condition    Json?           // checklist de condición del preventivo (limpieza, cableado, etc.)
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  zone         String?         // zona de intervención (Horno, Laminación, Tren, Púlpito...)
  incidentId   String?         // incidencia que originó la OM (opcional)
  incident     Incident?          @relation(fields: [incidentId], references: [id])
  evidences    WorkOrderEvidence[]

  @@index([assetId])
  @@index([status])
  @@index([incidentId])
  @@map("work_orders")
}

model WorkOrderEvidence {
  id          String    @id @default(uuid())
  workOrderId String
  workOrder   WorkOrder @relation(fields: [workOrderId], references: [id], onDelete: Cascade)
  fileId      String    // referencia a objeto en MinIO
  caption     String?
  createdAt   DateTime  @default(now())

  @@map("work_order_evidences")
}

// =====================================================================
//  INCIDENCIAS (Módulo 5) + soporte a troubleshooting (Módulo 7)
// =====================================================================

enum Priority {
  BAJA
  MEDIA
  ALTA
  CRITICA
}

enum IncidentStatus {
  ABIERTA
  EN_DIAGNOSTICO
  EN_PROCESO
  EN_ESPERA        // el técnico la deja en espera (a la espera de repuesto/manlift/decisión)
  RESUELTA
  CERRADA
}

enum IncidentCategory {
  GENERAL
  SATURACION_SESIONES_NVR   // "NO MORE USER CAN BE CONNECTED"
  CAIDA_ENLACE_INALAMBRICO  // enlace PMP/Ubiquiti inestable
  FALLA_ALMACENAMIENTO_NVR
  DECODER_VIDEOWALL
  CAMARA_SIN_IMAGEN
  RED
  // ---- Categorías específicas de planta siderúrgica (F5) ----
  CORTE_ENERGIA             // corte / falla eléctrica que deja sin servicio equipos CCTV
  FALLA_GABINETE            // gabinete: temperatura, ventilación, humedad, daño físico
  FALLA_FUENTE_POE          // fuente / inyector / switch PoE que no energiza la cámara
  FALLA_SWITCH              // switch o puerto (core anillo / distribución / acceso)
  FALLA_FIBRA               // enlace de fibra / tramo del anillo dañado o degradado
  FALLA_UPS                 // respaldo de energía (UPS) agotado o en falla
  PERDIDA_CONECTIVIDAD      // pérdida de IP / VLAN / ping al equipo
  FALLA_NVR                 // NVR general (reinicios, cuelgue, no graba)
  AMBIENTAL_SIDERURGICO     // polvo, calor, escoria, vibración, agua propios de la planta
  SEGURIDAD_FISICA          // vandalismo, robo, golpe o corte de cable
  CONFIGURACION_FIRMWARE    // config incorrecta / firmware / actualización fallida
  // ---- Fallas ELÉCTRICAS específicas (planta siderúrgica) ----
  TABLERO_ELECTRICO         // tablero, breaker, llave térmica, borneras
  VARIACION_TENSION         // caída/pico de tensión, fluctuación por carga del horno
  PUESTA_A_TIERRA           // falla o ausencia de puesta a tierra
  CORTOCIRCUITO             // cortocircuito en el ramal o el equipo
  SOBRECARGA                // circuito sobrecargado
  CABLEADO_ELECTRICO        // cable eléctrico dañado, quemado o mal empalmado
  TRANSFORMADOR             // falla en transformador / fuente de alimentación mayor
}

model Incident {
  id              String           @id @default(uuid())
  code            String           @unique // ej: INC-2026-0001 / IT-CCTV-GRU-...
  title           String
  description     String?
  category        IncidentCategory @default(GENERAL)
  priority        Priority         @default(MEDIA)
  status          IncidentStatus   @default(ABIERTA)
  assetId         String?
  asset           Asset?           @relation(fields: [assetId], references: [id])
  responsibleId   String?
  responsible     User?            @relation("IncidentResponsible", fields: [responsibleId], references: [id])
  rootCause       String?
  concurrentSessions Int?          // sesiones en NVR al momento de la falla
  affectedCameras Int?             // cámaras aguas abajo afectadas
  reportedAt      DateTime         @default(now())
  resolvedAt      DateTime?
  visionDownMin   Int?             // minutos sin visión (impacto en producción)
  mttrMinutes     Int?             // tiempo de resolución calculado
  zone            String?          // área/zona en planta (Horno, Laminación, Púlpito...)
  solution        String?          // qué se hizo para resolver
  materials       String?          // materiales utilizados
  interveners     String?          // técnicos que intervinieron
  responsibleName String?          // responsable de la solución
  observations    String?          // observaciones / recomendaciones
  lineManagerNotified Boolean @default(false) // ¿jefe de línea enterado?
  // ---- Propuesta técnica de solución (documentación previa al cierre) ----
  // El ERP no solo registra la falla: deja constancia de QUÉ se propone hacer,
  // qué se necesita y qué pasa si no se atiende. Sirve para sustentar ante Jefatura.
  proposal        String?          // propuesta de solución planteada por el técnico
  proposalCost    String?          // materiales / recursos que demanda
  proposalRisk    String?          // riesgo o consecuencia de no atenderla
  requiresThirdParty Boolean @default(false) // requiere apoyo de terceros (eléctrica, contratista)

  workOrders      WorkOrder[]        // OM generadas a partir de esta incidencia
  evidences       IncidentEvidence[] // fotografías de campo

  @@index([assetId])
  @@index([status])
  @@index([category])
  @@map("incidents")
}

// =====================================================================
//  DOCUMENTACIÓN TÉCNICA (Módulo 6)
// =====================================================================

enum DocumentCategory {
  MANUAL
  DIAGRAMA
  PLANO
  FOTO
  CONFIG
  BACKUP
}

model Document {
  id         String           @id @default(uuid())
  title      String
  category   DocumentCategory
  fileId     String           // objeto en MinIO
  version    Int              @default(1)
  assetId    String?
  asset      Asset?           @relation(fields: [assetId], references: [id])
  locationId String?
  location   Location?        @relation(fields: [locationId], references: [id])
  uploadedBy String?
  createdAt  DateTime         @default(now())

  @@index([assetId])
  @@index([locationId])
  @@map("documents")
}

// =====================================================================
//  AUDITORÍA E HISTORIAL (transversal)
// =====================================================================

model AuditLog {
  id        String   @id @default(uuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id])
  action    String   // CREATE / UPDATE / DELETE / LOGIN / ...
  entity    String
  entityId  String?
  before    Json?
  after     Json?
  ip        String?
  createdAt DateTime @default(now())

  @@index([entity, entityId])
  @@map("audit_logs")
}

model AssetHistory {
  id         String   @id @default(uuid())
  assetId    String
  asset      Asset    @relation(fields: [assetId], references: [id], onDelete: Cascade)
  field      String
  oldValue   String?
  newValue   String?
  changedBy  String?
  createdAt  DateTime @default(now())

  @@index([assetId])
  @@map("asset_history")
}


// ===================== INVENTARIO / REPUESTOS (F3) =====================

enum MovementType {
  INGRESO   // entrada a almacén
  RETIRO    // salida (retiro por código SAP)
  AJUSTE    // corrección de stock
}

/// Repuesto de almacén. El código SAP es libre (para retirar del almacén) y
/// queda listo para sincronizar con SAP a futuro.
model SparePart {
  id            String   @id @default(uuid())
  sapCode       String?  // código SAP (libre)
  name          String
  description   String?
  category      String?  // ej: Fuente PoE, Cámara, Conector, Antena, Disco NVR
  brand         String?
  model         String?  // modelo compatible (compatibilidad por modelo)
  unit          String?  @default("unidad")
  warehouse     String?  // ubicación/almacén
  currentStock  Int      @default(0)
  minStock      Int      @default(0)  // umbral mínimo (alerta)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  lastCheckedAt DateTime?             // última comprobación física

  assets        SparePartAsset[]
  movements     StockMovement[]
  checks        StockCheck[]

  @@index([sapCode])
  @@index([category])
  @@map("spare_parts")
}

/// Compatibilidad repuesto <-> activo específico (además del match por modelo).
model SparePartAsset {
  id          String    @id @default(uuid())
  sparePartId String
  sparePart   SparePart @relation(fields: [sparePartId], references: [id], onDelete: Cascade)
  assetId     String
  asset       Asset     @relation(fields: [assetId], references: [id], onDelete: Cascade)

  @@unique([sparePartId, assetId])
  @@index([assetId])
  @@map("spare_part_assets")
}

/// Movimiento de stock (ingreso/retiro/ajuste). El retiro lleva su código SAP.
model StockMovement {
  id          String       @id @default(uuid())
  sparePartId String
  sparePart   SparePart    @relation(fields: [sparePartId], references: [id], onDelete: Cascade)
  type        MovementType
  quantity    Int          // positivo; el signo lo da el tipo
  sapCode     String?      // código SAP del retiro/ingreso
  reason      String?
  userId      String?
  user        User?        @relation(fields: [userId], references: [id])
  createdAt   DateTime     @default(now())

  @@index([sparePartId])
  @@map("stock_movements")
}

/// Comprobación física periódica (control diario del almacén).
model StockCheck {
  id          String    @id @default(uuid())
  sparePartId String
  sparePart   SparePart @relation(fields: [sparePartId], references: [id], onDelete: Cascade)
  countedQty  Int       // cantidad física comprobada
  previousQty Int?      // stock que había antes de comprobar
  note        String?
  userId      String?
  user        User?     @relation(fields: [userId], references: [id])
  checkedAt   DateTime  @default(now())

  @@index([sparePartId])
  @@map("stock_checks")
}


// ===================== MANTENIMIENTO PREVENTIVO (F6.1) =====================

/// Plan de mantenimiento preventivo por activo.
/// El intervalo depende de la criticidad de la zona (3 meses críticas, 6 meses el resto),
/// editable por el Jefe. nextDueAt = lastServiceAt (o alta) + intervalo.
model PreventivePlan {
  id            String    @id @default(uuid())
  assetId       String    @unique
  asset         Asset     @relation(fields: [assetId], references: [id], onDelete: Cascade)
  intervalDays  Int       @default(60) // 30 días = zona crítica (suciedad), 60 = no crítica (editable)
  zoneCritical  Boolean   @default(false)
  lastServiceAt DateTime?
  nextDueAt     DateTime?
  active        Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([nextDueAt])
  @@index([active])
  @@map("preventive_plans")
}

// ============ ACCESIBILIDAD / TRABAJO EN ALTURA — SSOMA (F6.9) ============
// Hay cámaras y antenas en altura o sobre grúas donde NO se puede intervenir sin
// manlift, izaje o andamio. El manlift es un recurso caro y el trabajo en altura
// (desde 1.80 m) exige PETAR/IPERC/ATS. Por eso el técnico sustenta la solicitud
// con fotos y datos de seguridad, y SOLO el Jefe de Mantenimiento la aprueba.

enum AccessMeans {
  MANLIFT           // plataforma elevadora
  GRUA              // izaje / permiso de grúa
  ANDAMIO
  ESCALERA
  LINEA_VIDA
  OTRO
}

enum AccessRequestStatus {
  SOLICITADO
  EN_REVISION
  APROBADO
  RECHAZADO
}

/// Solicitud de acceso especial a un activo inaccesible (trabajo en altura).
model AccessRequest {
  id             String              @id @default(uuid())
  code           String              @unique // ej: ACC-2026-0001
  assetId        String
  asset          Asset               @relation(fields: [assetId], references: [id], onDelete: Cascade)
  requestedById  String?
  requestedBy    User?               @relation("AccessRequester", fields: [requestedById], references: [id])

  // ---- Sustento técnico ----
  heightMeters   Float?              // altura estimada (trabajo en altura desde 1.80 m)
  means          AccessMeans         @default(MANLIFT)
  locationKind   String?             // poste / estructura / grúa / techo / puente grúa
  justification  String              // por qué es inaccesible sin ese medio
  accessRoute    String?             // cómo se llega / restricciones de la zona

  // ---- Datos SSOMA (seguridad) ----
  requiresPetar  Boolean             @default(true)  // permiso de trabajo de alto riesgo
  hasIperc       Boolean             @default(false) // IPERC elaborado
  hasAts         Boolean             @default(false) // ATS del día
  personnelCount Int?                @default(2)     // mínimo 2 personas en altura
  eppDetail      String?             // arnés, línea de vida, casco con barbiquejo...
  risks          String?             // riesgos identificados
  productionImpact String?           // ¿requiere parar el tren / coordinar con Producción?

  // ---- Revisión (solo Jefe de Mantenimiento) ----
  status         AccessRequestStatus @default(SOLICITADO)
  reviewedById   String?
  reviewedBy     User?               @relation("AccessReviewer", fields: [reviewedById], references: [id])
  reviewedAt     DateTime?
  decisionNotes  String?

  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  photos         AccessRequestPhoto[]

  @@index([assetId])
  @@index([status])
  @@map("access_requests")
}

/// Fotografías que sustentan la inaccesibilidad (obligatorias para aprobar).
model AccessRequestPhoto {
  id        String        @id @default(uuid())
  requestId String
  request   AccessRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  fileId    String
  caption   String?
  createdAt DateTime      @default(now())

  @@index([requestId])
  @@map("access_request_photos")
}

// ===================== FOTOGRAFÍAS DE ACTIVO (F6.4) =====================
enum PhotoKind {
  APUNTA      // a qué apunta (campo de visión, cámaras de púlpito)
  REFERENCIA  // ubicación de referencia física
  PLANO       // ubicación en plano (a futuro)
  GENERAL     // otra foto del equipo
}

/// Fotografías del activo (a qué apunta, referencia, plano) — en MinIO.
model AssetPhoto {
  id        String    @id @default(uuid())
  assetId   String
  asset     Asset     @relation(fields: [assetId], references: [id], onDelete: Cascade)
  kind      PhotoKind @default(GENERAL)
  fileId    String
  caption   String?
  createdAt DateTime  @default(now())

  @@index([assetId])
  @@map("asset_photos")
}

/// Fotografías de campo de una incidencia (almacenadas en MinIO).
model IncidentEvidence {
  id          String   @id @default(uuid())
  incidentId  String
  incident    Incident @relation(fields: [incidentId], references: [id], onDelete: Cascade)
  fileId      String
  caption     String?
  createdAt   DateTime @default(now())

  @@map("incident_evidences")
}
