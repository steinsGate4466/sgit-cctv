{
  "name": "sgit-cctv-backend",
  "version": "0.1.0",
  "engines": {
    "node": ">=24.0.0 <26"
  },
  "description": "SGIT-CCTV — API de gestión de infraestructura y CCTV (Aceros Arequipa, Planta Pisco)",
  "author": "Cristhian Rondon Amanqui",
  "license": "UNLICENSED",
  "scripts": {
    "build": "nest build && tsc prisma/seed.ts --outDir dist --rootDir . --module commonjs --target ES2021 --esModuleInterop --skipLibCheck && npm run verificar:arranque",
    "verificar:inyeccion": "node scripts/verificar-inyeccion.js",
    "verificar:filtros": "node scripts/verificar-filtros-prisma.js",
    "verificar:migraciones": "node scripts/verificar-migraciones.js",
    "verificar:constructores": "node scripts/verificar-constructores.js",
    "verificar:roles": "node scripts/verificar-roles.js",
    "verificar:coherencia": "node scripts/verificar-coherencia-rol.js",
    "diagnostico:roles": "node scripts/diagnostico-roles.js",
    "verificar:node": "node scripts/verificar-node.js",
    "verificar:arranque": "node scripts/verificar-arranque.js",
    "verificar:despliegue": "node scripts/verificar-despliegue.js",
    "verificar": "npm run verificar:inyeccion && npm run verificar:filtros && npm run verificar:campos && npm run verificar:migraciones && npm run verificar:constructores && npm run verificar:roles && npm run verificar:coherencia && npm run verificar:node && npm run verificar:despliegue",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:prod": "node dist/main.js",
    "lint": "eslint \"{src,test}/**/*.ts\" --fix",
    "format": "prettier --write \"src/**/*.ts\"",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:migrate:deploy": "prisma migrate deploy",
    "prisma:seed": "prisma db seed",
    "demo:cargar": "ts-node --project prisma/tsconfig.demo.json prisma/demo.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "prueba:calor": "node scripts/prueba-de-calor.js",
    "verificar:bd": "node scripts/diagnostico-bd.js",
    "verificar:campos": "node scripts/verificar-campos-prisma.js"
  },
  "dependencies": {
    "@nestjs/common": "^11.2.1",
    "@nestjs/config": "^4.0.2",
    "@nestjs/core": "^11.2.1",
    "@nestjs/jwt": "^11.0.0",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-express": "^11.2.1",
    "@nestjs/swagger": "^11.4.7",
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "argon2": "^0.40.3",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "dotenv": "^16.6.1",
    "exceljs": "^4.4.0",
    "minio": "^8.0.1",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "pdfkit": "^0.15.0",
    "prisma": "^7.9.1",
    "qrcode": "^1.5.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.10",
    "@nestjs/schematics": "^11.0.9",
    "@types/express": "^5.0.0",
    "@types/jest": "^29.5.12",
    "@types/node": "^24.0.0",
    "@types/passport-jwt": "^4.0.1",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.5",
    "ts-node": "^10.9.2",
    "typescript": "^5.5.0"
  },
  "overrides": {
    "multer": "^2.2.0",
    "brace-expansion": "^2.0.2",
    "picomatch": "^2.3.2",
    "tmp": "^0.2.4",
    "lodash": "^4.18.1",
    "glob": "^10.4.6",
    "js-yaml": "^4.3.1",
    "body-parser": "^1.20.6",
    "qs": "^6.15.2",
    "ajv": "^8.18.0"
  }
}
